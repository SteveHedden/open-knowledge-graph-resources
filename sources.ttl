kgjs:adzuna-api-distribution a dcat:Distribution ;
    dcterms:title "Adzuna keyed job-search JSON endpoint (us)"@en ;
    dcat:accessURL <https://api.adzuna.com/v1/api/jobs/us/search/1> ;
    dcat:mediaType "application/json" .

kgjs:adzuna-query-knowledge-graph a kgjobs:QueryFamily ;
    dcterms:subject kgjv:skill-knowledge-graph ;
    dcterms:title "Knowledge graph jobs query"@en ;
    kgjobs:queryOrder 1 ;
    kgjobs:queryText "knowledge graph" .

kgjs:adzuna-query-ontology a kgjobs:QueryFamily ;
    dcterms:subject kgjv:role-ontologist,
        kgjv:role-ontology-engineer ;
    dcterms:title "Ontology jobs query"@en ;
    kgjobs:queryOrder 2 ;
    kgjobs:queryText "ontology" .

kgjs:adzuna-query-semantic-web a kgjobs:QueryFamily ;
    dcterms:subject kgjv:skill-semantic-web ;
    dcterms:title "Semantic web jobs query"@en ;
    kgjobs:queryOrder 3 ;
    kgjobs:queryText "semantic web" .

kgjs:adzuna-query-sparql a kgjobs:QueryFamily ;
    dcterms:subject kgjv:skill-sparql ;
    dcterms:title "SPARQL jobs query"@en ;
    kgjobs:queryOrder 4 ;
    kgjobs:queryText "SPARQL" .

kgjs:arbeitnow-api-distribution a dcat:Distribution ;
    dcterms:title "Arbeitnow public job-board JSON endpoint"@en ;
    dcat:accessURL <https://www.arbeitnow.com/api/job-board-api> ;
    dcat:mediaType "application/json" .

kgjs:arbeitnow-query-all-active a kgjobs:QueryFamily ;
    dcterms:description "The Arbeitnow adapter retrieves a bounded active-posting feed; the RDF vocabulary, not this retrieval scope, determines KG relevance."@en ;
    dcterms:title "All active postings feed scope"@en ;
    kgjobs:queryOrder 1 ;
    kgjobs:queryText "all active postings; KG relevance classified locally" .

kgjs:fixture-schema a dcterms:Standard ;
    dcterms:description "Each fixture record has: id (string, stable fixture identifier), test_url (string, a test:// scheme canonical URL -- never a real URL), title, hiringOrganization, location (nullable), datePosted (nullable, ISO date), description, qualifications (nullable), responsibilities (nullable), expected_classification (one of qualified, review, not_match), and expected_concepts (array of kg-jobs.ttl concept local names, e.g. skill-rdf)."@en ;
    dcterms:title "KG Jobs fixture record schema"@en .

kgjs:generation-activity a prov:Activity ;
    dcterms:description "Deterministic, network-free run of scripts/generate.py: loads match terms and strengths from vocabularies/kg-jobs.ttl, classifies each fixture, and writes data/jobs.ttl and data/jobs.json."@en ;
    dcterms:title "kg-jobs classification run"@en ;
    prov:used kgjs:synthetic-fixtures,
        <https://openknowledgegraphs.com/jobs/vocab> .

