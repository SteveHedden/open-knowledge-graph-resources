src:class-Q124653107 a okg:SourceClassMapping ; okg:sourceDataset src:WikidataDataset ; okg:sourceClassId "Q124653107" ; okg:targetTerm okg:Software ; okg:projectionValue "Software" ; okg:catalogDataset <https://openknowledgegraphs.com/datasets/software> ; okg:sortOrder 10 .
