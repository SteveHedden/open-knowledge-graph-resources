kgjs:synthetic-fixtures a dcat:Dataset ;
    dcterms:created "2026-08-17"^^xsd:date ;
    dcterms:creator [ a foaf:Agent ;
            foaf:name "OKG KG Jobs test generator" ] ;
    dcterms:description "20 invented job-posting records used only to exercise and test the KG Jobs classifier. Not live vacancies, not scraped, not sourced from any employer or job board."@en ;
    dcterms:identifier "kg-jobs-fixtures-v1" ;
    dcterms:title "KG Jobs Synthetic Fixture Corpus"@en ;
    dcterms:type "synthetic-test-data"@en ;
    dcat:distribution kgjs:synthetic-fixtures-distribution ;
    kgjobs:networkFree true ;
    kgjobs:retrievalMode "local-file" .

src:property-P2283 a okg:SourcePropertyMapping ;
    okg:cardinality "optional-many" ;
    okg:catalogDataset <https://openknowledgegraphs.com/datasets/ontologies>,
        <https://openknowledgegraphs.com/datasets/software> ;
    okg:normalizedField "usesEntity" ;
    okg:sortOrder 15 ;
    okg:sourceDataset src:WikidataDataset ;
    okg:sourcePropertyId "P2283" ;
    okg:targetTerm okg:uses ;
    okg:valueKind "iri" .

<https://openknowledgegraphs.com/datasets/software> a dcat:Dataset,
        prov:Entity ;
    dcterms:description "Authoritative RDF catalog of semantic-web and knowledge-graph software published by OKG."@en ;
    dcterms:issued "2026-08-13"^^xsd:date ;
    dcterms:title "Open Knowledge Graphs software catalog"@en ;
    dcat:distribution src:SoftwareJsonDistribution,
        src:SoftwareTurtleDistribution ;
    prov:wasDerivedFrom src:WikidataDataset .

<https://openknowledgegraphs.com/datasets/ontologies> a dcat:Dataset,
        prov:Entity ;
    dcterms:description "Authoritative RDF catalog of ontologies, controlled vocabularies, taxonomies, knowledge graphs, and ontology languages published by OKG."@en ;
    dcterms:issued "2026-08-13"^^xsd:date ;
    dcterms:title "Open Knowledge Graphs ontology and vocabulary catalog"@en ;
    dcat:distribution src:OntologiesJsonDistribution,
        src:OntologiesTurtleDistribution ;
    prov:wasDerivedFrom src:WikidataDataset .

src:WikidataDataset a dcat:Dataset,
        prov:Entity ;
    dcterms:description "The collaboratively edited knowledge base queried by OKG for catalog source facts."@en ;
    dcterms:identifier "Wikidata" ;
    dcterms:title "Wikidata"@en ;
    dcat:landingPage <https://www.wikidata.org/> .
