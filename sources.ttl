@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix okg:     <https://openknowledgegraphs.com/ontology#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix src:     <https://openknowledgegraphs.com/sources#> .
@prefix wd:      <http://www.wikidata.org/entity/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

src:WikidataDataset
    a dcat:Dataset, prov:Entity ;
    dcterms:title "Wikidata"@en ;
    dcterms:description "The collaboratively edited knowledge base queried by OKG for catalog source facts."@en ;
    dcterms:identifier "Wikidata" ;
    dcat:landingPage <https://www.wikidata.org/> .

<https://openknowledgegraphs.com/datasets/ontologies>
    a dcat:Dataset, prov:Entity ;
    dcterms:title "Open Knowledge Graphs ontology and vocabulary catalog"@en ;
    dcterms:description "Authoritative RDF catalog of ontologies, controlled vocabularies, taxonomies, knowledge graphs, and ontology languages published by OKG."@en ;
    dcterms:issued "2026-08-13"^^xsd:date ;
    prov:wasDerivedFrom src:WikidataDataset ;
    dcat:distribution src:OntologiesTurtleDistribution, src:OntologiesJsonDistribution .

src:OntologiesTurtleDistribution
    a dcat:Distribution ;
    dcterms:title "OKG ontology catalog in Turtle"@en ;
    dcat:downloadURL <https://openknowledgegraphs.com/data/ontologies.ttl> ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/turtle> .

src:OntologiesJsonDistribution
    a dcat:Distribution ;
    dcterms:title "Derived OKG ontology catalog JSON projection"@en ;
    dcat:downloadURL <https://openknowledgegraphs.com/data/ontologies.json> ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/application/json> .

<https://openknowledgegraphs.com/datasets/software>
    a dcat:Dataset, prov:Entity ;
    dcterms:title "Open Knowledge Graphs software catalog"@en ;
    dcterms:description "Authoritative RDF catalog of semantic-web and knowledge-graph software published by OKG."@en ;
    dcterms:issued "2026-08-13"^^xsd:date ;
    prov:wasDerivedFrom src:WikidataDataset ;
    dcat:distribution src:SoftwareTurtleDistribution, src:SoftwareJsonDistribution .

src:SoftwareTurtleDistribution
    a dcat:Distribution ;
    dcterms:title "OKG software catalog in Turtle"@en ;
    dcat:downloadURL <https://openknowledgegraphs.com/data/software.ttl> ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/turtle> .

src:SoftwareJsonDistribution
    a dcat:Distribution ;
    dcterms:title "Derived OKG software catalog JSON projection"@en ;
    dcat:downloadURL <https://openknowledgegraphs.com/data/software.json> ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/application/json> .

