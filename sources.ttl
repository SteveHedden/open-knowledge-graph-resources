src:property-P1324 a okg:SourcePropertyMapping ; okg:sourceDataset src:WikidataDataset ; okg:sourcePropertyId "P1324" ; okg:normalizedField "sourceCodeRepo" ; okg:targetTerm okg:sourceRepo ; okg:valueKind "iri" ; okg:cardinality "optional-many" ; okg:catalogDataset <https://openknowledgegraphs.com/datasets/ontologies>, <https://openknowledgegraphs.com/datasets/software> ; okg:sortOrder 11 .
