kgjs:generated-data a dcat:Dataset ;
    dcterms:description "The classifier's deterministic output: schema:JobPosting instances with kgjobs:classification and kgjobs:hasEvidence, generated from the synthetic fixture corpus. Regenerating against unchanged fixtures and vocabulary must produce semantically identical RDF and byte-identical JSON."@en ;
    dcterms:title "KG Jobs Generated RDF and JSON Projection"@en ;
    dcat:distribution [ a dcat:Distribution ;
            dcterms:title "Generated RDF"@en ;
            dcat:downloadURL <https://openknowledgegraphs.com/jobs/data/jobs.ttl> ;
            dcat:mediaType "text/turtle" ],
        [ a dcat:Distribution ;
            dcterms:title "Generated JSON projection"@en ;
            dcat:downloadURL <https://openknowledgegraphs.com/jobs/data/jobs.json> ;
            dcat:mediaType "application/json" ] ;
    prov:wasDerivedFrom kgjs:synthetic-fixtures ;
    prov:wasGeneratedBy kgjs:generation-activity .

kgjs:himalayas a dcat:Dataset ;
    dcterms:description "Official no-authentication keyword-search API used as the preferred source for explicit local-only KG-job discovery. A small reviewed family of high-precision queries is declared here rather than issuing one request for every taxonomy term."@en ;
    dcterms:identifier "himalayas" ;
    dcterms:publisher [ a foaf:Agent ;
            foaf:name "Himalayas" ] ;
    dcterms:title "Himalayas Remote Jobs API"@en ;
    dcat:distribution kgjs:himalayas-api-distribution ;
    dcat:landingPage <https://himalayas.app/jobs/api> ;
    kgjobs:adapter "himalayas" ;
    kgjobs:allowedHost "himalayas.app" ;
    kgjobs:attributionText "Himalayas" ;
    kgjobs:attributionURL <https://himalayas.app/> ;
    kgjobs:maxRecordsPerRun 80 ;
    kgjobs:maxRequestsPerRun 4 ;
    kgjobs:maxResponseBytes 5000000 ;
    kgjobs:minRefreshIntervalSeconds 86400.0 ;
    kgjobs:networkFree false ;
    kgjobs:productionEnabled true ;
    kgjobs:requestTimeoutSeconds 20 ;
    kgjobs:retrievalMode "keyword-search-api" ;
    kgjobs:searchEnabled true ;
    kgjobs:sourceQuery kgjs:himalayas-query-knowledge-graph,
        kgjs:himalayas-query-ontology,
        kgjs:himalayas-query-semantic-web,
        kgjs:himalayas-query-sparql ;
    kgjobs:termsURL <https://himalayas.app/docs/remote-jobs-api> .

kgjs:jobicy a dcat:Dataset ;
    dcterms:description "Official no-authentication remote-jobs JSON API. Its `tag` parameter is a genuine keyword search, verified against the live API with a true-negative control query (a nonsense term correctly returned zero results). A small reviewed family of high-precision queries is declared here, the same pattern as Himalayas -- except the bare single words 'knowledge' and 'owl', which were found to silently fall back to an unfiltered result set rather than actually filtering, so 'knowledge graph' and 'ontology' are queried instead. Local RDF vocabulary classification remains the sole eligibility decision regardless."@en ;
    dcterms:identifier "jobicy" ;
    dcterms:publisher [ a foaf:Agent ;
            foaf:name "Jobicy" ] ;
    dcterms:title "Jobicy Remote Jobs API"@en ;
    dcat:distribution kgjs:jobicy-api-distribution ;
    dcat:landingPage <https://jobi.cy/apidocs> ;
    kgjobs:adapter "jobicy" ;
    kgjobs:allowedHost "jobicy.com" ;
    kgjobs:attributionText "Jobicy" ;
    kgjobs:attributionURL <https://jobicy.com/> ;
    kgjobs:maxRecordsPerRun 160 ;
    kgjobs:maxRequestsPerRun 8 ;
    kgjobs:maxResponseBytes 5000000 ;
    kgjobs:minRefreshIntervalSeconds 3600.0 ;
    kgjobs:networkFree false ;
    kgjobs:productionEnabled true ;
    kgjobs:requestTimeoutSeconds 20 ;
    kgjobs:retrievalMode "keyword-search-api" ;
    kgjobs:searchEnabled true ;
    kgjobs:sourceQuery kgjs:jobicy-query-knowledge-graph,
        kgjs:jobicy-query-linkml,
        kgjs:jobicy-query-ontology,
        kgjs:jobicy-query-rdf,
        kgjs:jobicy-query-semantic-web,
        kgjs:jobicy-query-shacl,
        kgjs:jobicy-query-skos,
        kgjs:jobicy-query-sparql ;
    kgjobs:termsURL <https://jobi.cy/apidocs> .

kgjs:jooble a dcat:Dataset ;
    dcterms:description "Keyed job-search aggregator API (500 requests on the free tier). The API key is issued instantly on request but is a real per-account credential, never stored in this registry -- scripts/live_pipeline.py reads it from the JOOBLE_API_KEY environment variable at request time. Jooble requires a POST request with a JSON body (verified directly: a GET with the same parameters returns nothing), so it is fetched through a dedicated code path in scripts/live_sources.py rather than the shared GET fetcher."@en ;
    dcterms:identifier "jooble" ;
    dcterms:publisher [ a foaf:Agent ;
            foaf:name "Jooble" ] ;
    dcterms:title "Jooble Job Search API"@en ;
    dcat:distribution kgjs:jooble-api-distribution ;
    dcat:landingPage <https://jooble.org/api/about> ;
    kgjobs:adapter "jooble" ;
    kgjobs:allowedHost "jooble.org" ;
    kgjobs:attributionText "Jooble" ;
    kgjobs:attributionURL <https://jooble.org/> ;
    kgjobs:maxPostingAgeDays 45 ;
    kgjobs:maxRecordsPerRun 240 ;
    kgjobs:maxRequestsPerRun 8 ;
    kgjobs:maxResponseBytes 5000000 ;
    kgjobs:minRefreshIntervalSeconds 21600.0 ;
    kgjobs:networkFree false ;
    kgjobs:productionEnabled true ;
    kgjobs:requestTimeoutSeconds 20 ;
    kgjobs:retrievalMode "keyword-search-api" ;
    kgjobs:searchEnabled true ;
    kgjobs:sourceQuery kgjs:jooble-query-knowledge-graph,
        kgjs:jooble-query-linkml,
        kgjs:jooble-query-ontology,
        kgjs:jooble-query-rdf,
        kgjs:jooble-query-semantic-web,
        kgjs:jooble-query-shacl,
        kgjs:jooble-query-skos,
        kgjs:jooble-query-sparql ;
    kgjobs:termsURL <https://jooble.org/api/about> .

kgjs:remotive a dcat:Dataset ;
    dcterms:description "Public remote-job search API retained for explicit local review only. Remotive attribution and original listing links must be retained; the production gate remains false."@en ;
    dcterms:identifier "remotive" ;
    dcterms:publisher [ a foaf:Agent ;
