src:class-Q5 a okg:SourceClassMapping ; okg:sourceDataset src:WikidataDataset ; okg:sourceClassId "Q5" ; okg:targetTerm okg:Person ; okg:projectionValue "Person" ; okg:sortOrder 20 .

# Source property mappings. normalizedField is the stable internal extraction name;
# valueKind and cardinality make source assumptions inspectable without encoding query syntax.

src:property-P31 a okg:SourcePropertyMapping ; okg:sourceDataset src:WikidataDataset ; okg:sourcePropertyId "P31" ; okg:normalizedField "instanceOf" ; okg:targetTerm rdf:type ; okg:valueKind "iri" ; okg:cardinality "required-many" ; okg:sortOrder 1 .
src:property-P279 a okg:SourcePropertyMapping ; okg:sourceDataset src:WikidataDataset ; okg:sourcePropertyId "P279" ; okg:normalizedField "subclassOf" ; okg:targetTerm rdfs:subClassOf ; okg:valueKind "iri" ; okg:cardinality "optional-many" ; okg:sortOrder 2 .
