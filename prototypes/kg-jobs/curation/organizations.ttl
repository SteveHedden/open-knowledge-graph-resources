@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Reviewed supplementals fill material vendor and consultancy gaps that are
# not represented by the current catalog's collapsed creator relationships.
# Career-source approval is deliberately separate and remains false here.

org:neo4j-inc a schema:Organization ;
    schema:name "Neo4j, Inc." ;
    skos:altLabel "Neo4j" ;
    dcterms:description "Company developing the Neo4j graph database and knowledge-graph platform." ;
    schema:url <https://neo4j.com/> ;
    kgjobs:careersPage <https://neo4j.com/careers/> ;
    kgjobs:active true ;
    kgjobs:organizationKind orgv:kind-commercial-enterprise ;
    kgjobs:ecosystemRole orgv:role-graph-platform-provider, orgv:role-open-source-steward ;
    kgjobs:reviewStatus "evidence-reviewed" ;
    kgjobs:reviewReason "Official company material documents sustained graph-database and knowledge-graph products." ;
    kgjobs:lastVerified "2026-08-26"^^xsd:date ;
    kgjobs:pilotSelected true ;
    kgjobs:productionApproved true ;
    kgjobs:inclusionEvidence [
        dcterms:source <https://neo4j.com/company/> ;
        dcterms:description "Neo4j's official company history identifies the company behind the Neo4j graph database and its graph platform." ;
        dcterms:date "2026-08-26"^^xsd:date
    ] .

