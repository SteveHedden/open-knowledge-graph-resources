@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix kgjobs: <https://openknowledgegraphs.com/prototypes/kg-jobs/ontology#> .
@prefix org: <https://openknowledgegraphs.com/organization/> .
@prefix orgv: <https://openknowledgegraphs.com/prototypes/kg-jobs/organization-vocabulary/> .
@prefix schema: <https://schema.org/> .
