@prefix kgjobs: <https://openknowledgegraphs.com/prototypes/kg-jobs/ontology#> .
@prefix schema: <https://schema.org/> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# KG Jobs prototype ontology
#
# Minimal structural model for a local, network-free proof of concept
# that classifies synthetic job postings (schema:JobPosting) as
# qualified / review / not_match based on posting content, and records
# an explainable evidence trail for every decision. This ontology mints
# local terms only where Schema.org, SKOS, DCAT, PROV-O, and Dublin Core
# Terms have no suitable existing term (evidence modeling, match terms,
# classification outcome). Everything else reuses those vocabularies
# directly.
#
# Scope: prototypes/kg-jobs/ only. Not part of the production OKG
# ontology or catalog pipeline.
#################################################################

<https://openknowledgegraphs.com/prototypes/kg-jobs/ontology> a owl:Ontology ;
    rdfs:label "KG Jobs Prototype Ontology"@en ;
    rdfs:comment "Local structural model and SHACL shapes for the kg-jobs discovery prototype. Not part of the production OKG ontology."@en .

#################################################################
# Classes
#################################################################

kgjobs:Evidence a rdfs:Class ;
    rdfs:label "Evidence"@en ;
    rdfs:comment "A single explainable match between a job posting field and a controlled-vocabulary concept, including whether the match was negated in context."@en .

kgjobs:MatchTerm a rdfs:Class ;
    rdfs:label "Match Term"@en ;
    rdfs:comment "One literal surface form (a preferred or alternate label) that the classifier searches for, together with whether matching is case-sensitive."@en .

#################################################################
# Properties on schema:JobPosting
#################################################################

kgjobs:classification a rdf:Property ;
    rdfs:label "classification"@en ;
    rdfs:comment "The classifier's outcome for a job posting: qualified, review, or not_match."@en ;
    rdfs:domain schema:JobPosting ;
    rdfs:range xsd:string .

kgjobs:hasEvidence a rdf:Property ;
    rdfs:label "has evidence"@en ;
    rdfs:comment "Links a job posting to one piece of explainable match evidence."@en ;
    rdfs:domain schema:JobPosting ;
    rdfs:range kgjobs:Evidence .

#################################################################
# Properties on kgjobs:Evidence
#################################################################

kgjobs:matchedConcept a rdf:Property ;
    rdfs:label "matched concept"@en ;
    rdfs:comment "The skos:Concept this evidence matched against."@en ;
    rdfs:domain kgjobs:Evidence ;
    rdfs:range skos:Concept .

kgjobs:conceptLabel a rdf:Property ;
    rdfs:label "concept label"@en ;
    rdfs:comment "Denormalized skos:prefLabel of the matched concept, carried on the evidence node for a self-contained explanation."@en ;
    rdfs:domain kgjobs:Evidence ;
    rdfs:range xsd:string .

kgjobs:conceptScheme a rdf:Property ;
    rdfs:label "concept scheme"@en ;
    rdfs:comment "Denormalized rdfs:label of the skos:ConceptScheme the matched concept belongs to (Job Roles, KG Skills and Technologies, or KG Activities)."@en ;
    rdfs:domain kgjobs:Evidence ;
    rdfs:range xsd:string .

kgjobs:matchStrength a rdf:Property ;
    rdfs:label "match strength"@en ;
    rdfs:comment "Local match strength: 'strong' or 'contextual'. Used both on skos:Concept (its default strength) and denormalized on kgjobs:Evidence (the strength applied for this match)."@en ;
    rdfs:range xsd:string .

kgjobs:matchedPhrase a rdf:Property ;
    rdfs:label "matched phrase"@en ;
    rdfs:comment "The exact phrase found in the source field."@en ;
    rdfs:domain kgjobs:Evidence ;
    rdfs:range xsd:string .

kgjobs:sourceField a rdf:Property ;
    rdfs:label "source field"@en ;
    rdfs:comment "Which posting field the match was found in: title, description, qualifications, or responsibilities."@en ;
    rdfs:domain kgjobs:Evidence ;
    rdfs:range xsd:string .

kgjobs:negated a rdf:Property ;
    rdfs:label "negated"@en ;
    rdfs:comment "True if a local negation cue (e.g. 'no', 'not', 'without') was detected immediately preceding the matched phrase, meaning this match does not count as positive evidence."@en ;
    rdfs:domain kgjobs:Evidence ;
    rdfs:range xsd:boolean .

#################################################################
# Properties on skos:Concept (vocabulary-side)
#################################################################

kgjobs:hasMatchTerm a rdf:Property ;
    rdfs:label "has match term"@en ;
    rdfs:comment "Links a skos:Concept to one kgjobs:MatchTerm the classifier should search for."@en ;
    rdfs:domain skos:Concept ;
    rdfs:range kgjobs:MatchTerm .

#################################################################
# Properties on kgjobs:MatchTerm
#################################################################

kgjobs:termText a rdf:Property ;
    rdfs:label "term text"@en ;
    rdfs:comment "The literal surface form to search for."@en ;
    rdfs:domain kgjobs:MatchTerm ;
    rdfs:range xsd:string .

kgjobs:caseSensitive a rdf:Property ;
    rdfs:label "case sensitive"@en ;
    rdfs:comment "True if this term must match with exact case (used for short acronyms and stylized brand names to avoid ordinary-word collisions); false for case-insensitive phrase matching."@en ;
    rdfs:domain kgjobs:MatchTerm ;
    rdfs:range xsd:boolean .

#################################################################
# Properties on the source registry (sources.ttl)
#################################################################

kgjobs:retrievalMode a rdf:Property ;
    rdfs:label "retrieval mode"@en ;
    rdfs:comment "How this dataset is retrieved, e.g. 'local-file'. Used to record that the prototype's fixtures are never fetched over the network."@en ;
    rdfs:range xsd:string .

kgjobs:networkFree a rdf:Property ;
    rdfs:label "network free"@en ;
    rdfs:comment "True if this dataset requires no network access to read."@en ;
    rdfs:range xsd:boolean .

#################################################################
# SHACL shapes
#################################################################

kgjobs:JobPostingShape a sh:NodeShape ;
    sh:targetClass schema:JobPosting ;
    sh:property [
        sh:path schema:title ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path schema:description ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path schema:hiringOrganization ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path schema:url ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path kgjobs:classification ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "qualified" "review" "not_match" ) ;
    ] ;
    sh:property [
        sh:path kgjobs:hasEvidence ;
        sh:node kgjobs:EvidenceShape ;
    ] .

kgjobs:EvidenceShape a sh:NodeShape ;
    sh:property [
        sh:path kgjobs:matchedConcept ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class skos:Concept ;
    ] ;
    sh:property [
        sh:path kgjobs:conceptLabel ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path kgjobs:conceptScheme ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path kgjobs:matchStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "strong" "contextual" ) ;
    ] ;
    sh:property [
        sh:path kgjobs:matchedPhrase ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path kgjobs:sourceField ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "title" "description" "qualifications" "responsibilities" ) ;
    ] ;
    sh:property [
        sh:path kgjobs:negated ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
    ] .

kgjobs:ConceptMatchTermShape a sh:NodeShape ;
    sh:targetSubjectsOf kgjobs:hasMatchTerm ;
    sh:property [
        sh:path kgjobs:matchStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "strong" "contextual" ) ;
    ] ;
    sh:property [
        sh:path skos:inScheme ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path skos:definition ;
        sh:minCount 1 ;
    ] .

kgjobs:MatchTermShape a sh:NodeShape ;
    sh:targetClass kgjobs:MatchTerm ;
    sh:property [
        sh:path kgjobs:termText ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path kgjobs:caseSensitive ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
    ] .
