    prov:generatedAtTime "2026-09-03T07:45:01+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-compensation-total-rewards-united-kingdom-37968/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/elevenlabs/compensation-total-rewards-united-kingdom-37968> ;
