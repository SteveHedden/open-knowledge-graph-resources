<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-creative-paid-social-strategist-german-speaking-berlin-457979> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-20T20:33:44+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/leapsome/creative-paid-social-strategist-german-speaking-berlin-457979> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "3258dc3c4f0a25d9b3f3ab860b73086a4485219620466f1e08993776e7406f19" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-20T12:57:15+00:00"^^xsd:dateTime ;
