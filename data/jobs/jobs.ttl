    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-23T18:36:11+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/intelance/senior-iga-consultant-identity-governance-and-access-controls-london-357448> ;
    kgjobs:active true ;
