            schema:name "Hamburg" ] ;
    schema:title "Team Lead Engineering - Platform (f/m/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/zeal-network/team-lead-engineering-platform-hamburg-95343> .

