            schema:name "Vastorf" ] ;
    schema:title "Personalreferent mit Schwerpunkt Recruiting (m/w/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/manzke-gruppe/personalreferent-mit-schwerpunkt-recruiting-vastorf-482128> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-pflichtpraktikum-im-bereich-grafikdesign-stuttgart-196442> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-21T10:34:54+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/efly-marketplace-services-gmbh/pflichtpraktikum-im-bereich-grafikdesign-stuttgart-196442> ;
