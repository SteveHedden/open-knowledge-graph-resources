    schema:url <https://www.arbeitnow.co.uk/jobs/companies/todaytix-group/director-crm-lifecycle-marketing-london-uk-197219> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-director-data-strategy-consulting-mensch-dusseldorf-frankfurt-hamburg-munich-302990> a prov:Entity,
        schema:JobPosting ;
