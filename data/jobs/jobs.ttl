    kgjobs:active true ;
    kgjobs:canonicalFingerprint "f66af2a8964addaced3c945d2aeda36cd40bfa759d320f9c5e65b8c77ea6c244" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-05T07:22:49+00:00"^^xsd:dateTime ;
