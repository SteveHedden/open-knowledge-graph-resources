    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-20T14:40:20+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/isaraerospace/werkstudent-administration-office-management-ottobrunn-bavaria-89337> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "e3410ae1e115e1a4d24095b1e0e2b5621bbf1600032fd7f771db4a54d2d21cbd" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-20T10:35:46+00:00"^^xsd:dateTime ;
