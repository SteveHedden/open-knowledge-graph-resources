<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-growth-manager-contract-207657> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-23T18:36:11+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/reddit/senior-growth-manager-contract-207657> ;
