<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-senior-product-manager-core-experience-berlin-120518> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-02T07:36:12+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-product-manager-core-experience-berlin-120518/1>,
        <https://www.arbeitnow.com/jobs/companies/n8n/senior-product-manager-core-experience-berlin-120518> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "f1e9288c96b0d5f0f531fbe7b52ea71d58cc634b7414bce0a9f1bbc3d4d93597" ;
    kgjobs:classification "not_match" ;
