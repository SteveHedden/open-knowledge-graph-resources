    schema:title "Werkstudent:in (m/w/d) Recherche & Kommunikation" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/socialimpact/werkstudentin-recherche-kommunikation-berlin-heilbronner-strasse-35908> .

