        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-28T13:20:05+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-cloud-engineer-azure-dormagen-73338/1>,
        <https://www.arbeitnow.com/jobs/companies/klaus-scholz-personalvermittlung/cloud-engineer-azure-dormagen-73338> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "3af54ef8fdfd4038ea1f45a36f1dc76d5f605c1a24b41e97238dd2d8abc1b894" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-28T13:20:05+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-08-28T13:20:05+00:00"^^xsd:dateTime ;
    kgjobs:reconciliationReason "no reviewed first-party candidate" ;
