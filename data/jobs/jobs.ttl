            schema:name "Berlin; Munich" ] ;
    schema:title "Forward Deployed Engineer" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/databricks/forward-deployed-engineer-berlin-munich-440770> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-forward-deployed-engineer-munich-351023> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-25T10:39:01+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/lumaai/forward-deployed-engineer-munich-351023> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "27b4db2a2c598b252f492e5d8db7d4a22dc2de67ba53f8e6ae0fd8c0228940a8" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-24T22:32:07+00:00"^^xsd:dateTime ;
