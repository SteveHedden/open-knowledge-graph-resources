<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-postdoctoral-researcher-in-geospatial-political-data-sdc-32-koln-413762> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
