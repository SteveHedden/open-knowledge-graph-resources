            schema:name "München" ] ;
    schema:title "Customer Success Manager (m/f/d) – Software & Analytics" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/kaskegroup/customer-success-manager-software-analytics-munchen-425576> .

