    kgjobs:active true ;
    kgjobs:canonicalFingerprint "22fba0810105bd283f099528c0a2ea19d055308fcb6ec1d7ce0d447b275b664a" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-18T20:14:54+00:00"^^xsd:dateTime ;
