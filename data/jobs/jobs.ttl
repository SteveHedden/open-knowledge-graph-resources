<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-full-stack-developer-ai-integration-aachen-84885> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-20T20:33:44+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/black-semiconductor-gmbh/full-stack-developer-ai-integration-aachen-84885> ;
