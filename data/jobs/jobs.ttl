<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-leiter-service-international-sondermaschinenbau-lasermaterialbearbeitung-kirchheim-bei-munchen-185234> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
