            schema:name "Köln, Nordrhein-Westfalen, Germany" ] ;
    schema:title "Country Director Germany (Fixed Term Emplyoment 1 year)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/fastned/country-director-germany-fixed-term-emplyoment-1-year-koln-493039> .

