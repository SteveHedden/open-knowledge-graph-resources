    schema:title "Praktikant/in Customer Support im Fitness-Nutrition-Unternehmen" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/brandl-nutrition-gmbh/praktikant-in-customer-support-im-fitness-nutrition-unternehmen-munich-219951> .

