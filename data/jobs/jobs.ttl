<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-senior-product-manager-data-apis-london-48581> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-05T07:22:49+00:00"^^xsd:dateTime ;
