            schema:name "London" ] ;
    schema:title "Platform Engineer" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/bluecrestcapitalmanagement/platform-engineer-london-332889> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-pmt-architect-all-genders-munich-101752> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-25T22:33:23+00:00"^^xsd:dateTime ;
