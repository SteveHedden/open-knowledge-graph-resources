    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/global-bei-ecdb/werkstudent-marktanalyse-e-commerce-hamburg-233333> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "cbc25aa66671fb153a4b62defb730ddb12428478cd3b1da2373a6536606c3a8e" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-22T02:58:04+00:00"^^xsd:dateTime ;
