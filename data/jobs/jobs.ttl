<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-director-production-engineering-ottobrunn-bavaria-parsdorf-bavaria-399644> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
