    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-20T10:35:46+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/safedriver-group-gmbh/werkstudentin-politische-kommunikation-verbandsarbeit-berlin-457469> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "e7da23adfe2a75233db3f32d6ae04cd727e2db7ed56398919b64a8f9b9d8fec8" ;
