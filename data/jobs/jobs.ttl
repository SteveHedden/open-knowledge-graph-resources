<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-consultant-education-sales-operations-hamburg-205617> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-19T22:29:16+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/strategy-core-ventures-gmbh/consultant-education-sales-operations-hamburg-205617> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "6ded9ac073c9a252b28fea8fbd704aa94cb0eb044ed17feb973a861f18c7bdfc" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-19T12:55:46+00:00"^^xsd:dateTime ;
