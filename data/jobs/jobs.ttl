<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-remote-principal-product-manager-time-to-first-production-35436> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-26T04:45:30+00:00"^^xsd:dateTime ;
