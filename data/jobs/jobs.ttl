        <https://www.arbeitnow.co.uk/jobs/companies/metaview/product-marketing-manager-london-117771> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "fa9727d2c7937be9924a700228426553abbb9077516a85118867082605589162" ;
