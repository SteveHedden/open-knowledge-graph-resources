            schema:name "Hamburg, Hamburg, Deutschland" ] ;
    schema:title "Senior Grafikdesigner/in – Vollzeit (m/w/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/cordes-consulting-gmbh/senior-grafikdesigner-in-vollzeit-hamburg-241270> .

