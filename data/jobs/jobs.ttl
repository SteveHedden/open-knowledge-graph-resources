<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-it-systems-and-infrastructure-engineer-moorgate-362760> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-19T04:41:07+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/checkatrade/it-systems-and-infrastructure-engineer-moorgate-362760> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "6458c08f85c5e13d6693b6a9bfc5b72290f12e7119d12a39baf21103bd258194" ;
    kgjobs:classification "not_match" ;
