            schema:name "Berlin" ] ;
    schema:title "Senior Finance Coordinator & PMO Manager" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/global-university-systems-gmbh/senior-finance-coordinator-pmo-manager-berlin-141472> .

