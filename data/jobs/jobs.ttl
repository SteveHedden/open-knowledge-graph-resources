            schema:name "Hamburg, Hamburg, Deutschland" ] ;
    schema:title "Senior Marketing Manager/in – Vollzeit (m/w/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/cordes-consulting-gmbh/senior-marketing-manager-in-vollzeit-hamburg-230510> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-mechanical-engineer-cirencester-470993> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-20T20:33:44+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/arcticrd/senior-mechanical-engineer-cirencester-470993> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "97be48f5b2287832d632e21ae1e940281c90f1d02249704496d1c436ce3b674e" ;
