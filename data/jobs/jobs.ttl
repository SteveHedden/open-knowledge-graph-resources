            schema:name "Manchester" ] ;
    schema:title "Brand and Community Manager" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/cytix/brand-and-community-manager-manchester-473272> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-brand-product-marketing-munich-381731> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-20T10:35:46+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/bowatt/brand-product-marketing-munich-381731> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "e597c45bad1d1a33024676ab71664b3eaecb37448eaf86482ced0381b0fc2601" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-20T01:27:27+00:00"^^xsd:dateTime ;
