            schema:name "London" ] ;
    schema:title "Sr. GTM Analytics Manager" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/anaplan/sr-gtm-analytics-manager-london-248013> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-staff-backend-software-engineer-python-go-london-418086> a prov:Entity,
