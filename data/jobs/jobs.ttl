            schema:name "London" ] ;
    schema:title "Technical Account Manager" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/happl/technical-account-manager-london-418441> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-total-rewards-manager-london-314912> a prov:Entity,
        schema:JobPosting ;
