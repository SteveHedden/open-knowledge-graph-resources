    schema:title "Mitarbeiter im Bereich HR & Payroll (m/w/d) in Teilzeit." ;
    schema:url <https://www.arbeitnow.com/jobs/companies/mnoplus-marketing-gmbh/mitarbeiter-im-bereich-hr-payroll-in-teilzeit-bochum-116087> .

