            schema:name "Berlin" ] ;
    schema:title "Projektmanager Online-Marketing (w/m/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/suchmeisterei-gmbh/projektmanager-online-marketing-berlin-429206> .

