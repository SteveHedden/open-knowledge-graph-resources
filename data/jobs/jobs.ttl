    schema:jobLocation [ a schema:Place ;
            schema:name "München" ] ;
    schema:title "Forward Deployed Engineer – AI (w/m/d) in Voll- oder Teilzeit" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/crozdach/forward-deployed-engineer-ai-in-voll-oder-teilzeit-munchen-302332> .

