    prov:generatedAtTime "2026-08-28T01:26:42+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-deployment-lead-accounting-solutions-uk-united-kingdom-148051/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/rillet/deployment-lead-accounting-solutions-uk-united-kingdom-148051> ;
