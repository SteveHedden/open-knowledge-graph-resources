<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-financial-analyst-london-470387> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-financial-analyst-london-470387/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/encord/financial-analyst-london-470387> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "b3b41fc60b44919583e0dcc54cb50464f08136bb7ff0f457489f214582240d44" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
