<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-sales-manager-london-194055> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-19T12:55:46+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/ripple/senior-sales-manager-london-194055> ;
