    prov:generatedAtTime "2026-08-20T14:40:20+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/chrono24/werkstudent-customer-care-karlsruhe-352989> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "233da495891e65cbaf178c0fa1c6d91b897202a1d8f8c3acf770a07a9e123b6a" ;
