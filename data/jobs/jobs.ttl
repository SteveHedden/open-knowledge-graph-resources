            schema:name "Berlin" ] ;
    schema:title "Senior Machine Learning Engineer I" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/sumup/senior-machine-learning-engineer-i-berlin-296351> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-machine-learning-engineer-london-264902> a prov:Entity,
