    schema:jobLocation <https://openknowledgegraphs.com/jobs/live/job/arbeitnow-platform-devops-engineer-munchen-424568/location> ;
    schema:jobLocationType "ON_SITE" ;
    schema:title "Platform & DevOps Engineer (m/f/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/yoummday-gmbh/platform-devops-engineer-munchen-424568> .

