    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-03T07:45:01+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-remote-project-manager-gaming-localization-production-101568/1>,
        <https://www.arbeitnow.com/jobs/companies/lilt-production/remote-project-manager-gaming-localization-production-101568> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "8d59c6cf2637506eb60a3aedba27a01aabc9d93e3e9a8c17abc8a015ab295c91" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-03T07:45:01+00:00"^^xsd:dateTime ;
