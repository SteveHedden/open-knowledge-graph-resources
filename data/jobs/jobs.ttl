            schema:name "Stuttgart" ] ;
    schema:title "Teamleiter:in Technik und Montage – Region Süd (w/m/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/kalo-vor-ort/teamleiterin-technik-und-montage-region-sud-stuttgart-81265> .

