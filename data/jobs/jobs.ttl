    schema:title "Senior Analytics Engineer - US" ;
    schema:url <https://jobicy.com/jobs/151266-senior-analytics-engineer-us> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/jobicy-151267> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/jobicy> ;
