    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/hirschen-group-gmbh/junior-art-director-berlin-schlesische-strasse-26-383639> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "6d9b8bbfd7c9015777d939889e4f52127afa4e4551be426f84563a5eb7a03534" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-26T01:41:29+00:00"^^xsd:dateTime ;
