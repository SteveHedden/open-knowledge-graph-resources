<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-remote-professorship-w2-in-data-science-and-digital-systems-100-95925> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-19T04:41:07+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/velptec/remote-professorship-w2-in-data-science-and-digital-systems-100-95925> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "a9d9d275d939de2ceebde0be2df3bdebb9a689fb7272c3c17a0abdb623c1701c" ;
