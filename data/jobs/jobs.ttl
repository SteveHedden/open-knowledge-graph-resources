    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-05T07:22:49+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-application-security-engineer-london-160680/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/prima/application-security-engineer-london-160680> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "a0ebdae763a70ddd2d3d3914d96c3faec90bc17f873dd31d12daccc7bb36ba36" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-05T07:22:49+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-09-05T07:22:49+00:00"^^xsd:dateTime ;
    kgjobs:reconciliationReason "no reviewed first-party candidate" ;
