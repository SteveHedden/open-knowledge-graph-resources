            schema:name "Berlin, Berlin" ] ;
    schema:title "Senior CRM Strategy Manager, Reactivations (all genders)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/hellofresh/senior-crm-strategy-manager-reactivations-all-genders-berlin-berlin-12467> .

