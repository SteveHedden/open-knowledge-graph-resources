<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-lead-deployment-architect-ai-munich-32611> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-22T10:28:06+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/celonis/lead-deployment-architect-ai-munich-32611> ;
