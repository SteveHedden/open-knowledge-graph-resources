    prov:generatedAtTime "2026-08-22T10:28:06+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/lendable/php-engineer-london-229841> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "c60a3d63b5d5957759698ca044a420424e269998fea3cb0bfcf5b4145b6c401c" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-22T06:47:53+00:00"^^xsd:dateTime ;
