            schema:name "Berlin, Berlin" ] ;
    schema:title "Sales Director, DACH" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/fireblocks/sales-director-dach-berlin-berlin-451992> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-sales-director-united-kingdom-293763> a prov:Entity,
