    schema:jobLocation <https://openknowledgegraphs.com/jobs/live/job/arbeitnow-junior-organisationsentwicklerin-fur-zusammenarbeit-lernen-berlin-374124/location> ;
    schema:title "(Junior) Organisationsentwickler:in für Zusammenarbeit & Lernen (d/m/w)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/projecttogether-ggmbh/junior-organisationsentwicklerin-fur-zusammenarbeit-lernen-berlin-374124> .

