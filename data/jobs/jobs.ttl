<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-remote-junior-sap-consultant-data-management-s-4hana-transformation-berlin-132228> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
