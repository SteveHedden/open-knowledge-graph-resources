            schema:name "Berlin, Germany" ] ;
    schema:title "Associate Partner - AI & Data - Life Sciences" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/visium/associate-partner-ai-data-life-sciences-berlin-62207> .

