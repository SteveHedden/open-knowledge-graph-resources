<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-praktikant-transaction-services-ab-september-oktober-frankfurt-am-main-496276> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-19T22:29:16+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/sancovia-gruppe/praktikant-transaction-services-ab-september-oktober-frankfurt-am-main-496276> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "2d6ff4b7074f71e84fcf842cc0b76f6530bd4d28e7daad08cfd54f0a18132428" ;
    kgjobs:classification "not_match" ;
