<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-senior-contracts-manager-sydney-australia-296953> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
