    prov:generatedAtTime "2026-08-18T22:28:45+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/veeamsoftware/lead-enterprise-account-executive-defense-and-public-uki-london-115065> ;
