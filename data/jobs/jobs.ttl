<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-account-executive-emea-specialist-279193> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-20T10:35:46+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/samsara/account-executive-emea-specialist-279193> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "67a961a37a1f6c09a9dbd311cc8a79c07f6555d8a2282bf84f2fbe5799e5a062" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-19T20:33:53+00:00"^^xsd:dateTime ;
