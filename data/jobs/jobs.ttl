            schema:name "London" ] ;
    schema:title "BI Data Analyst" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/motorway/bi-data-analyst-london-485108> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-bilanzbuchhalter-konzernabschluss-cologne-92855> a prov:Entity,
