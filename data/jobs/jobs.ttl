    schema:jobLocationType "ON_SITE" ;
    schema:title "Trainee AI Engineering in der Unternehmensberatung" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/niologic/trainee-ai-engineering-in-der-unternehmensberatung-hurth-52872> .

