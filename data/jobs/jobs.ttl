    prov:generatedAtTime "2026-08-23T18:36:11+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/inkuplay-ug-haftungsbeschrankt/executive-assistant-to-the-ceo-biesenthal-331493> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "87865d4dc0ab2589532b792059b27e94cd0f9b6712836ed5edd8f418a95ed444" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-23T16:30:50+00:00"^^xsd:dateTime ;
