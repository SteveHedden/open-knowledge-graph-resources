    kgjobs:active true ;
    kgjobs:canonicalFingerprint "f6073581f54ce6c22ae78b4556d08eda8e799e900721d507c4a90c3d28743d92" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-21T14:39:42+00:00"^^xsd:dateTime ;
