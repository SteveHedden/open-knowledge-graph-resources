    schema:jobLocation [ a schema:Place ;
            schema:name "London" ] ;
    schema:title "Lead Product Manager - Contract" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/wundermanthompson/lead-product-manager-contract-london-327366> .

