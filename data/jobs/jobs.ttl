    schema:jobLocation [ a schema:Place ;
            schema:name "United Kingdom" ] ;
    schema:title "Junior Market Data Analyst – Chartering" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/kpler/junior-market-data-analyst-chartering-united-kingdom-164308> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-junior-marketing-sales-manager-frankfurt-am-main-408109> a prov:Entity,
