<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-customer-success-manager-159100> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-20T10:35:46+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/sparetech/senior-customer-success-manager-159100> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "6110e736bc6898f11d3d33d79414da5bfcaca65ce1db30ce8c4e053e0d86c1e1" ;
