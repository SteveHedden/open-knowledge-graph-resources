    schema:url <https://www.arbeitnow.com/jobs/companies/gusti-leder-gmbh/werkstudent-b2b-vertrieb-rostock-439247> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-werkstudent-community-management-berlin-465902> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-26T04:45:30+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/gocomo-gmbh/werkstudent-community-management-berlin-465902> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "496b1471b44ea5c4eabf9e0ae110810bcc7fd645129db03ff96095ed0be7bfaa" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-26T01:41:29+00:00"^^xsd:dateTime ;
