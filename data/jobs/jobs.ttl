            schema:name "Cologne" ] ;
    schema:title "Fachplaner TGA (m/w/d) - Versorgungstechnik & Gebäudeautomation" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/sic-architekten-gmbh/fachplaner-tga-versorgungstechnik-gebaudeautomation-cologne-180771> .

