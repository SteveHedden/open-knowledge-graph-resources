    prov:generatedAtTime "2026-09-03T07:45:01+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-werkstudentin-im-bereich-performance-marketing-analytics-rostock-264924/1>,
        <https://www.arbeitnow.com/jobs/companies/gusti-leder-gmbh/werkstudentin-im-bereich-performance-marketing-analytics-rostock-264924> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "7c2baeaa1274bcee7a2107b64b913b4e0d1a07d4cb8b93017634e7f9d9d0c326" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-03T07:45:01+00:00"^^xsd:dateTime ;
