<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-integrated-campaign-manager-london-78027> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-22T01:26:57+00:00"^^xsd:dateTime ;
