        <https://www.arbeitnow.com/jobs/companies/knime-ag/senior-hr-specialist-recruiting-onboarding-in-berlin-or-konstanz-493000> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "d53db6013bff06a1b5adc858c1f9796ae9c132efd032dc99c5cb87a888f0d7e6" ;
    kgjobs:classification "not_match" ;
