    schema:title "Sales Assistant, Werkstudent (m/w/d), Hamburg Alsterhaus" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/lakrids-by-bulow/sales-assistant-werkstudent-hamburg-alsterhaus-86064> .

