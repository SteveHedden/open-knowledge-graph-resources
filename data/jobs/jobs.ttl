    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/seitenbau-gmbh/site-reliability-engineer-konstanz-berlin-oder-remote-75299> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "bd59d50d006352229658df0ccbac5fb9c09fd42c1c92070d787231deeffec688" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-23T12:49:00+00:00"^^xsd:dateTime ;
