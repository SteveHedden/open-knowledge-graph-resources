    prov:generatedAtTime "2026-08-22T01:26:57+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/jsr/steuerfachangestellte-r-berlin-49538> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "244ce81c462d4a8362485918975c14951b64277e44fee834c8c6a44a60243ab9" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-22T01:26:57+00:00"^^xsd:dateTime ;
