    prov:generatedAtTime "2026-08-21T10:34:54+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/sumup/senior-product-data-analyst-consumer-growth-london-411940> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "2e35dc04ac25560d7737c3f7482fb90b048254ac39392ce53ed2b343437ef48d" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-20T20:33:44+00:00"^^xsd:dateTime ;
