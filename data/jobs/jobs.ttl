<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-trainee-berufseinstieg-nach-bwl-finance-oder-wirtschaftsrecht-studium-munchen-261851> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-26T04:45:30+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/vogel/trainee-berufseinstieg-nach-bwl-finance-oder-wirtschaftsrecht-studium-munchen-261851> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "804e51beef589d89a8f940a34719854843f75fe4b4615846874b6daf9c73e41c" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-26T01:41:29+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-08-26T04:45:30+00:00"^^xsd:dateTime ;
