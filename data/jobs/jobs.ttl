            schema:name "Munich" ] ;
    schema:title "Operational QA Manager for Application Software Development (m/w/x)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/k-tronik-gmbh/operational-qa-manager-for-application-software-development-munich-154736> .

