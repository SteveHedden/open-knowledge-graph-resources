<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-product-engineer-united-kingdom-150195> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-19T22:29:16+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/attio/product-engineer-united-kingdom-150195> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "4781cce0fa475d9eabecfb9dfac859f6ff521c8b34139930ade2d9e3aa557d00" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-19T14:38:28+00:00"^^xsd:dateTime ;
