    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/kertos/team-lead-customer-success-all-genders-munich-95643> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "8ca59a39d1c7d47097136feb4d505525211b25bc7509bfcb61b548888fe37491" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-20T10:35:46+00:00"^^xsd:dateTime ;
