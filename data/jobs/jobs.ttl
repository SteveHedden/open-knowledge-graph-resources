    schema:jobLocationType "ON_SITE" ;
    schema:title "Werkstudent*in Strategy / Research (w/m/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/hirschen-group-gmbh/werkstudentin-strategy-research-berlin-schlesische-strasse-26-373163> .

