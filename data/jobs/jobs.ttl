<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-werkstudent-foodservice-robotic-kitchens-all-genders-welcome-heikendorf-bei-kiel-344279> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-25T04:44:23+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/goodbytz/werkstudent-foodservice-robotic-kitchens-all-genders-welcome-heikendorf-bei-kiel-344279> ;
