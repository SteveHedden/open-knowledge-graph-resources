        <https://www.arbeitnow.com/jobs/companies/taktile/senior-full-stack-engineer-team-agent-berlin-85709> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "eb454adb9669ec4a07e813114b147a7da6b924ea91dd9fc70a2ee3037cc09d23" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
