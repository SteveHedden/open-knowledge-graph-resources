    schema:title "Junior Finance & Accounting Manager (m/w/d) Renewable Energy" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/feldenergy-gmbh/junior-finance-accounting-manager-renewable-energy-weissenburg-in-bayern-275015> .

