            schema:name "Berlin, Berlin" ] ;
    schema:title "Werkstudent B2C Marketing (x/f/m)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/doctolib/werkstudent-b2c-marketing-berlin-berlin-322046> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-werkstudent-digital-media-marketing-mensch-dusseldorf-465869> a prov:Entity,
