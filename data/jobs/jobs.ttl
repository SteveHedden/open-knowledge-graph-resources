            schema:name "London" ] ;
    schema:title "Applied Scientist / Research Engineer (Internship)" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/frontier-health/applied-scientist-research-engineer-internship-london-21331> .

