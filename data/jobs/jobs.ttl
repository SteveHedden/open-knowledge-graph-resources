            schema:name "London" ] ;
    schema:title "Life Sciences Consulting Senior Analyst" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/clearviewhealthcarepartners/life-sciences-consulting-senior-analyst-london-301655> .

