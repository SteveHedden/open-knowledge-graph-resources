    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/inno2grid-gmbh/werkstudentin-hr-operations-berlin-226841> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "7ba3409f47a1a55b8b0b767d776ef927f1c26e93976bd0a4a41590aff29af273" ;
