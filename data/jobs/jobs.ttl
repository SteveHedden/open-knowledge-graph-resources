    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-20T14:40:20+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/contentsquare/senior-product-manager-user-and-lifecycle-analytics-germany-372508> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "fdeb720a1d3bb03189b47087435a4f28e90586ac7d88b7c52eacd98f2191669e" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-20T10:35:46+00:00"^^xsd:dateTime ;
