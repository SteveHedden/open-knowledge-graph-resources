    schema:jobLocationType "TELECOMMUTE" ;
    schema:title "Projektentwickler - Ostdeutschland (m/w/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/q-energy/remote-projektentwickler-ostdeutschland-berlin-484904> .

