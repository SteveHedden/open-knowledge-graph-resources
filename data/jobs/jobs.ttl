    prov:generatedAtTime "2026-08-25T10:39:01+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/cureosity-gmbh/technical-product-specialist-dusseldorf-74556> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "0a57176cd129d78c67c196c1b47c8d181e433fd92bb296c131f64b7c2750e5a5" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-25T10:39:01+00:00"^^xsd:dateTime ;
