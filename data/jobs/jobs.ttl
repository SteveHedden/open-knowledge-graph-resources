<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-people-partner-engineering-product-design-epd-london-450817> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-01T08:16:34+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-people-partner-engineering-product-design-epd-london-450817/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/lovable/people-partner-engineering-product-design-epd-london-450817> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "720db07460e5e62dc2b27d3504ad90ae8ed1621c805b2f03a8e2711d7dfe06e5" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-31T19:51:41+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-09-01T08:16:34+00:00"^^xsd:dateTime ;
