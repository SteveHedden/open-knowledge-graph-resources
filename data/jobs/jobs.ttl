<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-accuracy-checking-dispenser-acd-winnersh-108853> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
