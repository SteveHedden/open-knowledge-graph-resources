    prov:generatedAtTime "2026-09-02T07:36:12+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-werkstudent-grafik-design-berlin-hybrid-36056/1>,
        <https://www.arbeitnow.com/jobs/companies/ess-energy-sales-services-gmbh/werkstudent-grafik-design-berlin-hybrid-36056> ;
