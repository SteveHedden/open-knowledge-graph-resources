            schema:name "United Kingdom" ] ;
    schema:title "Senior Technical Product Manager - AI Agents, Evals & Reliability" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/bjak/senior-technical-product-manager-ai-agents-evals-reliability-london-454920> .

