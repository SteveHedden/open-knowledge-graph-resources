    kgjobs:lastSeenAt "2026-08-20T21:32:39+00:00"^^xsd:dateTime ;
    kgjobs:sourceRecordId "https://himalayas.app/companies/inizio-partners-corp/jobs/knowledge-graph-engineer" ;
