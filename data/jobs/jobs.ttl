    schema:jobLocation [ a schema:Place ;
            schema:name "Berlin (B)" ] ;
    schema:title "Werkstudent:in Graphic Design (w/m/x)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/piabo/werkstudentin-graphic-design-berlin-b-13953> .

