    kgjobs:reconciliationReason "no reviewed first-party candidate" ;
    kgjobs:sourceOccurrence <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-management-graduate-program-at-united-media-london-337931/1> ;
