    schema:jobLocation [ a schema:Place ;
            schema:name "Munich" ] ;
    schema:title "Working Student / Intern AI Product Associate (f/m/x)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/alago/working-student-intern-ai-product-associate-munich-226072> .

