    schema:jobLocation <https://openknowledgegraphs.com/jobs/live/job/arbeitnow-werkstudent-im-marketing-mainz-438525/location> ;
    schema:title "Werkstudent im Marketing m/w/d" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/vp-verbund-pflegehilfe-gmbh/werkstudent-im-marketing-mainz-438525> .

