    schema:title "PHP-Entwickler / Fachinformatiker für Anwendungsentwicklung (m/w/d) | Berlin-Mitte | Vollzeit" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/tenmedia-gmbh/php-entwickler-fachinformatiker-fur-anwendungsentwicklung-berlin-mitte-vollzeit-418> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-platform-engineer-london-97734> a prov:Entity,
