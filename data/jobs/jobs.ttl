    schema:title "Solution Sales Executive (m/w/d) – Public Sector Region Süd" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/synology-personio/remote-solution-sales-executive-public-sector-region-sud-149318> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-remote-staff-software-engineer-37744> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-19T04:41:07+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/conceptboard/remote-staff-software-engineer-37744> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "81f7a7c1b4c9b2c0f0e83da34b481038ec47190ab544a3aa6c8f4cd894548fa5" ;
