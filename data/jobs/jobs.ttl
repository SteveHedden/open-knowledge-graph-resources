            schema:name "UK - London" ] ;
    schema:title "Manager, EMEA FCC Monitoring & Testing" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/airwallex/manager-emea-fcc-monitoring-testing-london-261025> .

