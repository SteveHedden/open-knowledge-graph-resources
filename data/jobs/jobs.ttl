    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-workday-integration-specialist-london-150952/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/neko-health/workday-integration-specialist-london-150952> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "2b86a9443b554e6c89829257b9e49a16e1b606401e3277932c2b9b512d87d59c" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
    kgjobs:reconciliationReason "no reviewed first-party candidate" ;
    kgjobs:sourceOccurrence <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-workday-integration-specialist-london-150952/1> ;
    kgjobs:sourceRecordId "workday-integration-specialist-london-150952" ;
    schema:datePosted "2026-09-04"^^xsd:date ;
    schema:description "Mission Neko is redefining what prevention means, from treating illness when it arrives, to sustaining health before it's ever at risk. Our mission: make data-driven, preventative care accessible to more people, before symptoms appear. In a single, non-invasive visit under an hour, proprietary technology and direct clinical care combine to deliver personalised, actionable insights. It's a team that thinks in 10x, not 10%. Every role here plays a part in building a world where prevention is the norm, and where your work genuinely helps people live longer, healthier lives. Role Purpose Neko Health is looking for a Workday Integration Specialist to own the design, build, and maintenance of integrations between Workday and our wider systems landscape (TA, Reward, Payroll, Absence, Finance, and third-party tools). You'll work alongside the People Technology and module teams to keep data flowing accurately and securely across the platform and help extend Workday's capabilities beyond its native functionality. What you'll do in the first 6-12 Months Design, build, and support Workday integrations using EIB, Core Connectors, Studio, and Workday APIs (SOAP/REST) Develop and maintain custom reports via RaaS (Report-as-a-Service) to serve downstream systems and stakeholders Build and extend business processes using Workday Extend to digitise offline or manual processes Troubleshoot integration failures, including security/permission issues, data mapping errors, and connectivity problems Manage integration security: ISU setup, OAuth scopes, domain security policies, and API client configuration Partner with module teams (HCM, Absence, Compensation) and system owners (Finance, IT, Workforce Management) to gather integration requirements Maintain integration documentation, including field mappings and process flows Support data migration validation and spot-check processes for ongoing data loads Monitor integration health and proactively flag/resolve recurring errors Minimum Requirements Hands-on experience building Workday integrations using EIB, Connectors, and Studio Working knowledge of Workday RaaS and calculated fields Experience with Workday Extend (building or supporting custom applications) Understanding of Workday security model (domains, business processes, ISUs, OAuth) API integration experience (REST/SOAP), including troubleshooting auth and permission errors Comfortable working across HR, Finance, and IT stakeholder groups Nice to Have Experience integrating Workday with ATS (e.g. Ashby), payroll (ADP), Microsoft Entra, benefits platforms (Thanksben) Exposure to Workday Studio advanced transformations (XSLT) Experience with data migration projects (e.g. legacy HRIS to Workday) Workday Pro certification in Integrations or Extend Why this Role You'll join at a live, post-go-live stage of Workday's evolution at Neko Health, meaning your work has immediate visibility and impact, not years of legacy debt to untangle first. Find more English Speaking Jobs in United Kingdom on Arbeitnow" ;
    schema:employmentType "Full Time" ;
    schema:hiringOrganization kgjd:employer-neko-health ;
