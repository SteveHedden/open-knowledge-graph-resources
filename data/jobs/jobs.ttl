    prov:generatedAtTime "2026-09-05T07:22:49+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-remote-senior-security-engineer-appsec-404043/1>,
        <https://www.arbeitnow.com/jobs/companies/vivenu/remote-senior-security-engineer-appsec-404043> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "7d8b642e57cdfefd174241950ac9011847121e1411cf142376c29c1db5cc76f7" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-05T07:22:49+00:00"^^xsd:dateTime ;
