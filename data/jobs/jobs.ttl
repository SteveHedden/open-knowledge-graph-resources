            schema:name "Erding, Bavaria" ] ;
    schema:title "Teamleiter Logistik (m/w/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/teampicnic/teamleiter-logistik-erding-bavaria-416383> .

