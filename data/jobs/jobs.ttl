            schema:name "Berlin, Schlesische Straße 26" ] ;
    schema:title "(Junior) Art Director (w/m/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/hirschen-group-gmbh/junior-art-director-berlin-schlesische-strasse-26-383639> .

