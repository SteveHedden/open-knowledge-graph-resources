        <https://www.arbeitnow.co.uk/jobs/companies/creatoriq/vice-president-of-sales-emea-london-492573> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "10f697df0a8be0b4d811cc81c050bcbc58c7fbb252d84ab1f10885a09ad980b1" ;
    kgjobs:classification "not_match" ;
