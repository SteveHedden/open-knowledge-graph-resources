            schema:name "Berlin" ] ;
    schema:title "Founders Associate Intern Finance (w,m,x)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/nelly-solutions/founders-associate-intern-finance-wmx-berlin-337341> .

