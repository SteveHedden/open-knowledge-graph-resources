            schema:name "Bristol; London" ] ;
    schema:title "Director of Product & Tech Delivery" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/kaluza/director-of-product-tech-delivery-bristol-london-11391> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-director-paid-search-mensch-dusseldorf-140444> a prov:Entity,
