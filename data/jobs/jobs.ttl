    schema:jobLocationType "ON_SITE" ;
    schema:title "Flight Test Engineer & Onsite Test Coordinator (all genders)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/stark/flight-test-engineer-onsite-test-coordinator-all-genders-berlin-492135> .

