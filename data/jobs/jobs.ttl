            schema:name "Germering, Germany" ] ;
    schema:title "Werkstudent Software Testing (all genders)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/titanom-technologies/werkstudent-software-testing-all-genders-germering-248657> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-werkstudent-software-testing-munich-437385> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-25T22:33:23+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/functionhr-gmbh/werkstudent-software-testing-munich-437385> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "257d01744a79b08584b1450678df19f88682195fa225f930b0bdd3dbadb2c377" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-25T14:52:28+00:00"^^xsd:dateTime ;
