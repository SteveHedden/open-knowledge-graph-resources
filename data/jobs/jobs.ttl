    kgjobs:active true ;
    kgjobs:canonicalFingerprint "99e27fe0ba48b28709b8f6630ca3e45a5b4d17e77ad8eb35744f45edaaa9a602" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-21T18:42:27+00:00"^^xsd:dateTime ;
