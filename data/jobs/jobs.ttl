    kgjobs:active true ;
    kgjobs:canonicalFingerprint "047a5d93c196ab40d57957510581e6db80089a99d9f23d7792267f356c6d894a" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-21T16:39:30+00:00"^^xsd:dateTime ;
