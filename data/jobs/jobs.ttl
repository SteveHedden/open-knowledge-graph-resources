    schema:title "(Senior) Marketing Manager – Events & Partnerships (d/w/m*)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/pixxio/senior-marketing-manager-events-partnerships-hybrid-munchen-455676> .

