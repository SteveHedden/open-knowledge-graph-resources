    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/redis/enterprise-account-executive-germany-302637> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "be2b12bda4dbe66a2b7b42aea3898afacad2cf0cd64152bcb049f3d9ade6ea6d" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-18T22:28:45+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-08-18T22:28:45+00:00"^^xsd:dateTime ;
