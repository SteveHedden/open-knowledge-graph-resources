<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-werkstudent-social-media-marketing-berlin-152364> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-25T10:39:01+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/legalhero/werkstudent-social-media-marketing-berlin-152364> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "5d4c14173e2edd1b0e6ecc66c284febd9c718a57cda90256f12068cf0cca94cb" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-24T22:32:07+00:00"^^xsd:dateTime ;
