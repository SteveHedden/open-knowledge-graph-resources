    kgjobs:active true ;
    kgjobs:canonicalFingerprint "7073160fc3e7ab2a148908897cf431364300ba9a83c1849a92bbca4bc0f044f0" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-25T12:57:11+00:00"^^xsd:dateTime ;
