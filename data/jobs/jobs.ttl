<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-battery-system-engineer-architect-all-genders-munich-433120> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-25T22:33:23+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/stark/battery-system-engineer-architect-all-genders-munich-433120> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "3ae5de4d5c75e89953503d2b74cffc37ad8e4df555f4beccd745d1f04a6c56ca" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-25T22:33:23+00:00"^^xsd:dateTime ;
