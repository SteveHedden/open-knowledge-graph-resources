    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-18T22:28:45+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/mediform-gmbh/content-social-media-manager-startup-ai-healthcare-hybrid-karlsruhe-119752> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "ef0d4074edafd545c36ea7183b00f3d5bc4f7cfdafbdab6c5a4b8e03a2791231" ;
