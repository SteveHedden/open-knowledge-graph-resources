    kgjobs:canonicalFingerprint "68586ac21a21dc6424ecf88a86a5145eef97a12c3b859b0c5c908c3139dff783" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-25T20:35:11+00:00"^^xsd:dateTime ;
