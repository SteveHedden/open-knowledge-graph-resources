<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-staff-ai-engineer-2nd-horizon-germany-remote-243956> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-staff-ai-engineer-2nd-horizon-germany-remote-243956/1>,
        <https://www.arbeitnow.com/jobs/companies/grafanalabs/staff-ai-engineer-2nd-horizon-germany-remote-243956> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "aa62436e101ac4637820b5600df3b7528df169f50b0b35c2028f9b77c9c027df" ;
