<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-werkstudentin-finance-controlling-munchen-49127> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-03T07:45:01+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-werkstudentin-finance-controlling-munchen-49127/1>,
        <https://www.arbeitnow.com/jobs/companies/peter-park/werkstudentin-finance-controlling-munchen-49127> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "e0159854a78a9c7cded6e3186dcb58d46773b6f5ad4d90d846f664197835e0f1" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-03T07:45:01+00:00"^^xsd:dateTime ;
