    kgjobs:active true ;
    kgjobs:canonicalFingerprint "21057c46e95d0896928af80cd6bfe45316e415c6e46737db3f3b7c058b46d115" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-20T12:57:15+00:00"^^xsd:dateTime ;
