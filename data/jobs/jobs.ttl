    prov:generatedAtTime "2026-08-21T10:34:54+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/hela-gewurzwerk-hermann-laue-gmbh/remote-senior-crm-ai-solutions-engineer-ahrensburg-70645> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "c861ee52e1204ad22df762eab84466457d5b4d5412af6ead8a099d3fd8caa1a8" ;
