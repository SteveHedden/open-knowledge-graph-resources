    schema:title "Werkstudent/in Customer Support im Fitness-Nutrition-Unternehmen" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/brandl-nutrition-gmbh/werkstudent-in-customer-support-im-fitness-nutrition-unternehmen-munich-30614> .

