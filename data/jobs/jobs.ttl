    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-20T14:40:20+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/zeeco/graduate-applications-engineer-rental-and-rapid-response-stamford-england-320629> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "24759137ead2cec39b4a0489d4c8d85d08fc2c3a60d49a21c08365b9d2d57cc0" ;
    kgjobs:classification "not_match" ;
