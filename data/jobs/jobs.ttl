    schema:title "Growth Product Manager" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/distrokid/growth-product-manager-350915> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-gtm-system-engineer-manchester-128129> a prov:Entity,
        schema:JobPosting ;
