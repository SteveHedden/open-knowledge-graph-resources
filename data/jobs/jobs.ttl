    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-03T07:45:01+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-maintenance-operations-manager-potsdam-brandenburg-339750/1>,
        <https://www.arbeitnow.com/jobs/companies/teampicnic/senior-maintenance-operations-manager-potsdam-brandenburg-339750> ;
    kgjobs:active true ;
