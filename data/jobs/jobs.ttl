    schema:title "Senior Applied Scientist - Knowledge Graphs & AI" ;
    schema:url <https://himalayas.app/companies/outreach-io/jobs/senior-applied-scientist-knowledge-graphs-ai> ;
    schema:validThrough "2026-09-04"^^xsd:date .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/himalayas-95bbbc714b24fac2> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/himalayas> ;
    prov:generatedAtTime "2026-08-22T23:24:39+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://himalayas.app/companies/system/jobs/general-application-research-science> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "95bbbc714b24fac28e21f69f688c075db6e04b555042d784cb60f7343edb6937" ;
    kgjobs:classification "qualified" ;
