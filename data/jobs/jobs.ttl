    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-25T04:44:23+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/alphatrail-gmbh/werkstudent-online-marketing-e-commerce-regensburg-483103> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "19cc893309af5bcc2af31d1d3229455ee5daa6bf4b4fa473cbc0a208457d4f3c" ;
    kgjobs:classification "not_match" ;
