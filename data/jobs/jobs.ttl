    schema:jobLocationType "ON_SITE" ;
    schema:title "Test Automation Engineer (m/f/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/quantum-systems-gmbh/test-automation-engineer-gilching-80166> .

