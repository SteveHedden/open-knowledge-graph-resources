    prov:generatedAtTime "2026-08-20T20:33:44+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/klaviyo/senior-localisation-program-manager-product-fixed-term-contract-london-402654> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "92865020ee9f358b3e441c917bdb8d5a4497484e3dd1b33cbea25977d8de7198" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-20T18:46:07+00:00"^^xsd:dateTime ;
