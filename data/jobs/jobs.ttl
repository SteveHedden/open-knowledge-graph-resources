            schema:name "Hamburg" ] ;
    schema:title "Werkstudent Unternehmensstrategie & Geschäftsführung (m/w/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/deutsche-giganetz-gmbh/werkstudent-unternehmensstrategie-geschaftsfuhrung-hamburg-302913> .

