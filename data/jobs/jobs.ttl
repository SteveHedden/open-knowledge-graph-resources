<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-field-data-collector-leeds-6-month-fixed-term-contract-leeds-region-74767> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-28T01:26:42+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-field-data-collector-leeds-6-month-fixed-term-contract-leeds-region-74767/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/focalsystems/field-data-collector-leeds-6-month-fixed-term-contract-leeds-region-74767> ;
    kgjobs:active true ;
