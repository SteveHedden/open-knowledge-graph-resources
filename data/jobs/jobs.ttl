    prov:wasDerivedFrom <https://himalayas.app/companies/guidehouse/jobs/api-developer-data-engineer-managing-consultant-fraud-ai>,
        <https://openknowledgegraphs.com/jobs/live/occurrence/himalayas-ed8148c39075e0d5/1> ;
