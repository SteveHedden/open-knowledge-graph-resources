    schema:jobLocationType "ON_SITE" ;
    schema:title "Werkstudent Cyber Risk & Compliance (m/w/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/neptune-energy-deutschland/werkstudent-cyber-risk-compliance-hannover-466611> .

