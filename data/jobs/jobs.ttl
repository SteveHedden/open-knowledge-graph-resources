            schema:name "London" ] ;
    schema:title "Manager, Account Executives (London)" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/opentable/manager-account-executives-london-152677> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-manager-finance-transformation-all-genders-munich-98546> a prov:Entity,
