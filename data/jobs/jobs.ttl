            schema:name "Hamburg" ] ;
    schema:title "Praktikum Im Bereich Marktforschung/Marketingberatung" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/mindline-gmbh/praktikum-im-bereich-marktforschung-marketingberatung-hamburg-120025> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-pre-sales-senior-engineer-london-347617> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-18T22:28:45+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/kaluza/pre-sales-senior-engineer-london-347617> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "2a346faeb49c0540c6d2d68d944cb2cfc4686e6950782527be0b0786b9bc76de" ;
