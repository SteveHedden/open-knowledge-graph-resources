    schema:jobLocation [ a schema:Place ;
            schema:name "Berlin" ] ;
    schema:title "(Junior) Operations Manager – Process Excellence & Automation (w/m/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/enpal/junior-operations-manager-process-excellence-automation-berlin-97457> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-junior-qa-engineer-berlin-439004> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-20T14:40:20+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/progyny-global/junior-qa-engineer-berlin-439004> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "6bfbb09818a56168cf1d4e51ee0b079926511fde6cc74785a8e3139f2caf8dcc" ;
