    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-23T18:36:11+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/vulcan-energie-ressourcen-gmbh/senior-verfahrensingenieur-karlsruhe-394906> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "5cd87c42ed88b7a12667fd26c32eca16a9027d0949fca21123f821efa9b32e4a" ;
