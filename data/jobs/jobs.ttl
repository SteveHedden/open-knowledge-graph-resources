            schema:name "München" ] ;
    schema:title "Werkstudent*in Information Security Awareness & Automation" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/qaware-gmbh/werkstudentin-information-security-awareness-automation-munchen-366502> .

