<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-werkstudent-office-management-operations-office-munchen-131801> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-20T20:33:44+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/pioneer-people-gmbh/werkstudent-office-management-operations-office-munchen-131801> ;
    kgjobs:active true ;
