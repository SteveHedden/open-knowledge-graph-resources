    prov:generatedAtTime "2026-08-19T12:55:46+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/we-are-social-1/senior-copy-concept-munich-239151> ;
