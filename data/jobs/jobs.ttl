    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/start-to-finish-consulting-gmbh/amazon-marketplace-manager-hamburg-169304> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "c4927f9d8d4e27a9484b86130f6985d16bd6b80e575dfa5936ee64704e272323" ;
