            schema:name "USA" ] ;
    schema:jobLocationType "TELECOMMUTE" ;
    schema:title "Cloud & ISV Alliances and Marketplaces Lead" ;
    schema:url <https://jobicy.com/jobs/151339-cloud-isv-alliances-and-marketplaces-lead> .

