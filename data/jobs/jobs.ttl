            schema:name "Berlin, Berlin, Germany" ] ;
    schema:title "Working Student - Commercial B2B (m/f/x)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/rebuy/working-student-commercial-b2b-berlin-148456> .

