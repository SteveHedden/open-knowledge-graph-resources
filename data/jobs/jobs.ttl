    kgjobs:active true ;
    kgjobs:canonicalFingerprint "0f63b5c34ac3210cf77dbd255a3be1e06fcc251dd7c0208d0eb27c5b865f2bb0" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-28T13:20:05+00:00"^^xsd:dateTime ;
