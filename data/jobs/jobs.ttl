    prov:generatedAtTime "2026-09-03T07:45:01+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-remote-senior-tracking-specialist-hamburg-149081/1>,
        <https://www.arbeitnow.com/jobs/companies/celebrate-company-gmbh/remote-senior-tracking-specialist-hamburg-149081> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "c40465a5a61fb5960615d89314cbd69f47cf08ed2401e7ab677e239e9fad4ed8" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-03T07:45:01+00:00"^^xsd:dateTime ;
