<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-backend-qa-engineer-uk-147650> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-29T09:42:00+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-backend-qa-engineer-uk-147650/1>,
