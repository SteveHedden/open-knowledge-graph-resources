    schema:title "Werkstudent Customer Care (m/f/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/chrono24/werkstudent-customer-care-karlsruhe-352989> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-werkstudent-digital-media-marketing-mensch-dusseldorf-465869> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-20T20:33:44+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/wppmedia/werkstudent-digital-media-marketing-mensch-dusseldorf-465869> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "2cdbdf1c1eb12c861b98b3189cdd02168f91d89971c750d30b3a1015db42d958" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-20T18:46:07+00:00"^^xsd:dateTime ;
