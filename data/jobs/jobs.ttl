    kgjobs:canonicalFingerprint "4c9eee1b572b6307fbd97061589830a0ae23833ac6136672a038e1d4ee6a65d2" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-22T14:26:09+00:00"^^xsd:dateTime ;
