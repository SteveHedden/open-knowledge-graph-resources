    prov:generatedAtTime "2026-09-01T08:16:34+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-head-of-marketing-berlin-367471/1>,
        <https://www.arbeitnow.com/jobs/companies/andris-consulting-gmbh/head-of-marketing-berlin-367471> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "170dc2ac00093f0b75316029aa42f3fd7866108c0bbfc1a3cfc59a68cd47f624" ;
