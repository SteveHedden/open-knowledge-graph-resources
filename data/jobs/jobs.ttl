            schema:name "Moorgate London" ] ;
    schema:title "IT Systems and Infrastructure Engineer" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/checkatrade/it-systems-and-infrastructure-engineer-moorgate-362760> .

