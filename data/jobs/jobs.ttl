<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-account-executive-enterprise-sales-berlin-munich-239285> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-22T01:26:57+00:00"^^xsd:dateTime ;
