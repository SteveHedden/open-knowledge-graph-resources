<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-senior-field-marketing-manager-emea-295626> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-03T07:45:01+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-field-marketing-manager-emea-295626/1>,
