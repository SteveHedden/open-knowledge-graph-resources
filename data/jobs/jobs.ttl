            schema:name "Hamburg" ] ;
    schema:title "Werkstudent Business Analytics & Management Reporting (m/w/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/deutsche-giganetz-gmbh/werkstudent-business-analytics-management-reporting-hamburg-299092> .

