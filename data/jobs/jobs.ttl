            schema:name "London" ] ;
    schema:title "Senior Fullstack Engineer (Flutter/Node.js) - Mobile Experience" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/kpler/senior-fullstack-engineer-flutter-nodejs-mobile-experience-london-458158> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-go-to-market-manager-berlin-287699> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
