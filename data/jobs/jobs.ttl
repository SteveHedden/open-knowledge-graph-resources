<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-brand-visual-designer-berlin-145499> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-22T10:28:06+00:00"^^xsd:dateTime ;
