    schema:jobLocation [ a schema:Place ;
            schema:name "Hamburg, Hamburg, Deutschland" ] ;
    schema:title "Junior Wirtschaftsinformatiker/-in - Vollzeit (m/w/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/cordes-consulting-gmbh/junior-wirtschaftsinformatiker-in-vollzeit-hamburg-293343> .

