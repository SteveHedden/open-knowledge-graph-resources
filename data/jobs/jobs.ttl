<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-head-of-engineering-munich-474990> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-head-of-engineering-munich-474990/1>,
        <https://www.arbeitnow.com/jobs/companies/comstruct-ict/head-of-engineering-munich-474990> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "3349071dc0ef0c9595cda28105f56bb6a4c72b15a9cada28286408885e1c246e" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
