<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-chief-of-staff-product-london-133499> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-28T13:20:05+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-chief-of-staff-product-london-133499/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/omnea/chief-of-staff-product-london-133499> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "9334045ffd51984150d3345023151e3b807c617f19949452dd4a14f2bca8afc2" ;
    kgjobs:classification "not_match" ;
