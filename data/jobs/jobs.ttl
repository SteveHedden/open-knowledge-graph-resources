    schema:jobLocationType "ON_SITE" ;
    schema:title "Steuerfachangestellter, Steuerfachwirt oder Bilanzbuchhalter (m/w/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/kom-steuerberatung/steuerfachangestellter-steuerfachwirt-oder-bilanzbuchhalter-bernburg-282243> .

