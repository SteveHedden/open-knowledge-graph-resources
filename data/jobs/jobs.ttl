    kgjobs:active true ;
    kgjobs:canonicalFingerprint "91b38ff3625df4e289f3b6ba5776b8c3afd7650347e368303ef5e310ba40d77a" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-20T10:35:46+00:00"^^xsd:dateTime ;
