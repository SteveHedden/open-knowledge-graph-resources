<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-remote-senior-software-engineer-ruby-security-platform-authorization-340291> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-05T07:22:49+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-remote-senior-software-engineer-ruby-security-platform-authorization-340291/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/gitlab/remote-senior-software-engineer-ruby-security-platform-authorization-340291> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "e52430473cd200fde74cf52a71129747151c1ba0b0eeeb67f3364bbb79644c69" ;
    kgjobs:classification "not_match" ;
