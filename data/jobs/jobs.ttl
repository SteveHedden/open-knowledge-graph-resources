    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-19T22:29:16+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/bsi-software/werkstudent-recruiting-all-genders-darmstadt-87822> ;
    kgjobs:active true ;
