<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-area-sales-manager-uk-harpenden-309912> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-area-sales-manager-uk-harpenden-309912/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/jacir/area-sales-manager-uk-harpenden-309912> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "3492fdc6fb6bef3ba5cd9b99da0124d21aeda6dd703195200d3fc1bcb1896bf6" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
    kgjobs:reconciliationReason "no reviewed first-party candidate" ;
