    schema:jobLocationType "TELECOMMUTE" ;
    schema:title "Copywriter im E-Commerce (m/w/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/paselo-gmbh/copywriter-im-e-commerce-munster-277645> .

