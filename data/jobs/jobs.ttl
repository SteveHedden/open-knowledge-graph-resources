    schema:title "SAP S/4HANA Utilities / IS-U Migration Architect (m/w/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/natuvion-gmbh/remote-sap-s-4hana-utilities-is-u-migration-architect-berlin-278363> .

