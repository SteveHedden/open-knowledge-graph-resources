    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/enpal/operations-managerin-baustellen-berlin-351197> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "07ddc08e06261acdb4d5a7c6a275b8898f0ef42ad639ae25851e7529eab775de" ;
