            schema:name "Berlin, Berlin" ] ;
    schema:title "Bank Relationship and Analytics Manager (m/f/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/raisin/bank-relationship-and-analytics-manager-berlin-berlin-456484> .

