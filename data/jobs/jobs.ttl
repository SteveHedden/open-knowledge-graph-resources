    prov:generatedAtTime "2026-08-25T22:33:23+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/marqeta-inc/staff-solutions-engineer-eu-uk-london-136109> ;
