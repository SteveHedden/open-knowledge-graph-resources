    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-05T07:22:49+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-data-engineer-472202/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/nebius/data-engineer-472202> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "dce3787e9fea12c88ab2bdde2824696e3a3c36202da5e902e39b8433eec33335" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-05T07:22:49+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-09-05T07:22:49+00:00"^^xsd:dateTime ;
