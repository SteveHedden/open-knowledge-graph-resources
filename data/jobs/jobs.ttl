<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-remote-corporate-fpa-financial-planning-146369> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-28T13:20:05+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-remote-corporate-fpa-financial-planning-146369/1>,
        <https://www.arbeitnow.com/jobs/companies/codeway/remote-corporate-fpa-financial-planning-146369> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "005bbbbe367a1b7d20292e19ae4f2d8485f99b21d9c4a701d0f3f04753ad332c" ;
    kgjobs:classification "not_match" ;
