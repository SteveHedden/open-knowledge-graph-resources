    schema:url <https://www.arbeitnow.com/jobs/companies/exmox/senior-product-designer-ui-focus-hamburg-60573> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-product-manager-berlin-251220> a prov:Entity,
        schema:JobPosting ;
