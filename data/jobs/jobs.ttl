    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/knick-elektronische-messgerate-gmbh-co-kg/produktmanager-im-bereich-prozessanalytik-knick-berlin-441648> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "7527ccb5afca7ce0d9ef2eff8ef41a8f4ae5017cb85dc7ad6fe0dd8a4c24ecaf" ;
