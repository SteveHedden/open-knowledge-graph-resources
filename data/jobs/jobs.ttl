    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-29T09:42:00+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-ai-engineering-automation-specialist-on-site-berlin-193315/1>,
        <https://www.arbeitnow.com/jobs/companies/cloover/ai-engineering-automation-specialist-on-site-berlin-193315> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "265e81478463c48d575a417f46ed2151af6bdda38cf948cd5414c07c0f2858de" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-29T09:42:00+00:00"^^xsd:dateTime ;
