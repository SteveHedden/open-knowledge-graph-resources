<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/jobicy-149639> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/jobicy> ;
    prov:generatedAtTime "2026-08-25T04:43:13+00:00"^^xsd:dateTime ;
