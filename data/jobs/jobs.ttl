    prov:generatedAtTime "2026-08-19T04:41:07+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/fireworks/ai-field-engineer-emea-london-136196> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "cd76a513767ca2b0320f6f84db8db4d9d129f11c791f3d0779e9fde69ab3c2ba" ;
