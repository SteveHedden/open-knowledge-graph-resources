    prov:generatedAtTime "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-global-product-director-frankfurt-315816/1>,
        <https://www.arbeitnow.com/jobs/companies/emma-the-sleep-company/global-product-director-frankfurt-315816> ;
    kgjobs:active true ;
