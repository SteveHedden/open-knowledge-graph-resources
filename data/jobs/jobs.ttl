<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-machine-learning-engineer-i-berlin-409615> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-25T10:39:01+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/sumup/senior-machine-learning-engineer-i-berlin-409615> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "0fe3ce641eb0431968306327fa592c8baa5fc4be45f188e77696833c3b7e8ca0" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-25T08:53:42+00:00"^^xsd:dateTime ;
