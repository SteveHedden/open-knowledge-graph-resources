<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-principal-iam-consultant-identity-governance-and-data-access-london-490046> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-22T10:28:06+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/intelance/principal-iam-consultant-identity-governance-and-data-access-london-490046> ;
    kgjobs:active true ;
