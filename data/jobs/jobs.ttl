    prov:generatedAtTime "2026-08-19T22:29:16+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/jobbusters-gmbh/finanzbuchhalter-memmingen-110534> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "c9aa058d001243c9b0b8e62e9d5f8fe9158cea5d5934124d895db9e9b2afafdf" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-19T12:55:46+00:00"^^xsd:dateTime ;
