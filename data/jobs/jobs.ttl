<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/himalayas-371ba4dd9f6ecaa2> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/himalayas> ;
    prov:generatedAtTime "2026-08-18T20:14:44+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://himalayas.app/companies/dropbox/jobs/enterprise-context-architect> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "371ba4dd9f6ecaa2a4168e19cdafe814d520029891594214efba8db7e1a34067" ;
