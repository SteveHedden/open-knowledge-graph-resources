            schema:name "London, UK" ] ;
    schema:title "Solutions Engineer (Upmarket, Pre-Sales) - EMEA" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/vanta/solutions-engineer-upmarket-pre-sales-emea-london-225786> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-sports-trader-united-kingdom-293972> a prov:Entity,
