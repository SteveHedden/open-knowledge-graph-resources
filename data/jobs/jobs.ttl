    schema:title "Senior Construction Project Manager" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/elgin-energy/senior-construction-project-manager-london-203823> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-consultant-konzernkunden-strategieberatung-hamburg-440946> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
