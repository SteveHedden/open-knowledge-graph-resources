    kgjobs:canonicalFingerprint "e7ed9beab1462c7ae6a658155aba44f2dc2ef11316ea388cdf4458b56d8ee2ca" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-18T20:14:54+00:00"^^xsd:dateTime ;
