    prov:generatedAtTime "2026-08-25T10:39:01+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/zeal-network/working-student-growth-operations-content-management-hamburg-390763> ;
    kgjobs:active true ;
