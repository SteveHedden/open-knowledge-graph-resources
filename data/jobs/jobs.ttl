    prov:generatedAtTime "2026-09-03T07:45:01+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-people-partner-eu-london-450307/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/perk/people-partner-eu-london-450307> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "7a4108580209ac63844c4be4f1745065bc5950113ebaf2de02c3c55defbaf711" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-03T07:45:01+00:00"^^xsd:dateTime ;
