    schema:jobLocationType "TELECOMMUTE" ;
    schema:title "Kundenservice Mitarbeiter (m/w/d) [Home Office] - VZ - Sportartikel Hersteller" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/ketteler-funcken-gmbh/kundenservice-mitarbeiter-home-office-vz-sportartikel-hersteller-gutersloh-70690> .

