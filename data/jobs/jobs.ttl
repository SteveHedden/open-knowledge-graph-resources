    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-28T01:26:42+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-remote-sales-manager-485275/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/everfield/remote-sales-manager-485275> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "0d03ec999d5dc653f08d831a78609081cb82ea53bca006c98809c7ec9e48024c" ;
