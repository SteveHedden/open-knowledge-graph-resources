<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-wirtschaftsprufer-accounting-lead-buy-build-munchen-197726> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-25T10:39:01+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/vogel/wirtschaftsprufer-accounting-lead-buy-build-munchen-197726> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "ce2ec35724c354298d278d438ceeb4ac6ae4c044f30cd3a70f87536240141c3c" ;
