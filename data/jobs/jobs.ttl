    prov:generatedAtTime "2026-08-28T13:20:05+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-key-account-sales-manager-dusseldorf-27015/1>,
        <https://www.arbeitnow.com/jobs/companies/iwell/senior-key-account-sales-manager-dusseldorf-27015> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "5f01a0d4b149c6e36656449eeaeb7862d12e4dbdf871f0e30db988b942ca2541" ;
    kgjobs:classification "not_match" ;
