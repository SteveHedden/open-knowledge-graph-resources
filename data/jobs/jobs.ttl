    kgjobs:active true ;
    kgjobs:canonicalFingerprint "0fb6635590fc1227090e449c7a10ac79a3e198c2d0fc3c6c3ebdffadd67229df" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-20T03:00:49+00:00"^^xsd:dateTime ;
