    prov:generatedAtTime "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-product-manager-giftcard-berlin-190872/1>,
        <https://www.arbeitnow.com/jobs/companies/atolls/senior-product-manager-giftcard-berlin-190872> ;
