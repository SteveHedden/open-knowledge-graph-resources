<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-remote-sales-development-representative-sdr-virtual-data-rooms-europe-germany-141407> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-03T07:45:01+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-remote-sales-development-representative-sdr-virtual-data-rooms-europe-germany-141407/1>,
        <https://www.arbeitnow.com/jobs/companies/valutico-2/remote-sales-development-representative-sdr-virtual-data-rooms-europe-germany-141407> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "27d096df5f0138cc8df1800a1133197524a31e6a00775670f21c3bd1064db9d8" ;
