    schema:jobLocationType "ON_SITE" ;
    schema:title "Interim project - Senior DevOps Consultant (f/m/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/climate/interim-project-senior-devops-consultant-berlin-hq-201542> .

