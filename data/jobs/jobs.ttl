<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-platform-engineer-event-streaming-platform-kafka-berlin-105281> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-25T10:39:01+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/wolt/senior-platform-engineer-event-streaming-platform-kafka-berlin-105281> ;
