    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-talent-acquisition-maternity-cover-london-393578/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/inditex/talent-acquisition-maternity-cover-london-393578> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "e16de5c4e7b2cd77107dc827277b63ce977e03e57ba81fd9c9bdf981c7d8bbc3" ;
