    kgjobs:canonicalFingerprint "af251cb866694db79e871ae9de6b6d0f3dcf1061b828d78b09b5f2eedff1d110" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-19T06:51:44+00:00"^^xsd:dateTime ;
