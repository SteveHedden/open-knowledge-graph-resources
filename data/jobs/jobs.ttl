    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-werkstudent-mensch-client-service-media-dusseldorf-422658/1>,
        <https://www.arbeitnow.com/jobs/companies/wppmedia/werkstudent-mensch-client-service-media-dusseldorf-422658> ;
