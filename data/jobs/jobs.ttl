<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-systemadministrator-linux-freiburg-im-breisgau-273655> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-20T14:40:20+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/angeheuert-gmbh/systemadministrator-linux-freiburg-im-breisgau-273655> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "ac14bdf03d92701de4317ef6d217e340d9068fb2a682f77acc2d2884df340df6" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-20T12:57:15+00:00"^^xsd:dateTime ;
