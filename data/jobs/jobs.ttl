    schema:jobLocation [ a schema:Place ;
            schema:name "Remote" ] ;
    schema:title "(Senior) Account Executive (m/w/d) – eHealth / SaaS" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/samedi-gmbh/remote-senior-account-executive-ehealth-saas-498873> .

