    kgjobs:canonicalFingerprint "3d1cd26874a2eed064548f6a7522f6950a0417656319187cd3a171eb255c5ced" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-20T18:46:07+00:00"^^xsd:dateTime ;
