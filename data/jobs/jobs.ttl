    schema:jobLocation [ a schema:Place ;
            schema:name "Munich" ] ;
    schema:title "Bilanzbuchhalter (m/w/d) Fonds-Immobiliengesellschaft" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/jobbusters-gmbh/bilanzbuchhalter-fonds-immobiliengesellschaft-munich-374753> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-bilanzbuchhalter-konzernabschluss-cologne-66525> a prov:Entity,
