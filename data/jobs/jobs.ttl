    prov:generatedAtTime "2026-08-22T10:28:06+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/kraken/director-customer-growth-telco-london-33395> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "a2a477e63909d68ce269730c5539d763533eda097af434ac7c424ee1709ed86b" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-22T02:58:04+00:00"^^xsd:dateTime ;
