            schema:name "Leipzig" ] ;
    schema:title "Werkstudent Consulting - Healthcare-IT & Krankenhausprozesse (m/w/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/meierhofer/werkstudent-consulting-healthcare-it-krankenhausprozesse-leipzig-478999> .

