<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-field-marketing-manager-northern-europe-london-253443> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-25T04:44:23+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/mistralai/field-marketing-manager-northern-europe-london-253443> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "6fe48897c9d1822101f846e4bc8d81a155105a885d85114f1c5f9b44dda6bb13" ;
