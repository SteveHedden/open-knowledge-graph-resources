    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/ottonova/werkstudent-office-people-management-munchen-47679> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "b25cb2e10d29fc878916b76eb09dc910b53956ee65aca5a891a26aaf2d650218" ;
