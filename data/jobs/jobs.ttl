<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-remote-senior-product-designer-illustration-motion-edtech-65502> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-20T14:40:20+00:00"^^xsd:dateTime ;
