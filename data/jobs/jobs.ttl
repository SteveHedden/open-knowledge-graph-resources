            schema:name "London - The River Building HQ" ] ;
    schema:title "Senior Digital Marketing Specialist - Paid Social - FTC" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/deliveroo/senior-digital-marketing-specialist-paid-social-ftc-london-301789> .

