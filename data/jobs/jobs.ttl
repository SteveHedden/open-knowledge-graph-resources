            schema:name "Munich" ] ;
    schema:title "Production Planner" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/proxima-fusion-gmbh/production-planner-munich-134582> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-projektleiter-energieberatung-fur-hotels-ankum-49263> a prov:Entity,
