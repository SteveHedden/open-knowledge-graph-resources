    kgjobs:reconciliationReason "no reviewed first-party candidate" ;
    kgjobs:sourceOccurrence <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-field-based-business-development-executive-bristol-68012/1> ;
