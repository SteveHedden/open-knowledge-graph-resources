<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-remote-werkstudentin-public-sector-ki-strategie-innovation-berlin-224849> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
