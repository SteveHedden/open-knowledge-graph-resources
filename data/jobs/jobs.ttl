            schema:name "Berlin" ] ;
    schema:jobLocationType "TELECOMMUTE" ;
    schema:title "Head of Product - Remote - Healthtech (m/w/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/roger/head-of-product-remote-healthtech-berlin-70330> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-head-of-research-lab-munich-164894> a prov:Entity,
