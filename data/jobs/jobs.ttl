    kgjobs:active true ;
    kgjobs:canonicalFingerprint "9c0553ad0a97809da908cda283cc8e81a4e67616f58f0e1e34099854c5e96b21" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-25T06:56:47+00:00"^^xsd:dateTime ;
