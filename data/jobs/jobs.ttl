    schema:jobLocation [ a schema:Place ;
            schema:name "Berlin HQ" ] ;
    schema:title "Customer Success Manager - Renewable Supply" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/trawa/customer-success-manager-renewable-supply-berlin-8928> .

