<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-director-of-product-tech-delivery-bristol-london-11391> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-21T10:34:54+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/kaluza/director-of-product-tech-delivery-bristol-london-11391> ;
