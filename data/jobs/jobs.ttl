    kgjobs:active true ;
    kgjobs:canonicalFingerprint "b25e94bbce63bca5f65a243a0811600d61fda182982cfc5a971991ee0e95b79b" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-05T07:22:49+00:00"^^xsd:dateTime ;
