    kgjobs:reconciliationReason "no reviewed first-party candidate" ;
    kgjobs:sourceOccurrence <https://openknowledgegraphs.com/jobs/live/occurrence/himalayas-97d677906e84a88e/1> ;
    kgjobs:sourceRecordId "https://himalayas.app/companies/inizio-partners-corp/jobs/knowledge-graph-engineer" ;
