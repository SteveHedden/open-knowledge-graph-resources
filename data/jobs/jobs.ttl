    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-23T18:36:11+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/piabo/werkstudentin-graphic-design-berlin-b-13953> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "7de47bab554c8c1ef10ff3f1c7f4af88958b8913211ca6d302c9653e6e723099" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-23T16:30:50+00:00"^^xsd:dateTime ;
