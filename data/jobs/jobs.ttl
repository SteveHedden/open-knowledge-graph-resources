    prov:generatedAtTime "2026-09-03T07:45:01+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-remote-working-student-finance-76659/1>,
        <https://www.arbeitnow.com/jobs/companies/apheris/remote-working-student-finance-76659> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "6f91ce523dee348e48f4fa5c71f895ebaaa700241ffbef3a0e43df45053506e8" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-03T07:45:01+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-09-03T07:45:01+00:00"^^xsd:dateTime ;
