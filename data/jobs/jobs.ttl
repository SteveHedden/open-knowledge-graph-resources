<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-applied-ai-architect-industries-london-369437> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-20T10:35:46+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/anthropic/applied-ai-architect-industries-london-369437> ;
