<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-ecommerce-acceleration-manager-london-81283> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-ecommerce-acceleration-manager-london-81283/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/luzern-ecommerce-group/ecommerce-acceleration-manager-london-81283> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "f936ba3d75c5e2d9c6fde344db46080896c51d246b9a1a8db9704b5e52741eaa" ;
    kgjobs:classification "not_match" ;
