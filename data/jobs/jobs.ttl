    schema:jobLocationType "ON_SITE" ;
    schema:title "Fixed-Term Field Sales & Training Executive — Sephora UK" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/yepoda/fixed-term-field-sales-training-executive-sephora-uk-london-365778> .

