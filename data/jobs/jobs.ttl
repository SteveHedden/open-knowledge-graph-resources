    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-working-student-data-analyst-berlin-170440/1>,
        <https://www.arbeitnow.com/jobs/companies/bettermile/working-student-data-analyst-berlin-170440> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "6168154553f518ba54e267ed6e9b5ec6905283a32e27d15bd2af3ad449c9c06d" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-28T01:26:42+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-08-28T01:26:42+00:00"^^xsd:dateTime ;
    kgjobs:reconciliationReason "no reviewed first-party candidate" ;
