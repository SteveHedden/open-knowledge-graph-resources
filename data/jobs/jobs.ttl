    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-29T09:42:00+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-working-student-business-analyst-logistics-dusseldorf-north-rhine-westphalia-448045/1>,
        <https://www.arbeitnow.com/jobs/companies/teampicnic/working-student-business-analyst-logistics-dusseldorf-north-rhine-westphalia-448045> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "93355d8a107ab0ae2dc4e8bf5a86f945a62a9cbd488ee67524f7615ae1d8f352" ;
    kgjobs:classification "not_match" ;
