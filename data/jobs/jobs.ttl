        <https://www.arbeitnow.co.uk/jobs/companies/quantexa/finance-manager-london-341443> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "438536295ce31bf27de7ad5d449fe62886023eef4d87b3b60cb725614981b499" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-28T13:20:05+00:00"^^xsd:dateTime ;
