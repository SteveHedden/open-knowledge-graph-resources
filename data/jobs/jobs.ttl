<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-product-manager-martech-berlin-482580> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-19T04:41:07+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/justwatch/product-manager-martech-berlin-482580> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "eae198329b1f3884e962437fe3088b8e90f973108f690d22181ff5ddcc7ad349" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-19T03:01:52+00:00"^^xsd:dateTime ;
