<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-director-workforce-strategy-transformation-174366> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-02T07:36:12+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-director-workforce-strategy-transformation-174366/1>,
        <https://www.arbeitnow.com/jobs/companies/anaplan/director-workforce-strategy-transformation-174366> ;
    kgjobs:active true ;
