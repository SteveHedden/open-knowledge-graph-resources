<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-account-executive-mid-market-london-366770> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-28T13:20:05+00:00"^^xsd:dateTime ;
