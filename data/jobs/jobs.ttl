            schema:name "Office Frankfurt" ] ;
    schema:title "Marketing Pflichtpraktikant / Werkstudent (m/w/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/bloomwell-group-gmbh/marketing-pflichtpraktikant-werkstudent-office-frankfurt-39183> .

