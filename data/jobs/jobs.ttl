    prov:generatedAtTime "2026-09-01T08:16:34+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-staff-ai-product-manager-london-329323/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/intercom/staff-ai-product-manager-london-329323> ;
