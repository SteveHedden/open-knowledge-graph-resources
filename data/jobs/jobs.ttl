    prov:generatedAtTime "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-software-engineer-edinburgh-145631/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/fanduel/software-engineer-edinburgh-145631> ;
    kgjobs:active true ;
