    schema:url <https://www.arbeitnow.com/jobs/companies/prematch-sports-gmbh/software-engineer-data-all-genders-koln-358585> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-software-engineer-data-infrastructure-acquisition-cologne-germany-352635> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-23T18:36:11+00:00"^^xsd:dateTime ;
