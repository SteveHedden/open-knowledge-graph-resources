    kgjobs:active true ;
    kgjobs:canonicalFingerprint "6f0dbb5c042037d2c7d718c3e3499382050720ccfaafb09f633470bdd333125e" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-20T18:46:07+00:00"^^xsd:dateTime ;
