    dcterms:source <https://openknowledgegraphs.com/jobs/source/first-party-accenture> ;
    prov:generatedAtTime "2026-08-31T19:51:41+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://accenture.wd103.myworkdayjobs.com/AccentureCareers/job/Bengaluru/S-C-Global-Network---AI---CMT---Consultant-Data-Science_R00315583>,
