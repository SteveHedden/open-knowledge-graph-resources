    kgjobs:canonicalFingerprint "6bf60ba9fc331fe14870a3e4a7ef7b7c2061b9305019ef3b8f75e3b3f09b9448" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-18T20:14:54+00:00"^^xsd:dateTime ;
