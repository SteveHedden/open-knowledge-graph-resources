            schema:name "Bochum" ] ;
    schema:title "Engineering Manager - Cloud Platform & Operations (f/m/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/sonarsource/engineering-manager-cloud-platform-operations-bochum-387514> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-executive-assistant-moorgate-283217> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-22T10:28:06+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/checkatrade/executive-assistant-moorgate-283217> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "79a080c0853c324f0a34b2ffe469a57082c8abbeba28f1299d93c740f7b263e5" ;
