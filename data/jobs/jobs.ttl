    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-rgm-director-london-462902/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/sharkninjaoperatingllc/rgm-director-london-462902> ;
