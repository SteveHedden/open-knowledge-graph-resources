            schema:name "Gilching, Bayern, Germany" ] ;
    schema:title "Working Student – Order Processing, Export & Master Data Administration (m/f/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/quantum-systems-gmbh/working-student-order-processing-export-master-data-administration-gilching-438859> .

