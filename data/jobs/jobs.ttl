<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-software-developer-development-coordinator-net-ai-gestutzte-produktentwicklung-frankfurt-459907> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-18T22:28:45+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/qualityhosting-gmbh/senior-software-developer-development-coordinator-net-ai-gestutzte-produktentwicklung-frankfurt-459907> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "6ba97f06f6c5d3c2163d760d8d269a9ae09652482d9e9b995c79e62525c55965" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-18T20:14:54+00:00"^^xsd:dateTime ;
