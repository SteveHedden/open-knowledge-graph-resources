    schema:title "Account Manager, DACH" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/constructor/remote-account-manager-dach-209699> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-remote-database-administrator-germany-431335> a prov:Entity,
        schema:JobPosting ;
