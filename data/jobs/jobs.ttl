    kgjobs:canonicalFingerprint "890833406fbabc4ee454bb0e41824f63b5bf3eab2b3c2457805a3168c144a58f" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-21T08:46:28+00:00"^^xsd:dateTime ;
