<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-pflichtpraktikum-im-bereich-grafikdesign-stuttgart-75030> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-25T10:39:01+00:00"^^xsd:dateTime ;
