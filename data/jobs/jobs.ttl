    schema:jobLocation [ a schema:Place ;
            schema:name "London - The River Building HQ" ] ;
    schema:title "Digital Marketing Manager - Paid Social - FTC" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/deliveroo/digital-marketing-manager-paid-social-ftc-london-258636> .

