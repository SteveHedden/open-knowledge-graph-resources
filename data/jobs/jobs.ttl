    prov:generatedAtTime "2026-08-20T14:40:20+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/idealo-internet-gmbh/senior-android-engineer-kotlin-mwd-berlin-432695> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "741ed47b8e839f9b18ad211ef4062a8bbea7c22e73433d9e7b2a7ddca6787a2f" ;
