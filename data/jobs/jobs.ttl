    schema:jobLocationType "ON_SITE" ;
    schema:title "Staff AI Engineer - 2nd Horizon | Germany | Remote" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/grafanalabs/staff-ai-engineer-2nd-horizon-germany-remote-243956> .

