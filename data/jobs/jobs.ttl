    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-database-platform-manager-manchester-450268/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/thgingenuity/database-platform-manager-manchester-450268> ;
