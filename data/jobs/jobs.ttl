<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-manager-engineering-secure-build-and-scs-services-east-coast-preferred-england-85150> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-28T01:26:42+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-manager-engineering-secure-build-and-scs-services-east-coast-preferred-england-85150/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/docker/manager-engineering-secure-build-and-scs-services-east-coast-preferred-england-85150> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "39d903e9bac4e20f51bb2148fa1ac7fbdc182d4e7f7670ec7d71135f5a9e30ca" ;
