            schema:name "Berlin" ] ;
    schema:title "Nail Tech & Content Creator (m/f/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/nailscamp-gmbh/nail-tech-content-creator-berlin-476927> .

