<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-ausbildung-zum-fachinformatiker-mit-der-fachrichtung-systemintegration-2027-leipzig-443956> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-18T22:28:45+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/adragos-pharma-leipzig/ausbildung-zum-fachinformatiker-mit-der-fachrichtung-systemintegration-2027-leipzig-443956> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "49c358d9e0c42de68d502a3565ad89b346f80118b63a1a3553f96d258c22aeb6" ;
    kgjobs:classification "not_match" ;
