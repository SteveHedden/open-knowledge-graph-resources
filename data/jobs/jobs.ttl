    schema:title "Head of Product (all genders)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/kertos/head-of-product-all-genders-munich-383551> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-ingenieurin-verfahrenstechnik-maschinenbau-pilotanlagenbau-cologne-298311> a prov:Entity,
        schema:JobPosting ;
