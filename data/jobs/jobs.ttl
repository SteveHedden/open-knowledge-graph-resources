            schema:name "London" ] ;
    schema:title "Senior Talent Acquisition Partner" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/sumup/senior-talent-acquisition-partner-london-487365> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-technical-product-manager-b2b-saas-i-berlin-hybrid-345516> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-20T20:33:44+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/packmatic/senior-technical-product-manager-b2b-saas-i-berlin-hybrid-345516> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "5225ca4854fd48164481eef9fac577eb2220c57b61acceab0080ebf509c2044d" ;
