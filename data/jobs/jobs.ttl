            schema:name "London" ] ;
    schema:title "Growth Manager" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/kota/growth-manager-london-403387> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-head-of-banking-london-111665> a prov:Entity,
