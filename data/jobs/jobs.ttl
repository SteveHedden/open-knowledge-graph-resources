            schema:name "Nordenham, Niedersachsen, Deutschland" ] ;
    schema:title "Werkstudent (d/w/m): Bereich IT" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/sozialwerk/werkstudent-bereich-it-nordenham-199250> .

