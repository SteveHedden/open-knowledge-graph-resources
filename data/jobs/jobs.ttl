<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-studentische-hilfskraft-team-german-microdata-lab-shk-drs-2026-015-mannheim-341580> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-21T10:34:54+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/gesis-leibniz-institut-fur-sozialwissenschaften/studentische-hilfskraft-team-german-microdata-lab-shk-drs-2026-015-mannheim-341580> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "6f161fe8a167b67a135c01a1f58301582ba6f8fd3476c58d8dbcd2c025d99810" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-21T01:38:22+00:00"^^xsd:dateTime ;
