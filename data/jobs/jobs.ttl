    prov:generatedAtTime "2026-08-29T09:42:00+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-customer-success-manager-emea-london-148404/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/notabene/customer-success-manager-emea-london-148404> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "e0406e8741bf5eda2fdf903de41ec9ea017fe057c9a81c16959e40146e586978" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-29T09:42:00+00:00"^^xsd:dateTime ;
