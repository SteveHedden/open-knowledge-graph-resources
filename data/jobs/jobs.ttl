            schema:name "London" ] ;
    schema:title "Head of Credit Finance" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/lemfi/head-of-credit-finance-london-268697> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-head-of-d2c-e-commerce-cologne-433232> a prov:Entity,
