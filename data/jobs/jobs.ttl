    prov:generatedAtTime "2026-08-19T22:29:16+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/valuenet-group/senior-social-media-manager-all-genders-munchen-206977> ;
