    schema:jobLocationType "ON_SITE" ;
    schema:title "Teamleiter (m/w/d) Produktionscontrolling" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/deutsche-extrakt-kaffee-gmbh/teamleiter-produktionscontrolling-hamburg-212801> .

