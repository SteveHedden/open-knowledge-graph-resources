    schema:title "Senior Applied AI Engineer" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/forter/senior-applied-ai-engineer-95400> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-applied-ai-engineer-bochum-362667> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-22T10:28:06+00:00"^^xsd:dateTime ;
