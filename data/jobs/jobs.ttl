            schema:name "London (GB)" ] ;
    schema:title "Product Manager - Global Mobile" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/octopus-energy-group-jobs/product-manager-global-mobile-london-gb-169180> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-product-manager-westwing-collection-munich-office-399213> a prov:Entity,
