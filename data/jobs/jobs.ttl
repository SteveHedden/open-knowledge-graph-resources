<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-payroll-lohn-und-gehaltsbuchhalter-berlin-recklinghausen-nrw-247634> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-20T20:33:44+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/arsipa-gmbh/senior-payroll-lohn-und-gehaltsbuchhalter-berlin-recklinghausen-nrw-247634> ;
