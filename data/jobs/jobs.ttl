<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-marketing-content-intern-mandatory-internship-pflichtpraktikum-berlin-443828> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-02T07:36:12+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-marketing-content-intern-mandatory-internship-pflichtpraktikum-berlin-443828/1>,
        <https://www.arbeitnow.com/jobs/companies/cloud-studios/marketing-content-intern-mandatory-internship-pflichtpraktikum-berlin-443828> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "cbac0a77f455ebe547d266862c6f98d9f2c696af167c3b7df099bb4f506ea7b5" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-02T07:36:12+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-09-02T07:36:12+00:00"^^xsd:dateTime ;
    kgjobs:reconciliationReason "no reviewed first-party candidate" ;
    kgjobs:sourceOccurrence <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-marketing-content-intern-mandatory-internship-pflichtpraktikum-berlin-443828/1> ;
    kgjobs:sourceRecordId "marketing-content-intern-mandatory-internship-pflichtpraktikum-berlin-443828" ;
    schema:datePosted "2026-09-01"^^xsd:date ;
    schema:description "Most people don’t get real ownership until they’re years into their career. You’d get it in month one. Cloud Studios is an independent product studio in Berlin. We turn sharp insights into digital products people need, then build the strongest ones - and the brands behind them - into independent companies. Right now, we’re building across AI, consumer products and services, with our biggest current focus on a service helping brands understand and improve how they show up in AI recommendations. You’d be building the media presence behind all of it, starting with the founder’s own. This isn’t a “post more content” internship. You’ll take what’s actually happening inside the company - a product decision, client work, a raw idea, something we learned and turn it into content sharp enough to make someone stop scrolling. You’ll work directly with the founder and have real influence over what we create, what gets published and how our content evolves. Tasks Grow the presence of the founder (Eli) and our brands, primarily across LinkedIn and Instagram Create content across formats: posts, carousels, short-form video and more Turn raw ideas, conversations and product updates into content worth watching or reading Build a content waterfall system that turns one strong idea into multiple formats and channels Shoot and edit short-form and behind-the-scenes content with the founder and team Design visual content using Figma or Canva Develop and improve our content templates and visual systems Track what performs, kill what doesn’t and continuously test new ideas Help turn attention into actual leads and business opportunities Requirements You are currently enrolled at a university and the internship can be recognised as a mandatory internship (Pflichtpraktikum) within your degree Strong written and spoken English You understand how LinkedIn and Instagram actually work You can take a rough idea and turn it into something clear and engaging You have good visual instincts and are comfortable using Figma or Canva You’re proactive, reliable and comfortable taking ownership You’re curious about AI, startups, brands and new tools You care about the quality of what you put out No years of marketing experience required. We care more about taste, initiative and whether you can turn ideas into finished work Benefits Real ownership from day one - not busywork!!! Work directly with the founder and have a genuine say in what we build Create content that actually gets published and impacts the business Learn how founder-led marketing, content and lead generation work in practice Build a content system around real products and customer work Exposure to product, sales, growth and AI across multiple brands Freedom to experiment with formats, tools and ideas Build tangible work you can point to afterwards Strong performance can create a serious path towards a longer-term paid role as the studio grows. This is your opportunity to take! Hybrid work in Berlin (minimum 2 days in the Office, ideally more) Flexible 20–40 hours/week, with full-time preferred Skip the generic cover letter. We won’t read it. We’d rather understand how you think and what you have good taste in. Send us your answers for a few short questions below. Most importantly,if you have a portfolio, or something you’ve created that you’re genuinely proud of, we’d love to see it. Important: This is an unpaid mandatory internship (Pflichtpraktikum). You must currently be enrolled at a university that can recognise the placement as a mandatory part of your degree, and be have the required visa status to work/intern in Germany. Find Jobs in Germany on Arbeitnow" ;
    schema:employmentType "Internship, no experience required / student" ;
    schema:hiringOrganization kgjd:employer-cloud-studios ;
    schema:identifier "arbeitnow-marketing-content-intern-mandatory-internship-pflichtpraktikum-berlin-443828" ;
    schema:jobLocation <https://openknowledgegraphs.com/jobs/live/job/arbeitnow-marketing-content-intern-mandatory-internship-pflichtpraktikum-berlin-443828/location> ;
    schema:jobLocationType "ON_SITE" ;
    schema:title "Marketing & Content Intern (Mandatory Internship / Pflichtpraktikum)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/cloud-studios/marketing-content-intern-mandatory-internship-pflichtpraktikum-berlin-443828> .

