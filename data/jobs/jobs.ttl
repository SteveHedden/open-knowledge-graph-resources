            schema:name "Bamberg, Bayern, Deutschland" ] ;
    schema:title "Verkäuferin (m/w/d) - Werkstudent" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/gusti-leder-gmbh/verkauferin-werkstudent-bamberg-149851> .

