    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/niboline-gmbh/werkstudentin-grafikdesign-e-commerce-berlin-466687> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "abdbb71db22d1c3642d2769f4a27730ad1280040de702fca847874f3dda3547b" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-19T16:36:37+00:00"^^xsd:dateTime ;
