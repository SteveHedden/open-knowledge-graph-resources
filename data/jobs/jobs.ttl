    schema:jobLocationType "ON_SITE" ;
    schema:title "(Senior) Projektmanager Print (w/m/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/hirschen-group-gmbh/senior-projektmanager-print-berlin-schlesische-strasse-26-15913> .

