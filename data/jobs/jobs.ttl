    kgjobs:active true ;
    kgjobs:canonicalFingerprint "0a8eb440e17e942df3f7ba27e96777ee07f416184daa0bf3575dc64cb7777195" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-25T20:35:11+00:00"^^xsd:dateTime ;
