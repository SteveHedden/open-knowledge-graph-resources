<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-remote-senior-b2b-operations-manager-all-genders-344407> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-remote-senior-b2b-operations-manager-all-genders-344407/1>,
        <https://www.arbeitnow.com/jobs/companies/stapelstein/remote-senior-b2b-operations-manager-all-genders-344407> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "35829c05820572277801c006fcf2cb2ecf6bb632d2675ab7172974ec62e401a3" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
