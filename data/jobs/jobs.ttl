        <https://www.arbeitnow.co.uk/jobs/companies/united-media/senior-management-consultant-at-united-media-london-370132> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "d97584604218c9ad87014ab60576db8cc6aa3ed2a6305859e12ba61e0413e608" ;
    kgjobs:classification "not_match" ;
