            schema:name "London" ] ;
    schema:title "Payroll Manager" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/trustly/payroll-manager-london-277194> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-people-operations-coordinator-london-341912> a prov:Entity,
