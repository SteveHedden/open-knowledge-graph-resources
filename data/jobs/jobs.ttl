    prov:generatedAtTime "2026-08-20T10:35:46+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/adlicious/junior-campaign-manager-hamburg-102836> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "7c869dbc39d9e0cbe8164eef4cc6b887df9af91366b448aa5feb1dfdc0f5c613" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-20T08:43:54+00:00"^^xsd:dateTime ;
