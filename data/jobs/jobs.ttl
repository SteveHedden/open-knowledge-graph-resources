    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-28T13:20:05+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-director-of-corporate-development-berlin-19086/1>,
        <https://www.arbeitnow.com/jobs/companies/andercore/director-of-corporate-development-berlin-19086> ;
    kgjobs:active true ;
