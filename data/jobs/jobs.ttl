    schema:jobLocation [ a schema:Place ;
            schema:name "London" ] ;
    schema:title "Senior Corporate Counsel (1-year maternity cover)" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/unybrands/senior-corporate-counsel-1-year-maternity-cover-london-54115> .

