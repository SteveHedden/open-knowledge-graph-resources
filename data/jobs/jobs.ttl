    prov:generatedAtTime "2026-08-29T09:42:00+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-back-end-engineer-london-202125/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/prima/back-end-engineer-london-202125> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "844b996bcc7a1460d51a9bfa21ff9e78d8935f81040fac5053db51dbdabd7c7c" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-28T13:20:05+00:00"^^xsd:dateTime ;
