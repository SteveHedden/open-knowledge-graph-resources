    prov:wasDerivedFrom <https://jobicy.com/jobs/151450-engineering-manager-emea-core> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "fe47f3fce3129b892c947b5bd8594b26a433aacebfb13ff9c56ce18ac8ded742" ;
