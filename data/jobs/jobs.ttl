    schema:title "DevOps Engineer AWS & Kubernetes, Junior/Intermediate (m/w/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/new-monday-gmbh/devops-engineer-aws-kubernetes-junior-intermediate-berlin-387611> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-devops-engineer-ftc-london-460271> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
