    kgjobs:canonicalFingerprint "d579ab1bb2bc117154728191cd73b4e7f6ec97107158cde0a079a3f456dcf7d3" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-20T01:27:27+00:00"^^xsd:dateTime ;
