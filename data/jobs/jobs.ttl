    schema:jobLocation [ a schema:Place ;
            schema:name "Berlin, Berlin" ] ;
    schema:title "Senior Specialist, Internal Audit" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/bitpanda/senior-specialist-internal-audit-berlin-berlin-54823> .

