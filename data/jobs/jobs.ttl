    prov:generatedAtTime "2026-08-20T20:33:44+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/lrz/system-engineer-open-source-collaboration-kubernetes-garching-bei-munchen-354831> ;
    kgjobs:active true ;
