    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-01T08:16:34+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-junior-account-executive-london-14625/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/transperfect/junior-account-executive-london-14625> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "fa11840c92a8de6fd800a96d6f371c9d5beee7ce0459f78ae5b749077e45eb5e" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-01T04:57:44+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-09-01T08:16:34+00:00"^^xsd:dateTime ;
    kgjobs:reconciliationReason "no reviewed first-party candidate" ;
    kgjobs:sourceOccurrence <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-junior-account-executive-london-14625/1> ;
    kgjobs:sourceRecordId "junior-account-executive-london-14625" ;
    schema:datePosted "2026-08-31"^^xsd:date ;
    schema:description "Sterling Technology, a subsidiary of TransPerfect, is the leading provider of premium virtual data room (VDR) solutions for the secure sharing of content, business process automation, and collaboration for the M&A, corporate development, real estate, capital markets, private capital, banking, and legal communities. Sterling has been supporting the M&A and capital markets for over 30 years, initially with financial printing services. Since opening our first VDR in 2010, we have helped customers from over 187 countries and 90 industries successfully complete thousands of deals. With offices in seven major financial centers, Sterling is trusted by its users to deliver exceptional levels of service on their most critical transactions. Summary: The main focus of the role is to enhance clients' relationships and develop new accounts within different industries. Your responsibilities and tasks will include: Create effective approaches to drive new revenue and close new business Identify, qualify, develop, and close sales opportunities Develop an effective understanding of the capabilities, benefits, and competitive advantages of Sterling’s services Identify prospective leads; develop new client relationships via cold calling, internet research, networking events, and direct marketing Promote Sterling by educating clients on the company’s various services Present Sterling via one-on-one, group, online and in-person meetings Provide customer support and manage client expectations Quote, manage, and bill projects daily, coordinating with clients and production teams to ensure these run smoothly and profitably Communicate professionally at all levels of seniority Essential skills and experience: Bachelor’s degree or its equivalent Excellent written and verbal proficiency in English Experience and/or interest in sales or a client-facing role Ability to build and maintain long-term client relationships Strong presentation skills (both in-person and online) Strong problem-solving and analytical abilities Highly organised with strong attention to detail Able to prioritise, manage tasks, and work effectively in a team Eager to learn, embrace challenges, and driven to succeed Preferred experience: Experience and/or interest in Financial, Professional, Legal or Technology services Experience and/or interest in the M&A space Experience in a B2B sales/business development role Sounds like a match? We look forward to meeting you! By applying, I confirm I have read and accept TransPerfect's Privacy Policy: https://www.transperfect.com/about/data-privacy-recruiting Find Jobs in United Kingdom on Arbeitnow" ;
    schema:employmentType "fulltime permanent, Mid" ;
    schema:hiringOrganization kgjd:employer-transperfect ;
    schema:identifier "arbeitnow-junior-account-executive-london-14625" ;
    schema:jobLocation <https://openknowledgegraphs.com/jobs/live/job/arbeitnow-junior-account-executive-london-14625/location> ;
    schema:jobLocationType "ON_SITE" ;
    schema:title "Junior Account Executive" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/transperfect/junior-account-executive-london-14625> .

