    kgjobs:active true ;
    kgjobs:canonicalFingerprint "9ed5da61724798fdc8bd3262e88f32f49b8b81742ab226bd330b47144eeb02e3" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-27T16:28:01+00:00"^^xsd:dateTime ;
