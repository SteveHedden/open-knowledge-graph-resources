            schema:name "Freiburg" ] ;
    schema:title "Werkstudent Kundenservice | Spätschicht & Samstagsdienst (m/w/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/wattfox/werkstudent-kundenservice-spatschicht-samstagsdienst-freiburg-90203> .

