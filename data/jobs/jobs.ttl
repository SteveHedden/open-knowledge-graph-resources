    schema:jobLocation <https://openknowledgegraphs.com/jobs/live/job/arbeitnow-teamleiter-finanzbuchhaltung-plus-input-fur-prozessoptimierung-stuttgart-414102/location> ;
    schema:title "Teamleiter Finanzbuchhaltung (w/m/d) plus Input für Prozessoptimierung" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/fischer-partner-gesellschaft-fur-personal-mbh/teamleiter-finanzbuchhaltung-plus-input-fur-prozessoptimierung-stuttgart-414102> .

