            schema:name "USA" ] ;
    schema:jobLocationType "TELECOMMUTE" ;
    schema:title "Senior/Staff Software Engineer (C++)" ;
    schema:url <https://jobicy.com/jobs/151366-senior-staff-software-engineer-c> .

