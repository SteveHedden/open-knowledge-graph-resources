    prov:generatedAtTime "2026-08-19T12:55:46+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/planetlabs/data-analyst-berlin-21502> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "7f1594642277b44797e438b577baf15287e17549932f7b8f0b6eef247df195b2" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-19T12:55:46+00:00"^^xsd:dateTime ;
