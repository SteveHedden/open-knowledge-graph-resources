    schema:title "Principal Solutions Architect, Technology Sales Lead (AWS)" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/vmlenterprisesolutions/principal-solutions-architect-technology-sales-lead-aws-london-223456> .

