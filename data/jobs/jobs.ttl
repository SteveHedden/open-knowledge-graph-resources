            schema:name "New York" ] ;
    schema:title "Member of DevRel Staff - Developer Advocate" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/tesslcareers/member-of-devrel-staff-developer-advocate-new-york-36036> .

