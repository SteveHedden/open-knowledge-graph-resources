    prov:generatedAtTime "2026-09-05T07:22:49+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-site-reliability-engineer-london-259308/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/voleon/site-reliability-engineer-london-259308> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "bfecc8698c8b5ece51b9aa03719f91dc51074c25f3f579a1e3071f4006b767b9" ;
    kgjobs:classification "not_match" ;
