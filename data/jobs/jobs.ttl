<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-chief-of-staff-cto-london-150598> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-20T14:40:20+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/callosum/chief-of-staff-cto-london-150598> ;
