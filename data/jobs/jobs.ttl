    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/memodo/mitarbeiterin-after-sales-support-munich-37696> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "57472edf9022ce40c6ffd9cff4a0de7f0951adb836b8a00b24272a13a0b14c0a" ;
