<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-product-manager-savings-investments-berlin-90770> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-19T22:29:16+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/finom/senior-product-manager-savings-investments-berlin-90770> ;
