<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-director-workforce-strategy-transformation-london-18971> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
