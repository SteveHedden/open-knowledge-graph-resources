    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-23T18:36:11+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/jobbusters-gmbh/bilanzbuchhalter-fonds-immobiliengesellschaft-munich-374753> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "0ecd1f52a40e8dc9c3875a00f39071ec23fab97455105ed5b20a8a47cf50a365" ;
    kgjobs:classification "not_match" ;
