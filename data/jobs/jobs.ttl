    prov:generatedAtTime "2026-08-20T14:40:20+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/angi/senior-analyst-fpa-london-455421> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "0114b8e3e328ceebf13175534be81f28449118dee09a9afca07213af19014d45" ;
