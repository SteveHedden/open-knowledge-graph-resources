<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-intern-vision-software-development-germany-munich-hq-206646> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
