<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-consultant-search-ai-visibility-seo-geo-dusseldorf-445565> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-25T04:44:23+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/towa-the-digital-growth-company/senior-consultant-search-ai-visibility-seo-geo-dusseldorf-445565> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "d96753902b3922d262172b30948bbd456b2bf69f5e571c4c78fd97e9de4e3f50" ;
