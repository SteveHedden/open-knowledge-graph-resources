            schema:name "Berlin" ] ;
    schema:title "Senior Full-Stack Engineer (Python/Django + Vue.js)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/hivebuy/senior-full-stack-engineer-python-django-vuejs-berlin-423545> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-fullstack-engineer-flutter-nodejs-mobile-experience-london-458158> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-19T12:55:46+00:00"^^xsd:dateTime ;
