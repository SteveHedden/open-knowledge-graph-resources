        <https://www.arbeitnow.co.uk/jobs/companies/deliveroo/strategy-operations-manager-customer-experience-london-288762> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "809065134b9dc52b9285b9a4e2a3ac5f6578093f0c9ac2722f3a5d80025076b8" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-28T13:20:05+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-08-28T13:20:05+00:00"^^xsd:dateTime ;
    kgjobs:reconciliationReason "no reviewed first-party candidate" ;
    kgjobs:sourceOccurrence <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-strategy-operations-manager-customer-experience-london-288762/1> ;
