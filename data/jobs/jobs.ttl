            schema:name "Berlin" ] ;
    schema:title "Performance Marketing Manager (m/f/x) - Mid Level" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/altitude/performance-marketing-manager-mid-level-berlin-410868> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-pflichtpraktikum-ubersetzung-sprachprufung-de-eng-eng-de-kitzingen-94755> a prov:Entity,
