            schema:name "Rostock, Mecklenburg-Vorpommern, Deutschland" ] ;
    schema:title "Werkstudentin im Bereich E-Commerce / Marketplace (m/w/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/gusti-leder-gmbh/werkstudentin-im-bereich-e-commerce-marketplace-rostock-58516> .

