    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-19T12:55:46+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/thenewyorktimes/senior-video-journalist-news-and-enterprise-london-152846> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "54613ce1799c3fa6036b48f130ccd421a4b45f2eb85fa5b71edea4e2c6c488c6" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-19T04:41:07+00:00"^^xsd:dateTime ;
