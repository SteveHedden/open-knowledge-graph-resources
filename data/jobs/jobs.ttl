    prov:generatedAtTime "2026-09-05T07:22:49+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-principal-field-excellence-london-192412/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/realtimeboardglobal/principal-field-excellence-london-192412> ;
