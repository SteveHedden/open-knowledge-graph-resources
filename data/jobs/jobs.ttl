    schema:title "Praktikant Management Consulting (w/m/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/scaleon-gmbh/praktikant-management-consulting-berlin-211083> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-principal-product-designer-312349> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
