            schema:name "Remote" ] ;
    schema:jobLocationType "TELECOMMUTE" ;
    schema:title "Account Executive, Enterprise Frankfurt" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/purestorage/remote-account-executive-enterprise-frankfurt-413269> .

