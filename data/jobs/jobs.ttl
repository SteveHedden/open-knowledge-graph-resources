<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-director-of-engineering-frontend-technologies-marketplace-technologies-berlin-54101> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
