<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-director-clinical-pharmacology-london-440028> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-20T14:40:20+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/relationrx/director-clinical-pharmacology-london-440028> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "946ee3554466f6987be11183b972d770de42041131373706277c769604dcd5b4" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-20T12:57:15+00:00"^^xsd:dateTime ;
