            schema:name "Munich" ] ;
    schema:title "Software Engineer, Platform - Munich, Germany" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/speechify/software-engineer-platform-munich-germany-161452> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-software-engineer-sensor-fusion-gilching-223212> a prov:Entity,
        schema:JobPosting ;
