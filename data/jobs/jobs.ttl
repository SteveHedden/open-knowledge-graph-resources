            schema:name "Berlin; Munich" ] ;
    schema:title "Senior Business Analyst" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/jetbrains/senior-business-analyst-berlin-munich-307395> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-business-development-partnerships-manager-london-301003> a prov:Entity,
