    kgjobs:active true ;
    kgjobs:canonicalFingerprint "adb7956e26df990e41a8486678323c731076d89290d61ffbfcc83cb6fd9df393" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-21T12:56:36+00:00"^^xsd:dateTime ;
