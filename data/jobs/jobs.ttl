        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-28T01:26:42+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-staff-backend-engineer-germany-71024/1>,
        <https://www.arbeitnow.com/jobs/companies/develocity/staff-backend-engineer-germany-71024> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "65c00b9e2d2db5a8478ac7a5d2407066384f8a97db180d79e37b3d4d1526acc2" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-28T01:26:42+00:00"^^xsd:dateTime ;
