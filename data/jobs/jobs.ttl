    prov:generatedAtTime "2026-08-28T13:20:05+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-fachplaner-sanitar-projektingenieur-tga-kg-410-berlin-75339/1>,
        <https://www.arbeitnow.com/jobs/companies/ingenieurgesellschaft-bbp-bauconsulting-mbh/fachplaner-sanitar-projektingenieur-tga-kg-410-berlin-75339> ;
    kgjobs:active true ;
