    prov:generatedAtTime "2026-08-20T20:33:44+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/maora-studios-gmbh/head-of-d2c-e-commerce-cologne-433232> ;
