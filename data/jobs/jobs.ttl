<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-linux-systemadministrator-freiburg-im-breisgau-300300> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-20T14:40:20+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/angeheuert-gmbh/linux-systemadministrator-freiburg-im-breisgau-300300> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "201af5a3ed35bbd364f952f439e57ca049707763ebd6c57d36bbfc817f27a76c" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-20T12:57:15+00:00"^^xsd:dateTime ;
