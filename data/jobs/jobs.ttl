            schema:name "Berlin" ] ;
    schema:title "Meister SHK (m/w/d) - Automatisierung & Trinkwasser in Berlin" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/wurdig-pumpentechnik-gmbh-cokg/meister-shk-automatisierung-trinkwasser-in-berlin-55030> .

