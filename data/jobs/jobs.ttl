<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-director-credit-risk-london-351103> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-29T09:42:00+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-director-credit-risk-london-351103/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/airwallex/director-credit-risk-london-351103> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "db14bbd962cddcb331b2e50110db49091b268def615291b3e071db0fd4523e11" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-29T09:42:00+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-08-29T09:42:00+00:00"^^xsd:dateTime ;
