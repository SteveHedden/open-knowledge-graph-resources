            schema:name "Berlin" ] ;
    schema:title "Project Manager Business Solutions | SAP SD (w/m/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/right-search/project-manager-business-solutions-sap-sd-berlin-123767> .

