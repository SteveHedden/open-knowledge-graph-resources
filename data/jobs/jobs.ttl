    prov:generatedAtTime "2026-08-19T04:41:07+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/juro/senior-product-manager-london-140719> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "fd121869d932bce5a60952b4363398e0e7cc57d7b764b4e6ccfee295e0dc75d7" ;
