<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-steuerfachangestellter-steuerfachwirt-bilanzbuchhalter-alle-berlin-352988> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-01T08:16:34+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-steuerfachangestellter-steuerfachwirt-bilanzbuchhalter-alle-berlin-352988/1>,
        <https://www.arbeitnow.com/jobs/companies/consultia-steuerberatungsgesellschaft-mbh/steuerfachangestellter-steuerfachwirt-bilanzbuchhalter-alle-berlin-352988> ;
