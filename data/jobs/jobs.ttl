<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-remote-senior-software-engineer-200108> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-19T04:41:07+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/conceptboard/remote-senior-software-engineer-200108> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "715d00f2627a816cbdae1504869b9c97b08a0a27f0406b508745b61d22f7abec" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-18T22:28:45+00:00"^^xsd:dateTime ;
