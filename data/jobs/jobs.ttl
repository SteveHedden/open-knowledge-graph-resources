<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-founding-head-of-product-london-103156> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-19T22:29:16+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/heim/founding-head-of-product-london-103156> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "aeb05f3bf67bc8badf258cc7861c05a319bf0d820816c64984067e96dc33b813" ;
