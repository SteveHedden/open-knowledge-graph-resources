    schema:title "Senior Account Director Digital Solutions / Client Partner (m/f/x)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/virtual-identity/remote-senior-account-director-digital-solutions-client-partner-freiburg-183541> .

