<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-werkstudent-in-im-einkauf-materialbeschaffung-munchen-487213> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-22T10:28:06+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/technica-engineering-gmbh/werkstudent-in-im-einkauf-materialbeschaffung-munchen-487213> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "ae429d1dd76cac3d7fb01801644c6ea47798ab02b05204bfe763f225bea8c9b8" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-22T10:28:06+00:00"^^xsd:dateTime ;
