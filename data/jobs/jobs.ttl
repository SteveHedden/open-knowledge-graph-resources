<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-director-ux-design-berlin-berlin-278842> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-28T01:26:42+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-director-ux-design-berlin-berlin-278842/1>,
        <https://www.arbeitnow.com/jobs/companies/hellofresh/director-ux-design-berlin-berlin-278842> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "75c0723fa462108dbc08b01f5762c157871bab99ae4dab593c4882efe1ba01d3" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-28T01:26:42+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-08-28T01:26:42+00:00"^^xsd:dateTime ;
    kgjobs:reconciliationReason "no reviewed first-party candidate" ;
