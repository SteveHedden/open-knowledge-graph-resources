<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-senior-fire-investigator-ireland-belfast-northern-ireland-102745> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-02T07:36:12+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-fire-investigator-ireland-belfast-northern-ireland-102745/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/jensenhughes/senior-fire-investigator-ireland-belfast-northern-ireland-102745> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "b18456658659e2b79afacf4cd703a5aadc43d00a3feb4c960e86e19090cce5cd" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-02T07:36:12+00:00"^^xsd:dateTime ;
