    schema:jobLocation [ a schema:Place ;
            schema:name "Berlin" ] ;
    schema:title "Trainee Frontend Development (m/w/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/brandung/trainee-frontend-development-berlin-398719> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-ui-ux-manager-karlsruhe-247958> a prov:Entity,
