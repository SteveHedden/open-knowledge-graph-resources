            schema:name "Recklinghausen, Nordrhein-Westfalen, Deutschland" ] ;
    schema:title "Senior Payroll / Lohn- und Gehaltsbuchhalter (m/w/d) - Berlin / Recklinghausen (NRW)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/arsipa-gmbh/senior-payroll-lohn-und-gehaltsbuchhalter-berlin-recklinghausen-nrw-247634> .

