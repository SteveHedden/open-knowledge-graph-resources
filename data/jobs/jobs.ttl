<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-remote-linux-systemadministrator-freiburg-im-breisgau-38559> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-remote-linux-systemadministrator-freiburg-im-breisgau-38559/1>,
        <https://www.arbeitnow.com/jobs/companies/angeheuert-gmbh/remote-linux-systemadministrator-freiburg-im-breisgau-38559> ;
