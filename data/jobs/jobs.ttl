<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-remote-junior-data-engineer-data-platform-104347> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-23T18:36:11+00:00"^^xsd:dateTime ;
