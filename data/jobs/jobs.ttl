<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-pharmaziepraktikant-fur-2027-halle-north-rhine-westphalia-213133> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-20T10:35:46+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/simtrabps/pharmaziepraktikant-fur-2027-halle-north-rhine-westphalia-213133> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "915afe1a7a4549f8938cb64ed3c4d5d25476ab3134561ee214f90d5d24b78856" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-20T04:42:08+00:00"^^xsd:dateTime ;
