    schema:title "Senior Catalog Strategist & Taxonomist (Contract-to-Hire)" ;
    schema:url <https://himalayas.app/companies/parachute-health/jobs/senior-catalog-strategist-taxonomist-contract-to-hire> ;
    schema:validThrough "2026-10-07"^^xsd:date .

