    prov:generatedAtTime "2026-08-22T01:26:57+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/todaytix-group/senior-manager-platform-operations-london-uk-406258> ;
