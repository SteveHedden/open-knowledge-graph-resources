            schema:name "Munich (DEU)" ] ;
    schema:title "Robotics Software Engineer Counter UAV Systems - Generalist (mid-level)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/autonomous-teaming/robotics-software-engineer-counter-uav-systems-generalist-mid-level-munich-deu-206242> .

