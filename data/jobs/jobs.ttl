    prov:generatedAtTime "2026-08-19T04:41:07+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/hero-software/remote-quality-assurance-engineer-berlin-278465> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "3b74331bf70318d0a88ec0f8b64af1e059b61c7fb66c9a460f71de095a5e8dd7" ;
