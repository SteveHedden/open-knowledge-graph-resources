    prov:generatedAtTime "2026-09-02T07:36:12+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-ai-engineer-london-197914/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/quantum/senior-ai-engineer-london-197914> ;
    kgjobs:active true ;
