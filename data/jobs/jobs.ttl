    schema:url <https://www.arbeitnow.com/jobs/companies/ampeco-global/senior-solution-consultant-pre-sales-dach-germany-267150> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-solution-engineer-pre-sales-remote-uk-235643> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-22T10:28:06+00:00"^^xsd:dateTime ;
