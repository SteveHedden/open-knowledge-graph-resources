            schema:name "Berlin , Berlin, Germany" ] ;
    schema:title "Software Engineer (m/f/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/amperecloud-gmbh/software-engineer-berlin-368361> .

