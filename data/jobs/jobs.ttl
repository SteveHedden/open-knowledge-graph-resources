    schema:title "Technical Support Specialist (Hospitality) German speaking- all genders" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/lightspeedhq/technical-support-specialist-hospitality-german-speaking-all-genders-cologne-429389> .

