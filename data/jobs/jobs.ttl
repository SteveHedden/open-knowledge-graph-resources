            schema:name "Munich" ] ;
    schema:title "UAV Operations Engineer / Pilot – Data Operations (all genders)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/stark/uav-operations-engineer-pilot-data-operations-all-genders-munich-390797> .

