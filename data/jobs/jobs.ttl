    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-29T09:42:00+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-sales-manager-essen-84310/1>,
        <https://www.arbeitnow.com/jobs/companies/enpal/sales-manager-essen-84310> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "8fc82890a06200e7569ff276c2eaacde966cf62123d4273279bd1742d7b0d9ec" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-29T09:42:00+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-08-29T09:42:00+00:00"^^xsd:dateTime ;
