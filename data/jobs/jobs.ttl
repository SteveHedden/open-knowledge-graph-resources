            schema:name "Manchester" ] ;
    schema:title "Principal Software Engineer - Full Stack - AI" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/anaplan/principal-software-engineer-full-stack-ai-manchester-110420> .

