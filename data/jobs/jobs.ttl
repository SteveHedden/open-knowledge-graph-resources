    kgjobs:active true ;
    kgjobs:canonicalFingerprint "6eeba3219dfc9d68ff9c903e877dbbb836e4b815eea1a6bb00ede09f37d1c2b5" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-19T22:29:16+00:00"^^xsd:dateTime ;
