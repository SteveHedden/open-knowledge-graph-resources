    prov:generatedAtTime "2026-08-20T20:33:44+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/freetrade/customer-operations-associate-transfers-london-480678> ;
    kgjobs:active true ;
