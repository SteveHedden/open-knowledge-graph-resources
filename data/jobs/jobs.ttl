<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-ai-software-engineer-united-kingdom-277853> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-20T14:40:20+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/aveni/senior-ai-software-engineer-united-kingdom-277853> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "224847f7e50803550e500851464db85c284a4d007230422f8e88440a310fba47" ;
