<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-java-engineer-team-search-berlin-16564> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
