            schema:name "München" ] ;
    schema:title "Senior webMethods Integration Engineer (w/m/d) in Teil- oder Vollzeit" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/crozdach/senior-webmethods-integration-engineer-in-teil-oder-vollzeit-munchen-474542> .

