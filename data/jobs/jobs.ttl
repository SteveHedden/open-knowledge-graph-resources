    schema:jobLocation [ a schema:Place ;
            schema:name "Hamburg" ] ;
    schema:title "Senior Quality Assurance Engineer (f/m/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/zeal-network/senior-quality-assurance-engineer-hamburg-23520> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-sales-manager-ryze-digital-holding-gmbh-mainz-412372> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-25T04:44:23+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/ryze-digital/senior-sales-manager-ryze-digital-holding-gmbh-mainz-412372> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "669eff6107392ac3859b3a8e5667cb55f3a55409da0b7d18bf49fe68428585b3" ;
