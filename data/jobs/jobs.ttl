<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-engineering-manager-scheduling-team-berlin-berlin-111613> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-18T22:28:45+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/doctolib/engineering-manager-scheduling-team-berlin-berlin-111613> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "2c7a820ba528312e371df9b64f421a93c76a618ebda49a1396952793638f9b45" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-18T20:14:54+00:00"^^xsd:dateTime ;
