        <https://www.arbeitnow.com/jobs/companies/crytek/publishing-product-director-frankfurt-20786> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "ded03f60532ee0f7d9af796ad641e5e80b8576522e4d301e8d58cec94e58250b" ;
    kgjobs:classification "not_match" ;
