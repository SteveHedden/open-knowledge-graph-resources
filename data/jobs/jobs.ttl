    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-28T13:20:05+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-google-performance-analytics-manager-stuttgart-477740/1>,
        <https://www.arbeitnow.com/jobs/companies/efly-marketplace-services-gmbh/senior-google-performance-analytics-manager-stuttgart-477740> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "8356a84fda7d0bc19b1aac4a33f580b109fd66e4d8086a860a44f129cd2a33d4" ;
