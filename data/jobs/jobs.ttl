<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-manager-accounting-london-443983> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-25T22:33:23+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/opentable/senior-manager-accounting-london-443983> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "2cc55f09904d51eb86a2d037152a40d6b1680f236f2b79cd8999ec2c02f47e18" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-25T20:35:11+00:00"^^xsd:dateTime ;
