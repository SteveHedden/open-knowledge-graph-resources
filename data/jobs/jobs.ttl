<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-account-manager-london-111489> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-19T04:41:07+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/sohohouseco/senior-account-manager-london-111489> ;
    kgjobs:active true ;
