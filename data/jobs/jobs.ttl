            schema:name "London, Greater London, United Kingdom" ] ;
    schema:title "Founding Implementation Lead (NHS)" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/heim/founding-implementation-lead-nhs-london-133213> .

