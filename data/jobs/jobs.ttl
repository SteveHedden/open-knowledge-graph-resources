<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-software-engineer-platform-london-285809> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-20T20:33:44+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/algo1/software-engineer-platform-london-285809> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "c33ad630cda2b57095064d2d3893a755c3267fbc3b9d3970c4f34f8a5d2bacd1" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-20T18:46:07+00:00"^^xsd:dateTime ;
