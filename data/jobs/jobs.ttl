    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-chief-of-staff-london-47507/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/more-in-common/chief-of-staff-london-47507> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "56a708a9210ac8b5582023e9035d8a5d2b402d10962930f1f6b95871abbd9fba" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-01T04:57:44+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-09-01T08:16:34+00:00"^^xsd:dateTime ;
