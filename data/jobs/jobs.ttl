    kgjobs:canonicalFingerprint "687afc85459fe62d6b2e46d922981d8b23a5f6b81ed7d384f57cea8f78baf4fa" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-05T07:22:49+00:00"^^xsd:dateTime ;
