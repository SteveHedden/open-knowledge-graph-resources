    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-19T04:41:07+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/conesso/werkstudent-wirtschaftsinformatik-it-20h-woche-koln-125269> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "cb562bb731f65d859908c68808a4ab03d0c87cf1026dc635c6ee8f76651a1d87" ;
    kgjobs:classification "not_match" ;
