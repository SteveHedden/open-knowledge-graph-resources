            schema:name "Regensburg" ] ;
    schema:title "Werkstudent Online Marketing & E-Commerce (m/w/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/alphatrail-gmbh/werkstudent-online-marketing-e-commerce-regensburg-483103> .

