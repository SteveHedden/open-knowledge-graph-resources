        <https://www.arbeitnow.co.uk/jobs/companies/sumup/senior-content-editorial-lead-london-354334> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "25662ef75868cb50cab3c820313f1bd3ee133278a043fed259cfd3775fb715e0" ;
    kgjobs:classification "not_match" ;
