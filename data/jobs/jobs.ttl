    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-25T04:44:23+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/ritter-von-gral-gmbh/werkstudent-fur-digital-campaign-management-cottbus-266615> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "ee2876b7d00ee853eb1049b3d07881e4043f9dbc56e4790745955b317a675c7e" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-24T16:43:20+00:00"^^xsd:dateTime ;
