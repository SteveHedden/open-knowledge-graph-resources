    schema:jobLocation [ a schema:Place ;
            schema:name "Berlin" ] ;
    schema:title "Werkstudent:in Retail Expansion / Retail Growth (m/w/d) in Berlin Mitte" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/juit-gmbh/werkstudentin-retail-expansion-retail-growth-in-berlin-mitte-133079> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-werkstudentin-simulation-frankfurt-am-main-381751> a prov:Entity,
