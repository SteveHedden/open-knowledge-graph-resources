    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-22T01:26:57+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/ema/senior-technical-support-specialist-uk-london-26096> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "78c937e0d5f5ac9372d2dfb4d190d6b54d941f7b3430854ceaf3a9c7c49feed5" ;
