    prov:generatedAtTime "2026-08-21T10:34:54+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/perk/senior-pr-manager-london-289024> ;
    kgjobs:active true ;
