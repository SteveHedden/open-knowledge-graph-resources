    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-20T10:35:46+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/harvey/legal-engineer-emea-funds-or-ip-london-493325> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "53514991902c7381e134146c66d2c28a4bdf53434e6b3f2485ef8c1bee7aff2f" ;
    kgjobs:classification "not_match" ;
