<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-software-engineer-go-212737> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
