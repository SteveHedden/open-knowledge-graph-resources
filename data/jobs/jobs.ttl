    kgjobs:canonicalFingerprint "d04c933b717a4f1d06164ce4440797c823c260ff26de16ccebafbffb1c5af43b" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-21T16:39:30+00:00"^^xsd:dateTime ;
