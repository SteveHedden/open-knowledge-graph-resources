            schema:name "Cologne, North Rhine-Westphalia, Germany" ] ;
    schema:title "iOS Engineer - Design System" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/sumup/ios-engineer-design-system-cologne-401158> .

