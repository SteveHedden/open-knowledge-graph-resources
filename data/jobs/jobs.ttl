    prov:generatedAtTime "2026-09-05T07:22:49+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-werkstudent-seo-content-berlin-386056/1>,
