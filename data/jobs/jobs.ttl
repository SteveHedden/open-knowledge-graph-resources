    kgjobs:canonicalFingerprint "d336c01797bf720ae5ba0cf27e1a7726297aeae3d9a97d10913c695c2573d159" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-20T12:57:15+00:00"^^xsd:dateTime ;
