    schema:title "Freelance Data Scientist with Ontology and Graph expertise" ;
    schema:url <https://himalayas.app/companies/adesso-belgium/jobs/freelance-data-scientist-with-ontology-and-graph-expertise> ;
    schema:validThrough "2026-10-03"^^xsd:date .

