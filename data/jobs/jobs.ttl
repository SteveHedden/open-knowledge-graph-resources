<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-junior-clinical-fellow-winnersh-280711> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-22T01:26:57+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/montu-uk/junior-clinical-fellow-winnersh-280711> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "848a53735a8fbd022211e8a89b8e90c60e967872b0d4020156b83db05c1b533d" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-21T08:46:28+00:00"^^xsd:dateTime ;
