    kgjobs:active true ;
    kgjobs:canonicalFingerprint "df85f48670554aa82760ed11ded7284bf3ac2665736d82221b888a0a6d113ca5" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-19T03:01:52+00:00"^^xsd:dateTime ;
