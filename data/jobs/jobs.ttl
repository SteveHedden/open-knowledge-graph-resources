<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-account-executive-enterprise-united-kingdom-476964> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-20T10:35:46+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/plane/account-executive-enterprise-united-kingdom-476964> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "f9afc8e251562152237036a04dcb20a6a1277edb1347b86c1fd94b95e5704049" ;
