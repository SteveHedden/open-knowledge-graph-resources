<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-field-sales-account-executive-manchester-51741> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-19T22:29:16+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/lightspeedhq/field-sales-account-executive-manchester-51741> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "0ca2bea0bdd1b1a794fc85b89d84548947a822c2187259738ce908ef7e81c9a8" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-19T12:55:46+00:00"^^xsd:dateTime ;
