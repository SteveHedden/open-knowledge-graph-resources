            schema:name "Berlin" ] ;
    schema:title "Junior AI/ML Engineer, Data and Evaluation" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/redmimicry-gmbh/junior-ai-ml-engineer-data-and-evaluation-berlin-438979> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-junior-grafikdesigner-hamburg-389122> a prov:Entity,
