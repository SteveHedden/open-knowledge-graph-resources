<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-remote-lead-java-developer-solution-architect-6-month-contract-london-14772> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-26T04:45:30+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/gravity9/remote-lead-java-developer-solution-architect-6-month-contract-london-14772> ;
    kgjobs:active true ;
