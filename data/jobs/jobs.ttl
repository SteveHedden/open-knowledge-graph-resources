            schema:name "Berlin" ] ;
    schema:title "Senior Performance Marketing Manager – Paid Social & AI (m/w/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/benuta-gmbh/senior-performance-marketing-manager-paid-social-ai-berlin-166193> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-product-engineer-ims-all-genders-berlin-389485> a prov:Entity,
