    schema:jobLocation [ a schema:Place ;
            schema:name "Dormagen" ] ;
    schema:title "Werkstudent (m/w/d) Projektmanagment" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/neasol-gmbh/werkstudent-projektmanagment-dormagen-427564> .

