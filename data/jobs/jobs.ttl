    schema:jobLocation <https://openknowledgegraphs.com/jobs/live/job/arbeitnow-innomaster-softwareentwicklung-berufsbegleitendes-masterstudium-wise27-hamburg-218884/location> ;
    schema:title "InnoMaster Softwareentwicklung (berufsbegleitendes Masterstudium) - WiSe27" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/innogames/innomaster-softwareentwicklung-berufsbegleitendes-masterstudium-wise27-hamburg-218884> .

