    prov:generatedAtTime "2026-08-25T10:39:01+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/databricks/director-alliance-35443> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "c1da158670647840be39fb7732766c8498bebf2de62b709cd3dcbc82e93b7f2e" ;
