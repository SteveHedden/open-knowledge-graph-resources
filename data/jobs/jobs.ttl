<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-manager-group-accounting-49477> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-22T10:28:06+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/autoscout24/senior-manager-group-accounting-49477> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "ba42c08b3de213e06d37c801ecfcf0fc5201b4009b1c7cee0a5105d89c171992" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-21T18:42:27+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-08-22T10:28:06+00:00"^^xsd:dateTime ;
    kgjobs:sourceRecordId "senior-manager-group-accounting-49477" ;
    schema:datePosted "2026-08-21"^^xsd:date ;
    schema:description "<p><strong>A career driven by you.</strong><br>Join AutoScout24 Group and experience life in the fast lane. We’re not just leading the market; we’re creating it. We’re constantly innovating, evolving, and transforming things for our customers. We’re driven, ambitious, and determined to do our best work together. For a career that doesn’t stand still, where you can put your ideas in the driving seat and change the way the world moves, join our international community.</p> <h4><strong>Why this role is unique</strong></h4> <ul> <li>Central role at the core of <strong>Group Finance and consolidation</strong></li> <li>Coordination of the <strong>group consolidation process</strong> in a multi-entity environment</li> <li>Exposure to complex <strong>technical accounting topics</strong></li> <li>High visibility across Finance and close collaboration with Group Reporting</li> <li>Strong development path into senior roles within Group Accounting</li> </ul> <h4><strong>What you’ll do</strong></h4> <ul> <li>Coordinate the group consolidation process (<strong>in</strong> <strong>OneStream</strong>) across all entities</li> <li>Perform IFRS adjustments and technical accounting calculations</li> <li>Validate and reconcile financial data from all legal entities</li> <li>Ensure consistency and integrity of group financial data</li> <li>Deliver accurate and reliable data as basis for Group Financial Reporting</li> </ul> <h4><strong>What you’ll bring</strong></h4> <ul> <li>Hands-on experience in group accounting or consolidation</li> <li>Background in <strong>Big4 or corporate accounting</strong></li> <li>Strong knowledge of <strong>IFRS</strong></li> <li>Experience with consolidation tools is a plus</li> <li>Structured, analytical, and detail-oriented mindset</li> </ul> <p><strong>A culture of growth</strong></p> <p>With over 50 nationalities represented, we’re proud to welcome people of all backgrounds to our growing community, and we’re always finding new ways to help people feel welcomed and included. Here, you’ll have the tools, training and support you need to work in a way that suits you, learn new skills and reach your potential.</p> <p><strong>For a career where you can drive our business and shape your future, apply now.</strong></p> <p>&nbsp;</p> Find more English Speaking Jobs in Germany on Arbeitnow" ;
    schema:hiringOrganization kgjd:employer-autoscout24 ;
    schema:identifier "arbeitnow-senior-manager-group-accounting-49477" ;
    schema:title "(Senior) Manager Group Accounting (m/f/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/autoscout24/senior-manager-group-accounting-49477> .

