    schema:jobLocation [ a schema:Place ;
            schema:name "Berlin" ] ;
    schema:title "Trainee (m/w/d) Financial Consulting: Entrepreneurship und IHK-Qualifikation" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/horbach-berlin/trainee-financial-consulting-entrepreneurship-und-ihk-qualifikation-berlin-200166> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-trainee-pharmacy-dispenser-winnersh-279099> a prov:Entity,
