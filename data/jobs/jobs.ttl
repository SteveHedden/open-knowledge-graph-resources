    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/form3/senior-software-engineer-go-212737> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "cab940517c5640d72336eeaa2550519da24af572155cfc10a072a8a28c3245b3" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-25T06:56:47+00:00"^^xsd:dateTime ;
