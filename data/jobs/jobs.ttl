    schema:jobLocation [ a schema:Place ;
            schema:name "Munich" ] ;
    schema:title "(Senior) B2B Sales Manager (m/w/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/finn/senior-b2b-sales-manager-munich-211529> .

