    prov:generatedAtTime "2026-09-03T07:45:01+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-teamleiter-fahrzeugbewertung-grossraum-hamburg-69013/1>,
        <https://www.arbeitnow.com/jobs/companies/caronsale/teamleiter-fahrzeugbewertung-grossraum-hamburg-69013> ;
    kgjobs:active true ;
