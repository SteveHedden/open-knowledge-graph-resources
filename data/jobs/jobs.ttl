<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-senior-manager-security-architecture-manchester-217267> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
