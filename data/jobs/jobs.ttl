<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-senior-product-manager-281122> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-28T01:26:42+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-product-manager-281122/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/nearform/senior-product-manager-281122> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "a59b9746f13d2ce8cf9449df09b410e8a80f76abc71d6615d4f11f29c73dcddf" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-28T01:26:42+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-08-28T01:26:42+00:00"^^xsd:dateTime ;
