    kgjobs:active true ;
    kgjobs:canonicalFingerprint "7c0a13b28369ed8c7e2a2f6b1d92d460c89f13325772acb48b2888e4feb0c39f" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-18T20:14:54+00:00"^^xsd:dateTime ;
