    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-software-engineer-release-engineering-326196/1>,
        <https://www.arbeitnow.com/jobs/companies/mozilla/software-engineer-release-engineering-326196> ;
