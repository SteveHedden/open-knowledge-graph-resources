    schema:title "Werkstudent Rechtsabteilung / Working Student Legal (m/w/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/telio-group/werkstudent-rechtsabteilung-working-student-legal-hamburg-112300> .

