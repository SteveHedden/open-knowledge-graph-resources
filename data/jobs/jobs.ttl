            schema:name "London" ] ;
    schema:title "People Operations Coordinator" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/lemfi/people-operations-coordinator-london-31892> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-personalreferent-mit-schwerpunkt-recruiting-vastorf-482128> a prov:Entity,
