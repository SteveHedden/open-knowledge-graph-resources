<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-account-executive-munchen-294163> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
