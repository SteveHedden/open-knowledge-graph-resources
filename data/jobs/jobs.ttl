    kgjobs:active true ;
    kgjobs:canonicalFingerprint "df697acd73626832e3d67f96c710e5cfd31f6ba38a35af9acbc6c3ee4c09906c" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-28T01:26:42+00:00"^^xsd:dateTime ;
