            schema:name "Munich" ] ;
    schema:title "Senior Software Engineer - Mission Autonomy (All Genders)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/stark/senior-software-engineer-mission-autonomy-all-genders-munich-44683> .

