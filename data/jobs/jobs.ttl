            schema:name "Hamburg, Hamburg, Deutschland" ] ;
    schema:title "Senior-Performance-Marketer/in – Vollzeit (m/w/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/cordes-consulting-gmbh/senior-performance-marketer-in-vollzeit-hamburg-55285> .

