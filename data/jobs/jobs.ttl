    kgjobs:active true ;
    kgjobs:canonicalFingerprint "5c539aff637bc8899ad82f1e1008e49157a137aced385e19f036e003ef393a58" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-18T20:14:54+00:00"^^xsd:dateTime ;
