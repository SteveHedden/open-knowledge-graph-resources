    prov:generatedAtTime "2026-08-25T22:33:23+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/montu-uk/remote-consultant-pain-management-paye-347823> ;
