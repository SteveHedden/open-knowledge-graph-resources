    prov:generatedAtTime "2026-08-26T04:45:30+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/rti/senior-consulting-engineer-315865> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "f362db9b61209264e4ee39039f6c500c4872c0436a35473fc688fa1062772042" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-25T16:34:13+00:00"^^xsd:dateTime ;
