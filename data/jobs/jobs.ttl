    schema:jobLocation [ a schema:Place ;
            schema:name "Köln" ] ;
    schema:title "Absolvent / Berufseinsteiger (m/w/d) für Erneuerbare Energien" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/vamo/absolvent-berufseinsteiger-fur-erneuerbare-energien-koln-324571> .

