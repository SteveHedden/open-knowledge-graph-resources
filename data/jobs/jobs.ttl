    schema:title "Senior Solutions Architect (EDW Enterprise Data Warehouse Migrations)" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/databricks/senior-solutions-architect-edw-enterprise-data-warehouse-migrations-london-219495> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-strategic-procurement-engineer-munich-310642> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-19T12:55:46+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/tytan-technologies-gmbh/senior-strategic-procurement-engineer-munich-310642> ;
