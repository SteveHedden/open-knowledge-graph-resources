            schema:name "London" ] ;
    schema:title "Lead PreSales Solutions Engineer" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/hubspotjobs/lead-presales-solutions-engineer-london-268908> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-lead-product-designer-cardiff-270699> a prov:Entity,
        schema:JobPosting ;
