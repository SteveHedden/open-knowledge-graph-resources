            schema:name "Berlin" ] ;
    schema:title "Senior IT Internal Auditor" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/sumup/senior-it-internal-auditor-berlin-486780> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-java-developer-konstanz-berlin-oder-remote-879> a prov:Entity,
