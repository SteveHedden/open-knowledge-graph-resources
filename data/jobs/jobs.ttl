    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-28T13:20:05+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-controller-finance-business-partner-hamburg-483396/1>,
        <https://www.arbeitnow.com/jobs/companies/pammys-dieseo-gmbh/senior-controller-finance-business-partner-hamburg-483396> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "2d1511b50802142fb31039ea77f4fffb899503134317bb5848174ad611089c7e" ;
