<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-principal-ai-engineer-london-188490> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-principal-ai-engineer-london-188490/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/anaplan/principal-ai-engineer-london-188490> ;
    kgjobs:active true ;
