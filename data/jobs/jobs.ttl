            schema:name "Berlin" ] ;
    schema:title "Senior AI/ML Engineer, Security Log Intelligence" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/redmimicry-gmbh/senior-ai-ml-engineer-security-log-intelligence-berlin-431641> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-application-security-engineer-london-452412> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-18T22:28:45+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/tripadvisor/senior-application-security-engineer-london-452412> ;
