    kgjobs:active true ;
    kgjobs:canonicalFingerprint "002339015ed672bb5018d19342687222fdff0b557b1babc83ad314632d1dd82d" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-19T10:33:07+00:00"^^xsd:dateTime ;
