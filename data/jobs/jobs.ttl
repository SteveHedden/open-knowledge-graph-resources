    kgjobs:active true ;
    kgjobs:canonicalFingerprint "7fcf5b54a3dd8d46e503ece4147a7bfd7b3e6993f4f62a526c5e0409c8bd3be2" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-19T03:01:52+00:00"^^xsd:dateTime ;
