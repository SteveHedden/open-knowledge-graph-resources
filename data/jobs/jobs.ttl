<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-technical-product-owner-core-berlin-berlin-248619> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-21T10:34:54+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/superchat/technical-product-owner-core-berlin-berlin-248619> ;
