<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-executive-assistant-to-the-founders-united-kingdom-26860> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-23T18:36:11+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/paires/executive-assistant-to-the-founders-united-kingdom-26860> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "1d56dd3003546fad3e6835f530894407d7d6d3a3a5da024d732692eaaa6e7da0" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-22T22:26:58+00:00"^^xsd:dateTime ;
