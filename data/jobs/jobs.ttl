            schema:name "Berlin, Berlin, Deutschland" ] ;
    schema:title "Senior Manager (m/w/d) - Finance Excellence & Integration" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/arsipa-gmbh/senior-manager-finance-excellence-integration-berlin-499571> .

