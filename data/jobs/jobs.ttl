    schema:jobLocationType "ON_SITE" ;
    schema:title "Director Sales / Vertriebsleiter (m/w/d) International // Maschinenbau // 120-150k OTE" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/saleshead-recruiting/director-sales-vertriebsleiter-international-maschinenbau-120-150k-ote-aachen-329135> .

