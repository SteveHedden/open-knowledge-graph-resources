    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-28T01:26:42+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-it-system-engineer-microsoft-cloud-infrastructure-hannover-472525/1>,
        <https://www.arbeitnow.com/jobs/companies/michael-wessel/it-system-engineer-microsoft-cloud-infrastructure-hannover-472525> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "f637cc64c439814a18a4d82f204dbf7ff777b1558b645ee0b7f78129819d782f" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-28T01:26:42+00:00"^^xsd:dateTime ;
