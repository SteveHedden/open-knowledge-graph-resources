            schema:name "Berlin" ] ;
    schema:title "Trainee Frontend Development (m/w/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/brandung/trainee-frontend-development-berlin-105141> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-trainee-influencer-marketing-us-market-berlin-39568> a prov:Entity,
