<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-manager-ai-transformation-legal-risk-and-compliance-london-25826> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-28T01:26:42+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-manager-ai-transformation-legal-risk-and-compliance-london-25826/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/checkoutcom/manager-ai-transformation-legal-risk-and-compliance-london-25826> ;
