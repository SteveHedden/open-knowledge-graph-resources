    prov:generatedAtTime "2026-08-20T14:40:20+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/deutsche-giganetz-gmbh/werkstudent-business-analytics-management-reporting-hamburg-299092> ;
