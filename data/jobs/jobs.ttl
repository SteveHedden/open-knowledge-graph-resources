    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/talentwert-digital-research-studio/projektmitarbeiter-ki-data-research-nebenjob-freelancer-flexibel-remote-leipzig-401065> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "b67061243f3440afaa9ca2dd9fa4c64f9cd2363d5b3cce7b09d1a224af38e908" ;
    kgjobs:classification "not_match" ;
