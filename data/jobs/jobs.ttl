<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-software-engineer-foundation-berlin-339190> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
