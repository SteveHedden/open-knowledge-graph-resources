<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-people-culture-manager-united-kingdom-456609> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-20T14:40:20+00:00"^^xsd:dateTime ;
