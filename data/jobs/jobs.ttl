    prov:generatedAtTime "2026-08-20T14:40:20+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/brandforce-gmbh/werkstudierende-oder-werkstudierender-grafik-oder-kommunikationsdesign-fur-20-wochenstunden-hamburg-84246> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "af89b65402709d0b5ee9538bf7da6404c6fa94bbf4de5b25c9ae4641458ec052" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-20T10:35:46+00:00"^^xsd:dateTime ;
