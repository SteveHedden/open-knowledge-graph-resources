<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-avionics-hardware-engineer-ottobrunn-bavaria-129132> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-25T22:33:23+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/isaraerospace/senior-avionics-hardware-engineer-ottobrunn-bavaria-129132> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "4f0d8a466b8311d7a5003b4fdea3cb45ffd89699faafd77779d5a9d6c0e1b68d" ;
    kgjobs:classification "not_match" ;
