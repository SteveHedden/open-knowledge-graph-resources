    prov:generatedAtTime "2026-09-05T07:22:49+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/firstparty%3Afirst-party-microsoft-research%3A1185119/1>,
        <https://www.microsoft.com/en-us/research/opportunity/msra-ai-forward-deployed-intern-accelerator-team/> ;
    kgjobs:active true ;
