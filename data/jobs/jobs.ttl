    kgjobs:classification "qualified" ;
    kgjobs:firstSeenAt "2026-08-31T19:51:41+00:00"^^xsd:dateTime ;
    kgjobs:hasEvidence <https://openknowledgegraphs.com/jobs/live/job/firstparty%3Afirst-party-amazon%3A10412466/evidence/1>,
