            schema:name "London" ] ;
    schema:title "Research Scientist - Robot Learning (VLA / WAM)" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/spaitial/research-scientist-robot-learning-vla-wam-london-287210> .

