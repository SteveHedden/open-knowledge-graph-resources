<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-operations-manager-customer-care-scaling-phase-berlin-407992> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-03T07:45:01+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-operations-manager-customer-care-scaling-phase-berlin-407992/1>,
        <https://www.arbeitnow.com/jobs/companies/matera-gmbh/operations-manager-customer-care-scaling-phase-berlin-407992> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "7d46e243ab21a8279f72ff24534b224a20946dff9656879d933b025d8b095c13" ;
    kgjobs:classification "not_match" ;
