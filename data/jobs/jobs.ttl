    kgjobs:canonicalFingerprint "78068edecdb7e6d7ad588b2ac31d22bd86943dc8651dd0cbae1d435359ea1b0c" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-25T20:35:11+00:00"^^xsd:dateTime ;
