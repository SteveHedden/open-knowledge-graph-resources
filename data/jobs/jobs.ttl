    schema:jobLocation <https://openknowledgegraphs.com/jobs/live/job/firstparty%3Afirst-party-amazon%3A10461653/location> ;
    schema:title "Senior Delivery Consultant - Data , Professional Services, AWSI HCLS" ;
    schema:url <https://www.amazon.jobs/en/jobs/10461653/senior-delivery-consultant-data-professional-services-awsi-hcls> .

