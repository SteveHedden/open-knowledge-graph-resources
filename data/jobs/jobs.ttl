    prov:generatedAtTime "2026-08-20T14:40:20+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/linxon-deutschland/baustellenleiter-landesbauordnung-konstanz-311418> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "d241017232ae61826329523dd8a35ecd78411600beddbf1e803a2d1afb7838fa" ;
    kgjobs:classification "not_match" ;
