    schema:jobLocation <https://openknowledgegraphs.com/jobs/live/job/arbeitnow-senior-experience-manager-all-genders-welcome-munchen-164878/location> ;
    schema:title "Senior Experience Manager – all genders welcome!" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/vicegolf/senior-experience-manager-all-genders-welcome-munchen-164878> .

