            schema:name "London" ] ;
    schema:title "ML Research Engineer - Member of Technical Staff" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/callosum/ml-research-engineer-member-of-technical-staff-london-236886> .

