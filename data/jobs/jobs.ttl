    schema:title "Product Manager, Contractor Management" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/remotecom/product-manager-contractor-management-36005> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-product-manager-global-mobile-london-gb-169180> a prov:Entity,
        schema:JobPosting ;
