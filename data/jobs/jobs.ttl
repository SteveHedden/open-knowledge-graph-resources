<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-assurance-manager-eu-uk-london-273454> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
