<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-people-foundations-intern-all-genders-munich-141981> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-25T22:33:23+00:00"^^xsd:dateTime ;
