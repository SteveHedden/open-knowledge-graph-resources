<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-remote-chief-of-staff-147387> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-19T12:55:46+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/1komma5grad/remote-chief-of-staff-147387> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "0ef9140a2d2f14985366a82a948d182ec25766c5882ff5f8e73bb08ddd9c807a" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-19T03:01:52+00:00"^^xsd:dateTime ;
