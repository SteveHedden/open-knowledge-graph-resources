            schema:name "München" ] ;
    schema:title "Werkstudent (m/w/d) Influencer Marketing für unsere Marke Achterhof" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/vitafy/werkstudent-influencer-marketing-fur-unsere-marke-achterhof-munchen-229575> .

