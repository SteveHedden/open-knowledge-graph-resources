        <https://www.arbeitnow.co.uk/jobs/companies/deliveroo/field-based-business-development-executive-bristol-68012> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "b77284077d66b6cb0b010f2db0772cd3c70f606c4e03f4fdd351324ba0eccef8" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-05T07:22:49+00:00"^^xsd:dateTime ;
