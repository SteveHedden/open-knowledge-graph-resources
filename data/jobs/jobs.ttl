            schema:name "Hamburg, Hamburg, Deutschland" ] ;
    schema:title "Senior Media-Buyer – Vollzeit (m/w/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/cordes-consulting-gmbh/senior-media-buyer-vollzeit-hamburg-385590> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-ml-ops-engineer-berlin-289031> a prov:Entity,
