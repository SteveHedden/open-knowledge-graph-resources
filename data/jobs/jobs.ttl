<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-global-solutions-architect-cloud-london-119074> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-02T07:36:12+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-global-solutions-architect-cloud-london-119074/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/rubrik/global-solutions-architect-cloud-london-119074> ;
