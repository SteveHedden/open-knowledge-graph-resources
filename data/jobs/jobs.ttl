    schema:title "Senior Backend Engineer - Energy Management Platform (all genders)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/gridx-gmbh/remote-senior-backend-engineer-energy-management-platform-all-genders-113609> .

