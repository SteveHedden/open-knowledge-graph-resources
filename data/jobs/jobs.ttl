    kgjobs:canonicalFingerprint "a8c836f72c3db6bfbb7f6113761aa8df7e90badd66ebaa7285a09baec442d792" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-02T07:36:12+00:00"^^xsd:dateTime ;
