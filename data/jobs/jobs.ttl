<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-senior-associate-european-competition-practice-dusseldorf-munich-387707> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-03T07:45:01+00:00"^^xsd:dateTime ;
