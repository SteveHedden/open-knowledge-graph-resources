            schema:name "London" ] ;
    schema:title "Talent Pool" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/frontier-health/talent-pool-london-94839> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-team-lead-commercial-partnerships-uki-london-294037> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-20T14:40:20+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/mollie/team-lead-commercial-partnerships-uki-london-294037> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "c554c9fc649c6597399debe8e9e1ec84c74be2d3b1b7f56f9af8c40bd5cb6366" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-20T12:57:15+00:00"^^xsd:dateTime ;
