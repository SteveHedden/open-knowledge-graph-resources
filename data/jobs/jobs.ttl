    prov:generatedAtTime "2026-08-19T04:41:07+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/bit-consulting/remote-regional-account-director-emea-433452> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "e31f58eda21df7ec5805c96322d9b441cc353d73b00bfc52fa575a1d734db70b" ;
