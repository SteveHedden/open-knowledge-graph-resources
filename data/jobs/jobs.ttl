            schema:name "London" ] ;
    schema:title "Global Brand Relations Director" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/sohohouseco/global-brand-relations-director-london-230228> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-global-onboarding-united-kingdom-42448> a prov:Entity,
        schema:JobPosting ;
