    prov:generatedAtTime "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-forward-deployed-engineer-berlin-99601/1>,
