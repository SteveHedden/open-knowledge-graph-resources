            schema:name "Dusseldorf" ] ;
    schema:title "Werkstudent Digital Media Marketing (Mensch)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/wppmedia/werkstudent-digital-media-marketing-mensch-dusseldorf-465869> .

