    schema:url <https://www.arbeitnow.com/jobs/companies/civey-gmbh/consultant-key-account-manager-berlin-489632> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-contract-platform-engineer-berlin-257326> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
