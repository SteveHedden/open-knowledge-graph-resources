            schema:name "London" ] ;
    schema:title "Senior CRM Manager - Lifecycle & Retention" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/m-kopa/senior-crm-manager-lifecycle-retention-london-123347> .

