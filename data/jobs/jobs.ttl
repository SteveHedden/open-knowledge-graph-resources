        <https://www.arbeitnow.co.uk/jobs/companies/motorway/sales-completion-specialist-brighton-265768> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "b35cbce21e2e574164857f9050bb86ac614f4ca751468e2b79c0002911edc909" ;
