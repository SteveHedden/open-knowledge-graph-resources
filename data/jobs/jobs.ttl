    prov:wasDerivedFrom <https://jobicy.com/jobs/151263-senior-analytics-engineer-canada> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "f5b663786c2ca650aefa3a8d7e7e5d537a6296ffbcc50c41482a70c5a29677e3" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-21T01:38:07+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-08-22T01:26:48+00:00"^^xsd:dateTime ;
