        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-28T13:20:05+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-engineering-manager-berlin-243211/1>,
        <https://www.arbeitnow.com/jobs/companies/moonfare/engineering-manager-berlin-243211> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "2f5afbe75355175e5dbd06c50c884275932d01005ab271c6d146405293161761" ;
