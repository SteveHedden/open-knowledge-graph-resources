<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-it-solution-architect-schnittstelle-zwischen-business-applications-it-infrastruktur-dusseldorf-38202> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-20T20:33:44+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/karriereweg-gmbh/it-solution-architect-schnittstelle-zwischen-business-applications-it-infrastruktur-dusseldorf-38202> ;
    kgjobs:active true ;
