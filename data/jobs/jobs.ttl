    prov:generatedAtTime "2026-08-18T22:28:45+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/it-fabrik-systemhaus-gmbh-cokg/it-support-disponent-bitburg-185164> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "61c32324416b5936fbe6d94b9ce5d11eeba7b20bb4df7a8f8568456ed2d28980" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-18T20:14:54+00:00"^^xsd:dateTime ;
