            schema:name "London, UK" ] ;
    schema:title "Senior UI Engineer [6 Month FTC - Remote OR Onsite]" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/rocketsciencegg/senior-ui-engineer-6-month-ftc-remote-or-onsite-london-uk-458163> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-verfahrensingenieur-karlsruhe-394906> a prov:Entity,
