<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-director-global-field-partner-marketing-london-130708> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-20T10:35:46+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/deepl/director-global-field-partner-marketing-london-130708> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "7823f007e9c4f903a72b4b36e9613f74d52b3e309de3f3ad6636277c712d8d71" ;
