    schema:jobLocation <https://openknowledgegraphs.com/jobs/live/job/arbeitnow-medical-director-berlin-230551/location> ;
    schema:jobLocationType "ON_SITE" ;
    schema:title "Medical Director (m/w/x)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/doctorflix/medical-director-berlin-230551> .

