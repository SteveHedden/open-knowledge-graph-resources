<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/himalayas-2279c9c8dd242ac9> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/himalayas> ;
