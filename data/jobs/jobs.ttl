        <https://www.arbeitnow.co.uk/jobs/companies/9fin/senior-product-manager-data-apis-london-48581> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "34b81b8697bf9d3d9190df12d5caf4903b96ed427dfd3341e7e66852d7db03d2" ;
    kgjobs:classification "not_match" ;
