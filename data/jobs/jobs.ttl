    kgjobs:active true ;
    kgjobs:canonicalFingerprint "3264db41a06024ef0095904a5587d6592f0610f2f29707566cccce9379be51b5" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-20T08:43:54+00:00"^^xsd:dateTime ;
