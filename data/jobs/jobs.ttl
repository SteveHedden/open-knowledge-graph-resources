        <https://openknowledgegraphs.com/jobs/live/job/firstparty%3Afirst-party-amazon%3A10412466/evidence/4> ;
    kgjobs:lastSeenAt "2026-09-03T07:45:01+00:00"^^xsd:dateTime ;
