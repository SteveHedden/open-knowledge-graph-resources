            schema:name "Remote job" ] ;
    schema:jobLocationType "TELECOMMUTE" ;
    schema:title "Senior Product Engineer, IMS (all genders)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/distribusion-technologies/remote-senior-product-engineer-ims-all-genders-berlin-378345> .

