<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-werkstudent-hr-recruiting-frankfurt-am-main-486544> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-22T01:26:57+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/likegroup-gmbh/werkstudent-hr-recruiting-frankfurt-am-main-486544> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "0f3db69b4fa6702476fdf50bd7cb4a37a2f8fcb64489a4fabaef24b758f339ee" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-21T20:30:36+00:00"^^xsd:dateTime ;
