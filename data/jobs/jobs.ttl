    prov:generatedAtTime "2026-09-05T07:22:49+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://himalayas.app/companies/inovalon/jobs/clinical-informatics-ontology-lead>,
        <https://openknowledgegraphs.com/jobs/live/occurrence/himalayas-bffd2503f5dccce9/1> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "bffd2503f5dccce9981c07e9f45ce59a321e154a270ab9f45e782cd9fbf8cb7b" ;
    kgjobs:classification "qualified" ;
    kgjobs:firstSeenAt "2026-09-05T07:22:49+00:00"^^xsd:dateTime ;
