<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-full-stack-software-engineer-journey-berlin-103466> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-22T10:28:06+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/ecosia/full-stack-software-engineer-journey-berlin-103466> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "dfb76e113096a74b42638caf28939e42e8b64b2de9fa9295e659af2896d76b2b" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-21T18:42:27+00:00"^^xsd:dateTime ;
