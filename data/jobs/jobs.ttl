<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-commercial-planning-senior-associate-berlin-188392> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-25T22:33:23+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/sumup/commercial-planning-senior-associate-berlin-188392> ;
    kgjobs:active true ;
