    schema:jobLocation [ a schema:Place ;
            schema:name "Karlsruhe" ] ;
    schema:title "Senior Verfahrensingenieur (m/w/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/vulcan-energie-ressourcen-gmbh/senior-verfahrensingenieur-karlsruhe-394906> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-site-reliability-engineer-konstanz-berlin-oder-remote-75299> a prov:Entity,
