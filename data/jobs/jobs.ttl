    prov:generatedAtTime "2026-08-20T14:40:20+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/prime-hr-agentur/bilanzbuchhalter-steuerfachangestellter-fonds-immobilien-munchen-munich-146743> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "56aae7e56e2a6e93c329bedf5047682094a5ac3a1d5b7ce4fa313442e9ea5ff0" ;
