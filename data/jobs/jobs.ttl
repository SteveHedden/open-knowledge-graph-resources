<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-2nd-level-support-it-support-frankfurt-am-main-72675> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
