    prov:generatedAtTime "2026-08-26T04:45:30+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/k-tronik-gmbh/operational-qa-manager-for-application-software-development-munich-154736> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "938608ac5bb78fd55d808bcd61b0b7b8ac5b058557be3eab4b3d2e1a3469fb5f" ;
