    schema:identifier "arbeitnow-senior-consultant-digital-analytics-munchen-191278" ;
    schema:jobLocation [ a schema:Place ;
            schema:name "München" ] ;
    schema:title "Senior Consultant Digital Analytics (m/w/d), München" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/towa/senior-consultant-digital-analytics-munchen-191278> .

