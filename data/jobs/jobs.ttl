    prov:generatedAtTime "2026-08-20T14:40:20+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/sierra/recruiting-coordinator-europe-london-24976> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "22be20dee1b6b1ed1b42f53fa4c76976c5ab1602ae60726fdb384c07ac61159e" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-20T12:57:15+00:00"^^xsd:dateTime ;
