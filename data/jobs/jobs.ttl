    prov:generatedAtTime "2026-08-25T22:33:23+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/anaplan/principal-architect-ai-london-234460> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "eb55ff02479207b889d7aee4df9d3ffa5e9dc6329bafb1b23c73221a542d35ec" ;
