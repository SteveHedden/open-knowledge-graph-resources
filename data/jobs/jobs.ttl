    kgjobs:active true ;
    kgjobs:canonicalFingerprint "e95a5b05ce4318b1b061bd17b981ea90ccfda6a80cfb16dc064a066f60405c28" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-05T07:22:49+00:00"^^xsd:dateTime ;
