<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-remote-privacy-engineering-director-27450> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-01T08:16:34+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-remote-privacy-engineering-director-27450/1>,
        <https://www.arbeitnow.com/jobs/companies/duck-duck-go/remote-privacy-engineering-director-27450> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "f99fb836a3db051fab62190050ee3e97b85f564f5719c1a0da3a9df389a6ad69" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-01T04:57:44+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-09-01T08:16:34+00:00"^^xsd:dateTime ;
