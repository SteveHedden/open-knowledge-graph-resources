    kgjobs:active true ;
    kgjobs:canonicalFingerprint "31f7ac03e7bc20939011db68d9e9b49ee2b2359f4e0b65696171f7511f0bbfc1" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-20T12:57:15+00:00"^^xsd:dateTime ;
