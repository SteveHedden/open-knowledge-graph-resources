<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-devops-engineer-aws-kubernetes-junior-intermediate-berlin-387611> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-25T22:33:23+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/new-monday-gmbh/devops-engineer-aws-kubernetes-junior-intermediate-berlin-387611> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "0bd7afc8615ea5e5c92bcd2235ec20685578e1e632bf1c1bfbad21a74ef2a34a" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-25T18:45:43+00:00"^^xsd:dateTime ;
