            schema:name "Canada" ] ;
    schema:jobLocationType "TELECOMMUTE" ;
    schema:title "Senior Analytics Engineer - CANADA" ;
    schema:url <https://jobicy.com/jobs/151263-senior-analytics-engineer-canada> .

