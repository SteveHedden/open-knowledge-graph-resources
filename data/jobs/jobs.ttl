<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-remote-forward-deployed-engineer-emea-63325> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-20T20:33:44+00:00"^^xsd:dateTime ;
