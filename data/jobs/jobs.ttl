            schema:name "Berlin" ] ;
    schema:title "(Junior) Research Consultant im Bereich Marktforschung (w|m|d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/civey-gmbh/junior-research-consultant-im-bereich-marktforschung-wmd-berlin-39323> .

