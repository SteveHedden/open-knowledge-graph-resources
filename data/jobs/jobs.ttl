<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-strategic-account-executive-211793> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-strategic-account-executive-211793/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/twilio/strategic-account-executive-211793> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "6eb2fa6e21d61dc00003d21c3524fb46f4367b8c6ef9eeeec883760191e4935b" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
