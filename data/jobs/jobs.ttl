    schema:jobLocation [ a schema:Place ;
            schema:name "Sydney, Australia" ] ;
    schema:title "Solutions Sales Director - (Entity & Subsidiary Management)" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/diligentcorporation/solutions-sales-director-entity-subsidiary-management-sydney-australia-313276> .

