<https://openknowledgegraphs.com/jobs/live/job/firstparty%3Afirst-party-embl-ebi%3AJR4207> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/first-party-embl-ebi> ;
    prov:generatedAtTime "2026-08-28T13:20:05+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://embl.wd103.myworkdayjobs.com/EMBL/job/Hinxton-Cambridgeshire/BioImaging-Bioinformatician_JR4207-1>,
        <https://openknowledgegraphs.com/jobs/live/occurrence/firstparty%3Afirst-party-embl-ebi%3AJR4207/1> ;
    kgjobs:active true ;
