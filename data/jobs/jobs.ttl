<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-product-growth-manager-media-analytics-analytics-consulting-berlin-bevorzugt-75-100-184023> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-25T10:39:01+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/argus-data-insights/product-growth-manager-media-analytics-analytics-consulting-berlin-bevorzugt-75-100-184023> ;
