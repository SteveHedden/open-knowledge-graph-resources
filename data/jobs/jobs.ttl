    schema:title "Werkstudentin im Bereich Influencer Marketing (m/w/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/gusti-leder-gmbh/werkstudentin-im-bereich-influencer-marketing-rostock-499557> .

