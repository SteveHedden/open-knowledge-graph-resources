<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-senior-integrated-campaign-manager-405392> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-03T07:45:01+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-integrated-campaign-manager-405392/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/feedzai/senior-integrated-campaign-manager-405392> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "c23cdab3c109475265e9458daec6b7adcf5ad5be921ee31d7d6fde516a7d053d" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-03T07:45:01+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-09-03T07:45:01+00:00"^^xsd:dateTime ;
    kgjobs:reconciliationReason "no reviewed first-party candidate" ;
    kgjobs:sourceOccurrence <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-integrated-campaign-manager-405392/1> ;
    kgjobs:sourceRecordId "senior-integrated-campaign-manager-405392" ;
    schema:datePosted "2026-09-02"^^xsd:date ;
    schema:description "<div class=\"content-intro\"><p>At Feedzai, we're building a world of safer money. A world where financial institutions move faster than criminals. Where the payments that fund real lives through salaries, savings, and businesses are protected in real time. We use trusted AI to detect and prevent financial crime, fraud, and money laundering at scale: the world's top banks, payment networks, and acquirers trust our technology to safeguard more than one billion consumers and $9 trillion in payment volume every year.&nbsp;</p> <p>Feedzai is a Series D company and has raised $282M to date. With a valuation of $2 billion, our technology protects 1 billion consumers and 90 billion transactions each year.</p></div><p style=\"text-align: justify;\"><span style=\"font-size: 12pt;\"><strong>The Marketing Team</strong> is empowered to spark change daily with MAP - Mastery in their role, Autonomy to make decisions, and a Purpose to make the world a safer place for all consumers. Using cutting-edge tech and delivering best-in-class content, they influence the trajectory of our company. It’s this team spirit and trust in each other that let us go further together. This team has two simple goals: 1. Everyone in the world knows about the Feedzai brand 2. Making sure our sales team is busy. Join Us!</span></p> <p style=\"text-align: justify;\"><span style=\"font-size: 12pt;\">We’re looking for a strategic, data‑driven <strong>Campaign Manager</strong> to architect, lead, and orchestrate Feedzai’s largest global marketing campaigns. Feedzai’s campaigns are the connective tissue between brand, product, and growth.&nbsp; As Campaign Manager, you’ll turn business priorities into clear campaign strategies, align cross-functional teams around the plan, and drive the programs that build awareness, generate demand and accelerate pipeline.</span></p> <p style=\"text-align: justify;\"><span style=\"font-size: 12pt;\"><strong>You:&nbsp;</strong></span></p> <p style=\"text-align: justify;\"><span style=\"font-size: 12pt;\">You’re a strategic full-funnel marketer who knows how to turn business priorities into clear, measurable campaign strategies. You thrive in complex, fast-moving environments, bringing structure to ambiguity and momentum to cross-functional teams. You’re a natural orchestrator who can build alignment, drive accountability and confidently communicate with senior stakeholders. You stay close to performance, know how to spot what isn’t working, and bring the right teams together to fix it.</span></p> <h3 style=\"text-align: justify;\"><span style=\"font-size: 12pt;\"><strong>Your Day to Day:</strong></span></h3> <p>&nbsp;</p> <ul style=\"text-align: justify;\"> <li style=\"font-size: 12pt;\"><span style=\"font-size: 12pt;\">Design and lead multi-channel, full-funnel campaigns tied to Feedzai’s strategic GTM motions and growth priorities.</span></li> <li style=\"font-size: 12pt;\"><span style=\"font-size: 12pt;\">Translate business priorities into clear campaign goals, audiences, messaging, buyer journeys, routes to market and success metrics.</span></li> <li style=\"font-size: 12pt;\"><span style=\"font-size: 12pt;\">Orchestrate teams across Product Marketing, Digital, Content, Comms, Creative, Regional Marketing, Partner Marketing, ADRs and Sales to deliver against one integrated campaign strategy.</span></li> <li style=\"font-size: 12pt;\"><span style=\"font-size: 12pt;\">Identify critical gaps in audience, market intelligence, positioning, product readiness or sales follow-up and work with the right stakeholders to resolve them.</span></li> <li style=\"font-size: 12pt;\"><span style=\"font-size: 12pt;\">Partner with Product Marketing to translate positioning, buyer insights and product priorities into differentiated full-funnel messaging.</span></li> <li style=\"font-size: 12pt;\"><span style=\"font-size: 12pt;\">Stay close to campaign, lead and pipeline performance, working with Digital, ADRs and Sales to quickly identify issues and optimize messaging, targeting, channels and follow-up.</span></li> <li style=\"font-size: 12pt;\"><span style=\"font-size: 12pt;\">Build campaign enablement that gives Sales and ADR teams the messaging, content and outreach guidance needed to convert engagement and accelerate pipeline.</span></li> <li style=\"font-size: 12pt;\"><span style=\"font-size: 12pt;\">Lead campaign reviews, clearly communicating performance, learnings, risks, recommendations and next steps.</span></li> <li style=\"font-size: 12pt;\"><span style=\"font-size: 12pt;\">Manage multiple complex campaigns at once, bringing structure, accountability and momentum in a fast-moving environment.</span></li> </ul> <h3 style=\"text-align: justify;\"><span style=\"font-size: 12pt;\"><strong>You Have &amp; You Know‑How:</strong></span></h3> <p>&nbsp;</p> <ul> <li style=\"font-size: 12pt; text-align: justify;\"><span style=\"font-size: 12pt;\">8–10+ years of B2B marketing experience, with significant experience leading integrated or demand generation campaigns in SaaS, fintech or enterprise technology.</span></li> <li style=\"font-size: 12pt; text-align: justify;\"><span style=\"font-size: 12pt;\">Proven ability to translate business priorities into clear, measurable full-funnel campaign strategies that drive pipeline and revenue impact.</span></li> <li style=\"font-size: 12pt; text-align: justify;\"><span style=\"font-size: 12pt;\">Deep understanding of B2B marketing fundamentals, including audience segmentation, ICPs, positioning, buyer journeys, demand generation and pipeline acceleration.</span></li> <li style=\"font-size: 12pt; text-align: justify;\"><span style=\"font-size: 12pt;\">Exceptional cross-functional leadership and stakeholder management skills, with the ability to build alignment and drive execution across teams you do not directly manage.</span></li> <li style=\"font-size: 12pt; text-align: justify;\"><span style=\"font-size: 12pt;\">Strong project and program management skills, with the ability to juggle multiple complex initiatives, teams and deadlines.</span></li> <li style=\"font-size: 12pt; text-align: justify;\"><span style=\"font-size: 12pt;\">Strong executive presence and communication skills, with the confidence to clearly articulate strategy, recommendations and performance to senior leaders.</span></li> <li style=\"font-size: 12pt; text-align: justify;\"><span style=\"font-size: 12pt;\">A data-driven mindset, comfortable analyzing campaign and pipeline performance and translating insights into action.</span></li> <li style=\"font-size: 12pt; text-align: justify;\"><span style=\"font-size: 12pt;\">Strong marketing judgment, with the ability to identify missing inputs, ask the right questions and keep work moving forward.</span></li> <li style=\"font-size: 12pt; text-align: justify;\"><span style=\"font-size: 12pt;\">A self-starter with a bias for action who thrives in high-pressure environments where priorities can change and complete information may not always be available.</span></li> <li style=\"font-size: 12pt; text-align: justify;\"><span style=\"font-size: 12pt;\">Experience in B2B SaaS, fintech, fraud, financial crime, payments, banking technology or enterprise financial services strongly preferred.</span><br><br></li> </ul><div class=\"content-conclusion\"><hr> <p style=\"text-align: justify;\"><strong>Your First 30-Days at Feedzai:</strong></p> <p style=\"text-align: justify;\">You will be immersed in our brand with training, connections, and one-on-one time with your manager. You may shadow your colleagues virtually or onsite at an office depending on where you work as you are supported through your Feedzai journey. In addition, you will have access to a ton of information to give you history, context, and all the knowledge you can handle about Feedzai and the team. Finally, you will start working on projects and collaborating on work currently being done. We can't wait to have you join the team!</p> <p style=\"text-align: justify;\"><span style=\"text-decoration: underline;\"><a href=\"https://www.instagram.com/life_at_feedzai/\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?q=https://www.instagram.com/life_at_feedzai/&amp;source=gmail&amp;ust=1635949966547000&amp;usg=AFQjCNHqHScsMVn3wllbJJnpPhg2Hkc3Tw\">Life at Feedzai Instagram</a></span></p> <p style=\"text-align: justify;\"><a href=\"https://careers.feedzai.com/mirabud/2023/10/Codebook.pdf\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?q=https://careers.feedzai.com/culture/&amp;source=gmail&amp;ust=1635949966547000&amp;usg=AFQjCNFnGtghGY5hZWWMQMKWJtCGlcQ-EA\"><span style=\"text-decoration: underline;\">Feedzai Culture</span></a></p> <hr> <p style=\"text-align: justify;\"><strong>Feedzai is an Equal Opportunity Employer and we value diversity at our company. We do not discriminate on the basis of race, religion, color, national origin, gender, sexual orientation, age, marital status, veteran status, or disability status.</strong></p> <p style=\"text-align: justify;\"><strong>Feedzai does not accept unsolicited resumes from recruiters or employment agencies.&nbsp;</strong></p> <p><strong>Feedzai will use the personal data you provide us with by filling out this form for reviewing your application and to potentially negotiate a contract with you. Your personal data will be retained by Feedzai for 24 months following your application. Please see our Privacy Notice available at https://www.feedzai.com/legal/feedzai-candidate-privacy-policy/ and https://www.feedzai.com/legal/feedzai-california-candidates-privacy-policy/ for more information on how we process your personal data.</strong></p> <p style=\"text-align: justify;\"><strong>&nbsp;</strong></p> <div style=\"text-align: justify;\">&nbsp;</div></div> Find more English Speaking Jobs in United Kingdom on Arbeitnow" ;
    schema:hiringOrganization kgjd:employer-feedzai ;
    schema:identifier "arbeitnow-senior-integrated-campaign-manager-405392" ;
    schema:jobLocationType "ON_SITE" ;
    schema:title "Senior Integrated Campaign Manager" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/feedzai/senior-integrated-campaign-manager-405392> .

