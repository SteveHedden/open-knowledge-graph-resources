    schema:jobLocationType "ON_SITE" ;
    schema:title "Information Security Manager (gn)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/i-doit-gmbh/information-security-manager-gn-dusseldorf-460368> .

