<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-revenue-operations-manager-manchester-331161> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-25T10:39:01+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/street-group/revenue-operations-manager-manchester-331161> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "3259393621c4d5c05fc12a5c9daa98cddbd1ab263a14a1f480c6e8d8d5909447" ;
    kgjobs:classification "not_match" ;
