<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-senior-software-engineer-stream-processing-berlin-425547> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-software-engineer-stream-processing-berlin-425547/1>,
        <https://www.arbeitnow.com/jobs/companies/nebius/senior-software-engineer-stream-processing-berlin-425547> ;
