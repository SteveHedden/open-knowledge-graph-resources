<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-fullstack-engineer-merchant-emea-berlin-399199> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-20T10:35:46+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/wolt-english/fullstack-engineer-merchant-emea-berlin-399199> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "78d8004c4c917868568f539de8bcb3c73ee984f7718dfc84ca513ac90a8e2ffc" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-19T22:29:16+00:00"^^xsd:dateTime ;
