    prov:generatedAtTime "2026-08-28T01:26:42+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-graphene-photonics-data-analyst-aachen-68709/1>,
        <https://www.arbeitnow.com/jobs/companies/black-semiconductor-gmbh/graphene-photonics-data-analyst-aachen-68709> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "9a4eccf3750b10b56c3d0eace8ea8ba08bd9caf862d00c1c5f29ce11f7890879" ;
