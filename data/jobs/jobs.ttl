    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-20T14:40:20+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/encondi-gmbh/werstudent-praktikant-online-marketing-social-media-haar-90542> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "738eedd72d86a231b4ad968c0f741417def042cff94194445b41886393cebb8f" ;
