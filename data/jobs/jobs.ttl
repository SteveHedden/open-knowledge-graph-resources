            schema:name "Berlin" ] ;
    schema:title "Associate Supply Chain (w/m/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/enpal/associate-supply-chain-berlin-203366> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-av-implementation-director-london-120111> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-20T20:33:44+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/wppmedia/av-implementation-director-london-120111> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "8817c9a4ce09f80b666ba47c067e09b06352a1658716c93017e95f76ffc5ac11" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-20T14:40:20+00:00"^^xsd:dateTime ;
