<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-founding-solutions-architect-berlin-213659> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-founding-solutions-architect-berlin-213659/1>,
        <https://www.arbeitnow.com/jobs/companies/zelaraai/founding-solutions-architect-berlin-213659> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "7f911b93dcfc799eb6bc188ca37b116b241acd8a674e07648826d3ff3d1adca4" ;
    kgjobs:classification "not_match" ;
