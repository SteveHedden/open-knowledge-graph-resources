    kgjobs:canonicalFingerprint "6434eaeb6c95f15acf5df96bcb61ec33f64a92a2aba163888212aea01e4aee82" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
