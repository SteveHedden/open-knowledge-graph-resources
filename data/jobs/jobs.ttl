            schema:name "Berlin, Berlin" ] ;
    schema:title "Werkstudent Projektmanagement & Sales Prozesse (x/f/m)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/doctolib/werkstudent-projektmanagement-sales-prozesse-berlin-berlin-220938> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-werkstudent-sales-koln-168146> a prov:Entity,
