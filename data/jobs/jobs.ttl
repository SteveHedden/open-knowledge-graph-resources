    prov:generatedAtTime "2026-09-02T07:36:12+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-werkstudentin-sales-operations-koln-391467/1>,
        <https://www.arbeitnow.com/jobs/companies/1komma5grad/werkstudentin-sales-operations-koln-391467> ;
