<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-remote-senior-software-engineer-ii-222936> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-21T10:34:54+00:00"^^xsd:dateTime ;
