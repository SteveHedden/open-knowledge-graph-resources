<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-staff-product-manager-berlin-252423> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-19T12:55:46+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/sumup/staff-product-manager-berlin-252423> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "e0cae4d8197f413f945a8f4396c8aca1fc185b549ef30f49f8ea85692d219b13" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-19T12:55:46+00:00"^^xsd:dateTime ;
