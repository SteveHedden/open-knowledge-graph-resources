    kgjobs:active true ;
    kgjobs:canonicalFingerprint "555276fcb912d68c85a9bb0ee9b287a7ce8568cb8140957cfc4625558de01c33" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
