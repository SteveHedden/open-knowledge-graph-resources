<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-applied-ai-engineer-95400> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-22T01:26:57+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/forter/senior-applied-ai-engineer-95400> ;
