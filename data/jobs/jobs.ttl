            schema:name "London" ] ;
    schema:title "Senior Insight Manager" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/globalwebindex/senior-insight-manager-london-51660> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-integrated-campaign-manager-london-261574> a prov:Entity,
