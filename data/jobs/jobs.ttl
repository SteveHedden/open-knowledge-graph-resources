    prov:generatedAtTime "2026-08-20T10:35:46+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/heidi/senior-software-engineer-rpa-london-293808> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "3e59b7f8b5a8a4c715ae618abb6b9347543f64960c7ca0964f0195dc37f21c0d" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-20T01:27:27+00:00"^^xsd:dateTime ;
