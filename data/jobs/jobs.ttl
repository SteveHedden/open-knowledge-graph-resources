    kgjobs:canonicalFingerprint "2a559811cdf0c714cd164820596315ead6253aafed40a1d02e1cbe601e2020ad" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-25T16:34:13+00:00"^^xsd:dateTime ;
