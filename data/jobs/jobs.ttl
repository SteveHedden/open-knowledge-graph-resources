<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-account-director-maritime-sydney-australia-275730> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-19T12:55:46+00:00"^^xsd:dateTime ;
