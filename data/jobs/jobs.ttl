            schema:name "Berlin" ] ;
    schema:title "B2B Marketing Spezialist:in (m/w/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/logenai/b2b-marketing-spezialistin-berlin-373817> .

