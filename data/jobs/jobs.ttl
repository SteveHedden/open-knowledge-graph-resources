    prov:generatedAtTime "2026-08-26T04:45:30+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/epicgames/machine-learning-engineer-memory-london-242100> ;
