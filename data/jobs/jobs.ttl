            schema:name "Gilching, Bayern, Germany" ] ;
    schema:title "Category Manager –Software, AI & Digital Platforms (m/f/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/quantum-systems-gmbh/category-manager-software-ai-digital-platforms-gilching-37786> .

