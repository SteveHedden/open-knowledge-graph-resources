    kgjobs:sourceRecordId "https://himalayas.app/companies/samsara/jobs/senior-marketing-analytics-manager-bi-data-architecture-1626050338" ;
    schema:applicantLocationRequirements <https://openknowledgegraphs.com/jobs/live/job/himalayas-4d8f73aeb5eaa638/applicant-location/1> ;
