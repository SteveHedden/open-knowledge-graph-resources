    schema:jobLocation <https://openknowledgegraphs.com/jobs/live/job/arbeitnow-senior-programmatic-manager-mensch-dusseldorf-66528/location> ;
    schema:title "Senior Programmatic Manager (Mensch)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/wppmedia/senior-programmatic-manager-mensch-dusseldorf-66528> .

