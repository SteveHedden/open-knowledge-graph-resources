<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-editorial-specialist-london-417906> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-18T22:28:45+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/legora/editorial-specialist-london-417906> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "8333e5a5e556765f8803e34f6335de92e6d9f75089f8fc62f1de2a8248edcb12" ;
