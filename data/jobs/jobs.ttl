    schema:jobLocation <https://openknowledgegraphs.com/jobs/live/job/arbeitnow-co-founder-in-performance-marketing-fur-supplement-brand-gescuht-cologne-486343/location> ;
    schema:title "Co-Founder/in Performance Marketing für Supplement Brand (m/w/d)gescuht" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/advertical/co-founder-in-performance-marketing-fur-supplement-brand-gescuht-cologne-486343> .

