<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-sap-integration-architect-329226> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-02T07:36:12+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-sap-integration-architect-329226/1>,
        <https://www.arbeitnow.com/jobs/companies/parloa/sap-integration-architect-329226> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "5e1ecf5202297350751305999601db1c6634764435fbaffab0c74ee11daeb060" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-02T07:36:12+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-09-02T07:36:12+00:00"^^xsd:dateTime ;
