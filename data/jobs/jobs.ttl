    kgjobs:active true ;
    kgjobs:canonicalFingerprint "e0dbd1980a27853617d46f0cacb74d4092ef9afd40711bbbeffa0ba921e208c0" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-18T20:14:54+00:00"^^xsd:dateTime ;
