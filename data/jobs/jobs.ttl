    kgjobs:canonicalFingerprint "bc7355cfc27ccb3cc00e0eb31896d84a729a39e76e79bebc0fb05fa59ae7341a" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-25T20:35:11+00:00"^^xsd:dateTime ;
