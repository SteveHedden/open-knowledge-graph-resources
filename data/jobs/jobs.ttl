    schema:jobLocationType "ON_SITE" ;
    schema:title "Account Executive - B2B Marketing Solutions (Full Cycle)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/scholarshipowl/account-executive-b2b-marketing-solutions-full-cycle-berlin-70468> .

