    prov:generatedAtTime "2026-09-02T07:36:12+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-account-executive-enterprise-375583/1>,
        <https://www.arbeitnow.com/jobs/companies/zscaler/account-executive-enterprise-375583> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "b1f52ea7af57520c1d9fca3d923477fdfbb4177ea1cdd34f446eb1d003f2e524" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-02T07:36:12+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-09-02T07:36:12+00:00"^^xsd:dateTime ;
