    kgjobs:canonicalFingerprint "087df2a7a87c5c88c4349149637c743caa7be417e9dc64aee8695a251ae7d487" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-02T07:36:12+00:00"^^xsd:dateTime ;
