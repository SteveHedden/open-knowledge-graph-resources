    kgjobs:active true ;
    kgjobs:canonicalFingerprint "83a16d4925cc3a518ceba757ed9dd400b642bd011772960f00ca1e9a322084cc" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-18T20:14:54+00:00"^^xsd:dateTime ;
