<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-sr-software-engineer-ads-auctions-marketplace-optimization-cambridge-142348> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-29T09:42:00+00:00"^^xsd:dateTime ;
