<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-lifecycle-marketing-manager-london-252371> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-20T14:40:20+00:00"^^xsd:dateTime ;
