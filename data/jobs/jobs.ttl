    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-product-manager-trust-safety-integrity-and-fraud-london-72043/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/deliveroo/senior-product-manager-trust-safety-integrity-and-fraud-london-72043> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "04451f3b79fc4268efdee94bf93fcf8bc89603cdbcb7884986c450a2ac7da410" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
