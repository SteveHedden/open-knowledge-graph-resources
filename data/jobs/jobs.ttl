    kgjobs:active true ;
    kgjobs:canonicalFingerprint "9ff259096f86b2299b4cb50c4e5f7d8a8bac7918fb997d68dac197d53cd93493" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-05T07:22:49+00:00"^^xsd:dateTime ;
