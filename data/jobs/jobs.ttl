<https://openknowledgegraphs.com/jobs/live/job/jobicy-152276> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/jobicy> ;
    prov:generatedAtTime "2026-09-01T08:16:34+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://jobicy.com/jobs/152276-aws-devops-engineer-associate>,
        <https://openknowledgegraphs.com/jobs/live/occurrence/jobicy-152276/1> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "18b845043b4395840646072a845a435c5acaccb58920f275a503bb73b8c8c709" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-01T08:16:34+00:00"^^xsd:dateTime ;
