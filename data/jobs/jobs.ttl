<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-account-executive-enterprise-fluent-in-german-located-in-germany-berlin-303389> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-18T22:28:45+00:00"^^xsd:dateTime ;
