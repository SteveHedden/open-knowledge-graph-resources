    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-partner-manager-si-dach-berlin-456774/1>,
        <https://www.arbeitnow.com/jobs/companies/n8n/senior-partner-manager-si-dach-berlin-456774> ;
