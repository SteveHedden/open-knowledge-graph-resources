<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-remote-software-engineer-backend-core-api-process-automation-492538> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
