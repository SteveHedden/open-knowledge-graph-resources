            schema:name "München" ] ;
    schema:title "Head of Engineering (m/f/x) @ E-Mobility Startup" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/aampere/head-of-engineering-at-e-mobility-startup-munchen-436987> .

