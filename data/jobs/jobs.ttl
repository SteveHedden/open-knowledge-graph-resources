    schema:jobLocation [ a schema:Place ;
            schema:name "Berlin" ] ;
    schema:title "Senior Data Scientist, Workforce Management Analytics" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/wolt/senior-data-scientist-workforce-management-analytics-berlin-311902> .

