<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-business-development-london-222065> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
