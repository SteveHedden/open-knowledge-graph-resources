    prov:generatedAtTime "2026-09-01T08:16:34+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-customer-success-manager-london-438867/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/commercetools/senior-customer-success-manager-london-438867> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "ada4ffd3f5c1eb304cbe0d380335c13d8f150153d6324a9bc9ff7e9946d90cc2" ;
    kgjobs:classification "not_match" ;
