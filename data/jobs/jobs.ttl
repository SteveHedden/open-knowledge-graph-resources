            schema:name "London" ] ;
    schema:title "Account Executive - SMB" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/connecteam/account-executive-smb-london-333786> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-account-executive-startups-london-196462> a prov:Entity,
