    prov:generatedAtTime "2026-08-25T10:39:01+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/liotec-gmbh/mobile-developer-ui-ux-product-designer-berlin-348396> ;
    kgjobs:active true ;
