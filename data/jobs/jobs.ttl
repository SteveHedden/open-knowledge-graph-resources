            schema:name "United States" ] ;
    schema:jobLocationType "TELECOMMUTE" ;
    schema:title "Enterprise Context Architect" ;
    schema:url <https://himalayas.app/companies/dropbox/jobs/enterprise-context-architect> ;
    schema:validThrough "2026-10-06"^^xsd:date .

