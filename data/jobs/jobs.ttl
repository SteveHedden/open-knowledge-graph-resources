<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-vice-president-client-analytics-mensch-dusseldorf-frankfurt-hamburg-munich-78822> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-vice-president-client-analytics-mensch-dusseldorf-frankfurt-hamburg-munich-78822/1>,
        <https://www.arbeitnow.com/jobs/companies/wppmedia/vice-president-client-analytics-mensch-dusseldorf-frankfurt-hamburg-munich-78822> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "43b8cab4c2036d7b6a8b7909f671754cb23467bea7bef4541e21b1584a14275c" ;
    kgjobs:classification "not_match" ;
