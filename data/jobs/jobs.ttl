<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-remote-product-engineer-26924> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-20T10:35:46+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/0g/remote-product-engineer-26924> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "09ab1b18a4dfd54332b86bc7d8c9e390414dfb214fad71ccfbb7fdfcd894b02a" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-19T20:33:53+00:00"^^xsd:dateTime ;
