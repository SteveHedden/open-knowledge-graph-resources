<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-digital-sharks-performance-data-associate-marketplace-intelligence-early-careers-london-300833> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-19T22:29:16+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/sharkninjaoperatingllc/digital-sharks-performance-data-associate-marketplace-intelligence-early-careers-london-300833> ;
