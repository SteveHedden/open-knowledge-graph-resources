    prov:generatedAtTime "2026-09-05T07:22:49+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-controller-finance-business-partner-hamburg-17256/1>,
        <https://www.arbeitnow.com/jobs/companies/pammys-dieseo-gmbh/senior-controller-finance-business-partner-hamburg-17256> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "c4c76ad03d281ad975f5c1aab9e4511c544feac333b88e82c916478c0fcec131" ;
