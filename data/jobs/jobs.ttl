<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-enterprise-account-executive-dach-496962> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-19T04:41:07+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/chainguard/enterprise-account-executive-dach-496962> ;
