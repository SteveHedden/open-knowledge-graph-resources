<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-paid-media-manager-6-month-ftc-uk-based-234827> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-22T10:28:06+00:00"^^xsd:dateTime ;
