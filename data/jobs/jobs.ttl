    schema:jobLocation [ a schema:Place ;
            schema:name "Manchester - Main Office" ] ;
    schema:title "Operations Manager - New Partner Experience" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/deliveroo/operations-manager-new-partner-experience-manchester-334612> .

