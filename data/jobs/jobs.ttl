    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-05T07:22:49+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-remote-ai-solution-architect-nurnberg-mittelfranken-423450/1>,
        <https://www.arbeitnow.com/jobs/companies/virtual7-gmbh/remote-ai-solution-architect-nurnberg-mittelfranken-423450> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "fff14c17d0861c88a835cdab30501a83e39ccda74740e15d8d2471796f2743f6" ;
    kgjobs:classification "not_match" ;
