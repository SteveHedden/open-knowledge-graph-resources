            schema:name "Germany" ] ;
    schema:title "Senior Product Manager - User and Lifecycle Analytics" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/contentsquare/senior-product-manager-user-and-lifecycle-analytics-germany-372508> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-product-owner-berlin-89787> a prov:Entity,
