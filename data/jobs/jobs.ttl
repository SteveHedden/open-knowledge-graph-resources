    schema:hiringOrganization kgjd:employer-paddle ;
    schema:identifier "arbeitnow-senior-product-marketing-manager-uk-288452" ;
    schema:jobLocation [ a schema:Place ;
            schema:name "UK" ] ;
    schema:title "Senior Product Marketing Manager" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/paddle/senior-product-marketing-manager-uk-288452> .

