    schema:title "(Senior) Sales Manager (m/w/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/ryze-digital/senior-sales-manager-ryze-digital-holding-gmbh-mainz-412372> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-sales-manager-uk-london-16969> a prov:Entity,
