    kgjobs:canonicalFingerprint "6ca881bc668e0684363dfe0b441e117d1b6719ed62fb45c96473acef2ca49103" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-29T09:42:00+00:00"^^xsd:dateTime ;
