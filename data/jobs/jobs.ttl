            schema:name "Munich" ] ;
    schema:title "Marketing Lead: Content, GTM & Events | B2B SaaS" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/soley-gmbh/marketing-lead-content-gtm-events-b2b-saas-munich-475085> .

