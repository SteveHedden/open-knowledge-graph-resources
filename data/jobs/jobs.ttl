<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-crm-strategy-manager-reactivations-all-genders-berlin-berlin-12467> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
