            schema:name "Freiburg im Breisgau" ] ;
    schema:title "Werkstudent:in im Bereich Klimaanpassung" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/greenventory-gmbh/werkstudentin-im-bereich-klimaanpassung-freiburg-im-breisgau-383947> .

