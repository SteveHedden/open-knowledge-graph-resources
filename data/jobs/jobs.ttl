            schema:name "London" ] ;
    schema:title "Senior Technical Architect (Privacy)" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/onetrust/senior-technical-architect-privacy-london-413823> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-technical-support-specialist-uk-london-26096> a prov:Entity,
