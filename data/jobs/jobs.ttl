    kgjobs:canonicalFingerprint "02a83d5814f012879f067f90616b70c67d651185f59db83101bae931604abcd7" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
