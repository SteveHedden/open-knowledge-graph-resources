<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-technical-architect-privacy-london-413823> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-22T01:26:57+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/onetrust/senior-technical-architect-privacy-london-413823> ;
