    schema:jobLocationType "ON_SITE" ;
    schema:title "Product Owner - Communications Channels & AI" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/phmg-careers/product-owner-communications-channels-ai-manchester-177736> .

