<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-senior-programmatic-manager-mensch-dusseldorf-66528> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-29T09:42:00+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-programmatic-manager-mensch-dusseldorf-66528/1>,
        <https://www.arbeitnow.com/jobs/companies/wppmedia/senior-programmatic-manager-mensch-dusseldorf-66528> ;
