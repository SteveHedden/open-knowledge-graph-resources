        <https://www.arbeitnow.co.uk/jobs/companies/fundingcircle/marketing-technology-manager-london-246541> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "249bef6d02ae09fccd8a41cf69efe5ecc21d47a666967417ecb9f69679f89bdd" ;
    kgjobs:classification "not_match" ;
