    prov:generatedAtTime "2026-08-22T10:28:06+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/lionflence/junior-artist-manager-influencer-manager-berlin-38615> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "4cf886f182254a37a1c5a59b4ed3ba57ae2f6e659f52f52c2cd1325ec27a6ab2" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-22T10:28:06+00:00"^^xsd:dateTime ;
