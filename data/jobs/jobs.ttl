    kgjobs:canonicalFingerprint "52b23c296b5016212fd75a4862d261de797e7f51c25612e21c592fd548a272ae" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-20T16:39:44+00:00"^^xsd:dateTime ;
