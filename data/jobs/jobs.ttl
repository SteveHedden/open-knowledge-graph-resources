    prov:generatedAtTime "2026-08-22T01:26:57+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/vanta/solutions-engineer-upmarket-pre-sales-emea-london-225786> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "99c5a868e80aa28164d3525c9ff11abff0e6f3820f00174d62601418200f2c01" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-21T08:46:28+00:00"^^xsd:dateTime ;
