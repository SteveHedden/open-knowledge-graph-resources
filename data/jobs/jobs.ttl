<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-legal-werkstudent-deutschland-berlin-200427> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-18T22:28:45+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/qonto/legal-werkstudent-deutschland-berlin-200427> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "fadffc0411d29120a37a28f4bb4036efc2b4f5b3469620d7fd63fbde767f9847" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-18T22:28:45+00:00"^^xsd:dateTime ;
