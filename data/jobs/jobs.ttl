    schema:jobLocationType "ON_SITE" ;
    schema:title "Steuerberater (m/w/d) in Calau, auf Wunsch mit Partnerperspektive, gesucht - mindestens 90.000€" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/taxtalentede/steuerberater-in-calau-auf-wunsch-mit-partnerperspektive-gesucht-mindestens-90000eur-158719> .

