    kgjobs:active true ;
    kgjobs:canonicalFingerprint "f419b989d0c03d2c7bdf59a147a74ab7bfa33205ba34a2a577e9c56da949f19b" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-21T01:38:22+00:00"^^xsd:dateTime ;
