    kgjobs:canonicalFingerprint "0ca308562c4ff1f71c10609467fc50ed259fa34e280ae347c9508d61b88fe32c" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-20T04:42:08+00:00"^^xsd:dateTime ;
