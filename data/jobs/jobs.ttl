    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-05T07:22:49+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-software-engineer-stream-processing-28133/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/nebius/senior-software-engineer-stream-processing-28133> ;
