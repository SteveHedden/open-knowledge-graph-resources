            schema:name "Köln, Lichtstraße 43c" ] ;
    schema:title "(Junior) Art Director (w/m/d) – Kreation" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/hirschen-group-gmbh/junior-art-director-kreation-koln-lichtstrasse-43c-463952> .

