<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/jobicy-151580> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/jobicy> ;
    prov:generatedAtTime "2026-08-25T22:31:53+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://jobicy.com/jobs/151580-customer-success-manager-ii-2> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "33525c78a8ebe66e8d02f810f784cac822e26a901a47b4339d1ecc31d9e7ec7e" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-25T17:35:13+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-08-25T22:31:53+00:00"^^xsd:dateTime ;
