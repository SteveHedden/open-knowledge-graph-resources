<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-robotics-perception-engineer-multi-object-tracking-munich-deu-5898> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-23T18:36:11+00:00"^^xsd:dateTime ;
