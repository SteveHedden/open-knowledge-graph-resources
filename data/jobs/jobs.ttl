    prov:generatedAtTime "2026-08-25T04:44:23+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/omnea/performance-marketing-lead-london-111667> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "181134f5956e6d9db3dd6dbabada1b90c44ab9d25ffc54f910dad561bf8fe712" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-25T03:04:02+00:00"^^xsd:dateTime ;
