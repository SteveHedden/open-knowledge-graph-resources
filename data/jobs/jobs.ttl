    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-25T10:39:01+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/puschwahlig-workplace-law/werkstudentin-innovation-management-berlin-298599> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "16a9edc77586552438969b611412c6e18d0d8fea32202e65e2debe2ca5b60f66" ;
    kgjobs:classification "not_match" ;
