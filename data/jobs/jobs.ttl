            schema:name "SESAMY Berlin" ] ;
    schema:title "(Senior) Artist Manager (m/w/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/myty/senior-artist-manager-sesamy-berlin-307082> .

