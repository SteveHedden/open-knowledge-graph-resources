    prov:generatedAtTime "2026-09-01T08:16:34+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-founders-associate-start-in-september-2026-munich-28729/1>,
        <https://www.arbeitnow.com/jobs/companies/robco/founders-associate-start-in-september-2026-munich-28729> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "38f935eb9b9c6d1b074c0027691d82dbf16cf22e3dbc7549ae637c1df1b52c2f" ;
