<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-senior-machine-learning-scientist-berlin-137725> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-05T07:22:49+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-machine-learning-scientist-berlin-137725/1>,
        <https://www.arbeitnow.com/jobs/companies/intercom/senior-machine-learning-scientist-berlin-137725> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "a30bd39613e559ba039542359f410354d7e2061f84251bbf12d8e53377330443" ;
