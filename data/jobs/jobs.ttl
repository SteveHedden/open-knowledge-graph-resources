<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-director-of-product-marketing-and-market-research-326657> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-05T07:22:49+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-director-of-product-marketing-and-market-research-326657/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/mewssystems/director-of-product-marketing-and-market-research-326657> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "3a052c89929bf0f4ccb45996a34fac9a3c2c111784520d89483c944a1c2e6ef6" ;
