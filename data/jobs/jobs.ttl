    kgjobs:active true ;
    kgjobs:canonicalFingerprint "fc85b64b51af1c7e488aaa14fc0e44731764efcaab4fbfdac247d41e4f0835b2" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-21T03:07:42+00:00"^^xsd:dateTime ;
