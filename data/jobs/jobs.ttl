    prov:generatedAtTime "2026-08-18T22:28:45+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/goodlife/werkstudent-b2b-sales-mensch-hamburg-404253> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "3ef346369e3746f0ce061c4ed6a86b990c7ce297481c579402ffba3335f325c2" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-18T20:14:54+00:00"^^xsd:dateTime ;
