            schema:name "Hamburg" ] ;
    schema:title "(Senior) AI-Augmented Software Engineer (all genders)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/apoprojekt/senior-ai-augmented-software-engineer-all-genders-hamburg-480354> .

