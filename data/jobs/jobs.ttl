            schema:name "London" ] ;
    schema:title "Customer Care Associate - Enterprise" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/choco/customer-care-associate-enterprise-london-201247> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-customer-retention-specialist-manchester-41683> a prov:Entity,
