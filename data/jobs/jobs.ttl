        <https://www.arbeitnow.com/jobs/companies/mistralai/strategic-partner-lead-sap-munich-120527> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "75cb5799da8d14a2185fc937a8be5200d9d1a3fef673104823e76394750c6efd" ;
