        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-05T07:22:49+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-werkstudent-strategie-business-development-berlin-482703/1>,
        <https://www.arbeitnow.com/jobs/companies/ckm-group/werkstudent-strategie-business-development-berlin-482703> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "2d39998032c53b27ea6807ccfe2a5daa51b16aa4a5ff8b2a3ab8307a4a930553" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-05T07:22:49+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-09-05T07:22:49+00:00"^^xsd:dateTime ;
    kgjobs:reconciliationReason "no reviewed first-party candidate" ;
