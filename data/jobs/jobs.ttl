    schema:jobLocation [ a schema:Place ;
            schema:name "Hamburg" ] ;
    schema:title "Head of Product Development & Engineering (m/w/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/pammys-dieseo-gmbh/head-of-product-development-engineering-hamburg-81190> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-head-of-product-marketing-hamburg-116446> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-26T04:45:30+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/pammys-dieseo-gmbh/head-of-product-marketing-hamburg-116446> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "e219f0682b16e2b1909ec57dbd371e13b26f6fd6bcb6fab8bd7971acbefae5a7" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-26T01:41:29+00:00"^^xsd:dateTime ;
