    schema:jobLocation [ a schema:Place ;
            schema:name "Manchester Office" ] ;
    schema:title "Lending Servicing Officer" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/allica-bank/lending-servicing-officer-manchester-157731> .

