    kgjobs:lastSeenAt "2026-09-03T07:45:01+00:00"^^xsd:dateTime ;
    kgjobs:reconciliationReason "no reviewed first-party candidate" ;
    kgjobs:sourceOccurrence <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-remote-sales-development-representative-sdr-virtual-data-rooms-europe-germany-141407/1> ;
