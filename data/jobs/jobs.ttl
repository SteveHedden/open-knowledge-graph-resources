    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-qa-engineer-london-290359/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/kraken/senior-qa-engineer-london-290359> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "c7492535346e806b82ee34da12b1a14c62e39aec5bfc7d800674bbbd284b2a9c" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-28T13:20:05+00:00"^^xsd:dateTime ;
