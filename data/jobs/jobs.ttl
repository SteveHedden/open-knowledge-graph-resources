<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-account-director-public-affairs-london-213385> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-25T04:44:23+00:00"^^xsd:dateTime ;
