    prov:generatedAtTime "2026-09-02T07:36:12+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-data-analyst-dusseldorf-138707/1>,
        <https://www.arbeitnow.com/jobs/companies/metro-markets-gmbh/data-analyst-dusseldorf-138707> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "a933e5eecb31806f4902af9654da05a82ac1581f2ddf5dfad024e045154a38d4" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-02T07:36:12+00:00"^^xsd:dateTime ;
