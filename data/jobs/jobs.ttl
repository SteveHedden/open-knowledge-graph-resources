<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-account-director-speciality-markets-emea-london-183568> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-05T07:22:49+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-account-director-speciality-markets-emea-london-183568/1>,
