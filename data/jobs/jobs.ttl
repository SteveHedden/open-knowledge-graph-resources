<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-working-student-product-management-energy-products-tariffs-berlin-302647> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-19T04:41:07+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/1komma5/working-student-product-management-energy-products-tariffs-berlin-302647> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "5e33e956e0bc5a2ab329fd76a954aa9cae236dce161a5be9d272f3acc0a40c3e" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-19T03:01:52+00:00"^^xsd:dateTime ;
