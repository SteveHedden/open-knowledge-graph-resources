            schema:name "Homeoffice" ] ;
    schema:jobLocationType "TELECOMMUTE" ;
    schema:title "Senior Consultant (m/w/d) BI & Konsolidierung" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/angeheuert-gmbh/remote-senior-consultant-bi-konsolidierung-stuttgart-342581> .

