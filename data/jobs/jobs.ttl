    kgjobs:canonicalFingerprint "480d85c5ccc827fc592af85fe9b8dcb8c42ed66f4ff0ac95e974aa537ab80bcb" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-19T10:33:07+00:00"^^xsd:dateTime ;
