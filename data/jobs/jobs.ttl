    prov:generatedAtTime "2026-08-20T20:33:44+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/manzke-gruppe/personalreferent-mit-schwerpunkt-recruiting-vastorf-482128> ;
    kgjobs:active true ;
