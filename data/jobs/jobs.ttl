<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-future-interest-analytics-engineer-bristol-edinburgh-london-427433> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-25T10:39:01+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/kaluza/future-interest-analytics-engineer-bristol-edinburgh-london-427433> ;
