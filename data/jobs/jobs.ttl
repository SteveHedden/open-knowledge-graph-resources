<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-business-operations-manager-london-463828> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-23T18:36:11+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/spaitial/business-operations-manager-london-463828> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "c206ba66d328eb95e16db532034748be489ac70e8f56d0d23f546304531fe3b8" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-23T12:49:00+00:00"^^xsd:dateTime ;
