<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-director-customer-support-network-strategy-service-design-workforce-management-london-35802> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-22T10:28:06+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/woltglobal2/director-customer-support-network-strategy-service-design-workforce-management-london-35802> ;
