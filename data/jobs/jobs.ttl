    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/pigment/corporate-account-executive-dach-frankfurt-313062> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "9b2c4c76d558aa5b34cad64fa7b00bfabb305d13191dffdac16c5eccaf039f33" ;
