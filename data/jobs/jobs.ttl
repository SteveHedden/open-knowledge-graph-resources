<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-platform-data-engineer-cardiff-474975> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-20T10:35:46+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/rocketsciencegg/platform-data-engineer-cardiff-474975> ;
    kgjobs:active true ;
