    kgjobs:canonicalFingerprint "ac7fc4d422ff80b169e096f4b085a976235671c58e75fcf9a512e6b745de39e0" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-20T01:27:18+00:00"^^xsd:dateTime ;
