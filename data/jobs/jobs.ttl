    schema:jobLocationType "ON_SITE" ;
    schema:title "Territory Account Manager, Enterprise Sales - Germany" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/netgear/territory-account-manager-enterprise-sales-germany-munchen-78125> .

