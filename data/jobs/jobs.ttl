    kgjobs:active true ;
    kgjobs:canonicalFingerprint "e5a62e1033ce4c671f89ab16bde8e3cd1d89eb3f6b04d4c1439149cbcceaf4c5" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-21T18:42:27+00:00"^^xsd:dateTime ;
