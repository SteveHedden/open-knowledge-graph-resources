            schema:name "Hamburg" ] ;
    schema:title "Werkstudent (m/w/d) – Finance & Beratung (unternehmerisch, leistungsbasiert)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/kevin-kehr/werkstudent-finance-beratung-unternehmerisch-leistungsbasiert-hamburg-473494> .

