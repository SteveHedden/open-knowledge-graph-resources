    schema:title "Senior Statistical Programmer/Analyst Consultant--(Oncology) -Remote (Outside IR35)" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/clinchoice/senior-statistical-programmer-analyst-consultant-oncology-remote-outside-ir35-50106> .

