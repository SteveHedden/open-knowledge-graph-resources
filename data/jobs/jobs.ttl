        <https://www.arbeitnow.com/jobs/companies/sosafe/mid-market-account-executive-dach-berlin-325096> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "dafe60bb513cb14b343854230cb25ab651c282fd07f9da2fe96c220d93ea0fee" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-05T07:22:49+00:00"^^xsd:dateTime ;
