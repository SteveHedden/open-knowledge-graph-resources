    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-26T04:45:30+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/wurdig-pumpentechnik-gmbh-cokg/meister-shk-automatisierung-trinkwasser-in-berlin-55030> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "4425231db3c282599041b0fb9f052eefa801be8bcbef07218af1d90ac0f1dd46" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-25T18:45:43+00:00"^^xsd:dateTime ;
