    prov:generatedAtTime "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-java-engineer-team-search-berlin-139280/1>,
        <https://www.arbeitnow.com/jobs/companies/flix/senior-java-engineer-team-search-berlin-139280> ;
