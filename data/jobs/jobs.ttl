    schema:title "Applied Machine Learning Engineer, EMEA" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/fireworks/applied-machine-learning-engineer-emea-london-353394> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-area-director-southeast-london-sidcup-kent-england-140857> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-18T22:28:45+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/ivcevidensia/area-director-southeast-london-sidcup-kent-england-140857> ;
    kgjobs:active true ;
