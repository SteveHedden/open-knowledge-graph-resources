            schema:name "Berlin" ] ;
    schema:title "Safety, Instrumentation & Controls Engineer" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/level-nine/safety-instrumentation-controls-engineer-berlin-255850> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-sales-development-representative-manchester-254396> a prov:Entity,
