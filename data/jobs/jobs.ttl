        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-28T13:20:05+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-chief-of-staff-berlin-80776/1>,
        <https://www.arbeitnow.com/jobs/companies/p3a/chief-of-staff-berlin-80776> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "dc51274b09c1e4d5fe5ce46d2e1b52166e09f869f4fa8135f399ab342621edcd" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-28T13:20:05+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-08-28T13:20:05+00:00"^^xsd:dateTime ;
