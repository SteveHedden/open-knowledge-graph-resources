<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-fixed-term-field-sales-training-executive-sephora-uk-london-138981> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
