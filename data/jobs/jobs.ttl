<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-implementation-specialist-london-427736> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-implementation-specialist-london-427736/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/metaview/implementation-specialist-london-427736> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "79f1c0002989258a2b367c59fe1b458d04fed11fea13412bf7721a9d7455360e" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
