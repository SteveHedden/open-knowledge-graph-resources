    schema:jobLocation [ a schema:Place ;
            schema:name "Berlin, Schlesische Straße 26" ] ;
    schema:title "Werkstudent*in (w/m/d) Postproduktion / Schnitt" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/hirschen-group-gmbh/werkstudentin-postproduktion-schnitt-berlin-schlesische-strasse-26-33413> .

