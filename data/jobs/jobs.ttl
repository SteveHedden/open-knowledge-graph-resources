<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-recruiter-emea-6m-contract-inside-ir35-day-rate-london-151143> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-19T12:55:46+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/sonyinteractiveentertainmentglobal/senior-recruiter-emea-6m-contract-inside-ir35-day-rate-london-151143> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "4806b071b4478107326cc9880e414af38db892231b51cb611db2b1e1f4c7657c" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-19T03:01:52+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-08-19T12:55:46+00:00"^^xsd:dateTime ;
