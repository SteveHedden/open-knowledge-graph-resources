<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-business-unit-lead-cloud-infrastructure-mainz-225349> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-20T10:35:46+00:00"^^xsd:dateTime ;
