    kgjobs:canonicalFingerprint "6f5514bbb04cfb7a47d65af02e60b5bda3a2fe22ba59192b0def16f016690e4e" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-03T07:45:01+00:00"^^xsd:dateTime ;
