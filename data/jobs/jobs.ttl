            schema:name "Germany" ] ;
    schema:title "Security & Compliance Engineer - Remote Germany" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/linro/security-compliance-engineer-remote-germany-469817> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-security-engineering-lead-london-331976> a prov:Entity,
        schema:JobPosting ;
