<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-director-of-mobile-and-web-platform-berlin-1921> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-29T09:42:00+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-director-of-mobile-and-web-platform-berlin-1921/1>,
        <https://www.arbeitnow.com/jobs/companies/tide/director-of-mobile-and-web-platform-berlin-1921> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "a6c5cf5612c160ccba10f2a6584adfdfc3b5d378bad30b9d1a6f51bc91d830ea" ;
