        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-28T13:20:05+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-systemadministrator-automation-tools-deutschlandweit-100217/1>,
        <https://www.arbeitnow.com/jobs/companies/netzbest-gmbh/systemadministrator-automation-tools-deutschlandweit-100217> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "c8de55bbad4f786cd201d4fc90b2a33586d9bf5e4553c05c3618c6d1255b7ee5" ;
    kgjobs:classification "not_match" ;
