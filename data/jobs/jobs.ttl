<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-staff-principal-research-engineer-ai-safety-technical-mitigations-london-29039> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-staff-principal-research-engineer-ai-safety-technical-mitigations-london-29039/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/lilasciences/staff-principal-research-engineer-ai-safety-technical-mitigations-london-29039> ;
