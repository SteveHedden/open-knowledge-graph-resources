        <https://www.arbeitnow.co.uk/jobs/companies/matchspace-music-ag/product-business-analyst-london-258956> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "27c79c6c2d3013d9c81cf4541095e43beb8b340a41d1e943e96e461f31adbbcf" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-28T13:20:05+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-08-28T13:20:05+00:00"^^xsd:dateTime ;
    kgjobs:reconciliationReason "no reviewed first-party candidate" ;
