    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/talos-trading/technical-solutions-engineer-london-80182> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "746a3a13ed6e405268675d7f4b55052b7ae7b369b1a7f08f65b1292ed446e53f" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-19T18:41:05+00:00"^^xsd:dateTime ;
