    prov:generatedAtTime "2026-09-01T08:16:34+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-head-of-product-development-engineering-hamburg-279680/1>,
        <https://www.arbeitnow.com/jobs/companies/pammys-dieseo-gmbh/head-of-product-development-engineering-hamburg-279680> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "5a8e27a729a199a308f102accfbca55f3543fb41c9a67e6faf8a446b1fecd43b" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-31T19:51:41+00:00"^^xsd:dateTime ;
