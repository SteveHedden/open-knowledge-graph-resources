    schema:title "Member of Marketing Staff - Marketing Producer FTC" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/tesslcareers/member-of-marketing-staff-marketing-producer-ftc-london-283136> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-member-of-product-staff-product-manager-london-168668> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-19T04:41:07+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/tesslcareers/member-of-product-staff-product-manager-london-168668> ;
