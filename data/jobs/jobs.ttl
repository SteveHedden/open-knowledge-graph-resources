    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-25T22:33:23+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/badische-backstub-f-u-e-weber-gmbh/mitarbeiter-qualitatsmanagement-fachkraft-qualitatssicherung-management-ettlingen-65826> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "71c321c16d86baaba28d7dc37c20d3fd8c77f55ec5c8f9c8450fb8ee6ec5a4c0" ;
    kgjobs:classification "not_match" ;
