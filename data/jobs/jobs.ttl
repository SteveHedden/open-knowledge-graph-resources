<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-teamleiterin-outbound-telesales-100-homeoffice-hamburg-490011> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-25T04:44:23+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/hey-contact-heroes-gmbh/teamleiterin-outbound-telesales-100-homeoffice-hamburg-490011> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "c5499c7e806494f4883b6898b14a6b8b8a35970c27c229296325050912cbb0e5" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-24T14:52:05+00:00"^^xsd:dateTime ;
