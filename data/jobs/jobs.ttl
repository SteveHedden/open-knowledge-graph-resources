    kgjobs:active true ;
    kgjobs:canonicalFingerprint "78d8004c4c917868568f539de8bcb3c73ee984f7718dfc84ca513ac90a8e2ffc" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-19T22:29:16+00:00"^^xsd:dateTime ;
