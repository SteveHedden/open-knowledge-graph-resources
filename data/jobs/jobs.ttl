            schema:name "Berlin" ] ;
    schema:title "Senior DevOps Engineer" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/sumup/senior-devops-engineer-berlin-185651> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-devops-engineer-mit-interesse-in-banking-leipzig-44252> a prov:Entity,
