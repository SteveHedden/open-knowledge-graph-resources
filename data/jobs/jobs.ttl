<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-social-media-associate-london-416175> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-28T01:26:42+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-social-media-associate-london-416175/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/synthesia/social-media-associate-london-416175> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "c8c98e626c7c5ef439408c9d49f6d9b83bc35407416cd347c1598271b23ed095" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-28T01:26:42+00:00"^^xsd:dateTime ;
