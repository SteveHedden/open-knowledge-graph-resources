            schema:name "Stuttgart" ] ;
    schema:title "CRO Manager - E-Commerce (m/w/d) in Vollzeit" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/globalist-gmbh/cro-manager-e-commerce-in-vollzeit-stuttgart-50978> .

