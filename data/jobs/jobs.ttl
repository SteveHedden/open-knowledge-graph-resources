    schema:jobLocationType "ON_SITE" ;
    schema:title "Senior Enterprise Account Executive, Rosetta Stone Europe (London)" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/ixllearning/senior-enterprise-account-executive-rosetta-stone-europe-london-252096> .

