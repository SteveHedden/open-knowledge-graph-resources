    kgjobs:active true ;
    kgjobs:canonicalFingerprint "b1fc566e043ab38bfd2907f688183cb4196df415804b290bc8fa51b71a1fafdf" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-25T12:57:11+00:00"^^xsd:dateTime ;
