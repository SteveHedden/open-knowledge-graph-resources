    schema:identifier "arbeitnow-senior-manager-treasury-trier-12388" ;
    schema:jobLocation [ a schema:Place ;
            schema:name "Trier, Rheinland-Pfalz, Deutschland" ] ;
    schema:title "Senior Manager Treasury (m/w/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/angeheuert-gmbh/senior-manager-treasury-trier-12388> .

