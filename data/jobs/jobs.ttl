<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-technical-qa-tester-berlin-germany-293124> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-20T14:40:20+00:00"^^xsd:dateTime ;
