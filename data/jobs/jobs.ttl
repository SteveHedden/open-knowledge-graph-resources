    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/supreme-sports-hospitality-gmbh/kioskmitarbeiter-all-genders-bremen-39921> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "be940b2e6427e4ebbdd8538a3bb879b5ee8a63d0951ea8aa2ba1f5a743b53939" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-25T04:44:23+00:00"^^xsd:dateTime ;
