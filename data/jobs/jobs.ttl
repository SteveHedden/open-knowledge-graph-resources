<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-senior-ml-engineer-manchester-360093> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-ml-engineer-manchester-360093/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/anaplan/senior-ml-engineer-manchester-360093> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "2f84b7b4cb188ccba41c341eec1daf211755aec189fe93dab38096eae3ebfc09" ;
    kgjobs:classification "not_match" ;
