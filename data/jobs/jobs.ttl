        <https://www.arbeitnow.com/jobs/companies/pammys-dieseo-gmbh/director-product-hamburg-460453> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "d346d9c4a24383ad8fba14aed7de2b0bc9ac35f230b4854fed7cf16fe5bd2d3a" ;
