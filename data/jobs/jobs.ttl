<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-legal-counsel-employment-law-berlin-munich-93631> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
