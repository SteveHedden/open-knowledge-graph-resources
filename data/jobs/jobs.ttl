<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-absolvent-berufseinsteiger-fur-erneuerbare-energien-koln-324571> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-22T10:28:06+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/vamo/absolvent-berufseinsteiger-fur-erneuerbare-energien-koln-324571> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "51441924183cbf242cd2034849c38311869a863c3bb5d066de427aab87a60f10" ;
    kgjobs:classification "not_match" ;
