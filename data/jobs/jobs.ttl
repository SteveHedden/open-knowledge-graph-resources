            schema:name "Berlin" ] ;
    schema:title "SEO/GEO Manager im Online-Marketing (m/w/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/suchmeisterei-gmbh/seo-geo-manager-im-online-marketing-berlin-17633> .

