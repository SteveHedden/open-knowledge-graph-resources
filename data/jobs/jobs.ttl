            schema:name "United Kingdom" ] ;
    schema:title "Global Onboarding" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/elevenlabs/global-onboarding-united-kingdom-42448> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-gtm-enablement-specialist-london-233491> a prov:Entity,
