            schema:name "EMEA, UK" ] ;
    schema:jobLocationType "TELECOMMUTE" ;
    schema:title "Software Architect" ;
    schema:url <https://jobicy.com/jobs/150381-software-architect> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/jobicy-150915> a prov:Entity,
        schema:JobPosting ;
