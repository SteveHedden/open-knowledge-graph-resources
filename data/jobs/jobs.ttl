            schema:name "Bielefeld, Nordrhein-Westfalen, Deutschland" ] ;
    schema:title "Talent Acquisition Manager (m/w/d)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/aramaz-digital/talent-acquisition-manager-bielefeld-305460> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-talent-acquisition-partner-london-170234> a prov:Entity,
