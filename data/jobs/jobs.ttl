        <https://www.arbeitnow.com/jobs/companies/superhuman/business-operations-lead-agents-berlin-157108> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "b1f799067297e07ee2c568e12a130966ed8176b7843f95a9bdff16c57e849874" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-29T09:42:00+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-08-29T09:42:00+00:00"^^xsd:dateTime ;
