    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-remote-projektentwickler-ostdeutschland-berlin-484904/1>,
        <https://www.arbeitnow.com/jobs/companies/q-energy/remote-projektentwickler-ostdeutschland-berlin-484904> ;
