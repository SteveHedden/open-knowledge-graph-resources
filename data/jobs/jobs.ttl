    kgjobs:active true ;
    kgjobs:canonicalFingerprint "ee99409a96bc579d8725baef0e092adc2ef95357fae3ca75597fdbe8006ae4d9" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-05T07:22:49+00:00"^^xsd:dateTime ;
