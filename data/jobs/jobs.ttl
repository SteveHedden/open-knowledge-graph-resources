            schema:name "London" ] ;
    schema:title "Transaction Principal, EU" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/anthropic/transaction-principal-eu-london-201369> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-uav-operations-engineer-pilot-data-operations-all-genders-munich-390797> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-26T04:45:30+00:00"^^xsd:dateTime ;
