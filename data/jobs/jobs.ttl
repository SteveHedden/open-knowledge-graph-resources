            schema:name "Berlin, Germany" ] ;
    schema:title "Senior Sales Manager, Regional Enterprise" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/wolt-english/senior-sales-manager-regional-enterprise-berlin-460113> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-software-engineer-applied-ai-london-336734> a prov:Entity,
