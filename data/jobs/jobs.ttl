<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-fullstack-engineer-merchant-emea-berlin-192217> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-22T01:26:57+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/wolt/fullstack-engineer-merchant-emea-berlin-192217> ;
