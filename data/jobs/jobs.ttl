    prov:generatedAtTime "2026-08-25T04:44:23+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/comdesk-gmbh/werkstudent-sales-development-munchen-299612> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "ef6fee24305460fe87f5d558faf3fc29afe7a7ff9ff9cd936797acf3e2c9bd0c" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-24T18:48:18+00:00"^^xsd:dateTime ;
