    schema:jobLocation <https://openknowledgegraphs.com/jobs/live/job/arbeitnow-steuerberater-in-berlin-75457/location> ;
    schema:jobLocationType "ON_SITE" ;
    schema:title "Steuerberater (m/w/d) in Berlin" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/borsing-pohl-partner-steuerberater-rechtsanwalte/steuerberater-in-berlin-75457> .

