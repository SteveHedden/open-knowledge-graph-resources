    prov:generatedAtTime "2026-08-26T04:45:30+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/caronsale/praktikant-after-sales-berlin-101997> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "fcb48d6c3c27132b732e4c0c135c78b5e01e716cc76e73a04cfcdabe7432d780" ;
