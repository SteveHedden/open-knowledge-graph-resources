            schema:name "Berlin" ] ;
    schema:title "Werkstudent (m/w/d) - Technisches Management Gas- und Wasserstoffnetze" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/natran-deutschland-gmbh/werkstudent-technisches-management-gas-und-wasserstoffnetze-berlin-136878> .

