<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-facharztin-facharzt-fur-allgemeinmedizin-und-oder-innere-medizin-herten-424020> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
