<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-infrastructure-platform-engineer-london-230029> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-26T04:45:30+00:00"^^xsd:dateTime ;
