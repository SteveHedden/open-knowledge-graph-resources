    prov:generatedAtTime "2026-08-19T12:55:46+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.co.uk/jobs/companies/unity-advisory/operations-associate-london-304996> ;
    kgjobs:active true ;
