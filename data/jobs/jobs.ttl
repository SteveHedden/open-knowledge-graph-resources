    kgjobs:active true ;
    kgjobs:canonicalFingerprint "86bd5bfea1e2b471b367b112048bcdeadcfd1bd06fa73f656e5b5134e8456463" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-19T10:32:59+00:00"^^xsd:dateTime ;
