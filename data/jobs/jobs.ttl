<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-working-student-customer-success-berlin-303238> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-19T22:29:16+00:00"^^xsd:dateTime ;
