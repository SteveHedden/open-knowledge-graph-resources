    kgjobs:active true ;
    kgjobs:canonicalFingerprint "da31bc18f9ff15fab3892f405012c877f2ca70d271661d1eee70a7f0810e70a6" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-08-20T18:46:07+00:00"^^xsd:dateTime ;
