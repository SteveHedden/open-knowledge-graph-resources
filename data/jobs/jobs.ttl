        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-02T07:36:12+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-werkstudent-mensch-google-dusseldorf-241595/1>,
        <https://www.arbeitnow.com/jobs/companies/wppmedia/werkstudent-mensch-google-dusseldorf-241595> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "a7e6aef464c71e0887c2b92aaebf5d4a852948c4fbb71449cb0d068e445d1a64" ;
