<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-account-solution-architect-london-134799> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
