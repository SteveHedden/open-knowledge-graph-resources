<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-leasing-pricing-specialist-london-263479> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-28T01:26:42+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-leasing-pricing-specialist-london-263479/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/carwow/leasing-pricing-specialist-london-263479> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "c6cdc9eeefe7ed79c73288de9e4a9d2313c90bf4e4b4de4ed445933a6c772725" ;
