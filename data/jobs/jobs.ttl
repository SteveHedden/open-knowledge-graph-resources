            schema:name "London" ] ;
    schema:title "Alliance Director, Strategic Technology Partnerships" ;
    schema:url <https://www.arbeitnow.co.uk/jobs/companies/cube/alliance-director-strategic-technology-partnerships-london-452367> .

<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-aml-team-leader-leeds-141070> a prov:Entity,
