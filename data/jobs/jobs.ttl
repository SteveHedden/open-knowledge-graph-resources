    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-senior-customer-success-manager-326771/1>,
        <https://www.arbeitnow.com/jobs/companies/nice/senior-customer-success-manager-326771> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "144abb67816a6cc830e9a22da413586083c8db9ef37b9fcc1910ceef8cdd5a77" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
