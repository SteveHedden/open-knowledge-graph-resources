<https://openknowledgegraphs.com/jobs/live/job/arbeitnow-remote-senior-account-director-digital-solutions-client-partner-freiburg-183541> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-09-02T07:36:12+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-remote-senior-account-director-digital-solutions-client-partner-freiburg-183541/1>,
