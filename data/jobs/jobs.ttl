    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-account-solution-architect-london-134799/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/coreweave/account-solution-architect-london-134799> ;
