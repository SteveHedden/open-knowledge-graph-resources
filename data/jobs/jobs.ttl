<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/himalayas-f6a18cb9a7632cf0> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/himalayas> ;
    prov:generatedAtTime "2026-08-21T22:29:19+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://himalayas.app/companies/dropbox/jobs/enterprise-context-architect-8865361332> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "f6a18cb9a7632cf0bc1554aab434275329e8e22048aa405bc0018126a9a6a0bb" ;
    kgjobs:classification "not_match" ;
