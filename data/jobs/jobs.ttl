    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/prettytelco-gmbh/seniorservice-manager-mobilfunk-b2b-key-account-energiewirtschaft-cologne-267879> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "74cf257f1fe079d98a9e3c824795828d5c8befa91c9b591973f3ff8f59c23e75" ;
