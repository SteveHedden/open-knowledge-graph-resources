    prov:generatedAtTime "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://openknowledgegraphs.com/jobs/live/occurrence/arbeitnow-cybersecurity-analyst-london-249291/1>,
        <https://www.arbeitnow.co.uk/jobs/companies/janestreet/cybersecurity-analyst-london-249291> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "4e91882c5f11c668bf311b80599e7687e019ab1460fb5480dd95bef1206412d0" ;
    kgjobs:classification "not_match" ;
    kgjobs:firstSeenAt "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
    kgjobs:lastSeenAt "2026-09-04T07:41:42+00:00"^^xsd:dateTime ;
    kgjobs:reconciliationReason "no reviewed first-party candidate" ;
