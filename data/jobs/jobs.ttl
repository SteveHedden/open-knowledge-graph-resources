    schema:jobLocation <https://openknowledgegraphs.com/jobs/live/job/arbeitnow-werkstudent-im-unternehmensmarketing-wvm-koln-9471/location> ;
    schema:title "Werkstudent (m/w/d) im Unternehmensmarketing" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/wvm-immobilien-projektentwicklung-gmbh/werkstudent-im-unternehmensmarketing-wvm-koln-9471> .

