<https://openknowledgegraphs.com/prototypes/kg-jobs/live/job/arbeitnow-senior-sales-executive-live-events-london-435138> a prov:Entity,
        schema:JobPosting ;
    dcterms:source <https://openknowledgegraphs.com/prototypes/kg-jobs/source/arbeitnow> ;
    prov:generatedAtTime "2026-08-19T04:41:07+00:00"^^xsd:dateTime ;
