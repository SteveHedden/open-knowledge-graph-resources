            schema:name "Berlin" ] ;
    schema:title "Datalink Integration & Test Engineer – Communications / MANET (all genders)" ;
    schema:url <https://www.arbeitnow.com/jobs/companies/stark/datalink-integration-test-engineer-communications-manet-all-genders-berlin-498002> .

