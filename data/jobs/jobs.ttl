    prov:generatedAtTime "2026-08-20T20:33:44+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://www.arbeitnow.com/jobs/companies/european-dynamics/remote-database-administrator-germany-431335> ;
    kgjobs:active true ;
    kgjobs:canonicalFingerprint "a72be7bae8483f460bd838b899df357bd1c0203bd4220a1bcc5e95afed7e3c37" ;
