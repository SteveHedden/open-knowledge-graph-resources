    dcterms:source <https://openknowledgegraphs.com/jobs/source/himalayas> ;
    prov:generatedAtTime "2026-09-03T07:45:01+00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom <https://himalayas.app/companies/aptive/jobs/senior-health-informatics-standards-and-interoperability-consultant>,
        <https://openknowledgegraphs.com/jobs/live/occurrence/himalayas-c54c9b24c98a2ac3/1> ;
