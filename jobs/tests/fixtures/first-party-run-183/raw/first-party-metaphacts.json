leitem itemid-1375\" role=\"none\"><a class=\"dj-up_a  \" href=\"/about/ecosystem/research\"  role=\"menuitem\"><span class=\"title\"><span class=\"name\">Research</span></span></a></li><li class=\"dj-mobileitem itemid-1376\" role=\"none\"><a class=\"dj-up_a  \" href=\"/about/ecosystem/publications\"  role=\"menuitem\"><span class=\"title\"><span class=\"name\">Publications</span></span></a></li></ul></li><li class=\"dj-mobileitem itemid-1377\" role=\"menuitem\"></li><li class=\"dj-mobileitem itemid-1196\" role=\"none\"><a class=\"dj-up_a  \" href=\"/metaphactory\"  role=\"menuitem\"><img class=\"dj-icon\" src=\"/images/metaphactory-logo.png#joomlaImage://local-images/metaphactory-logo.png\" alt=\"metaphactory\"    /><span class=\"image-title\"><small class=\"subtitle\">metaphactory transforms your data into consumable, contextual &amp; actionable knowledge and drives continuous decision intelligence</small></span></a><div class=\"html-after\"><a href=\"/metaphactory\">read more</a></div></li></ul></li><li class=\"dj-mobileitem itemid-1211\" role=\"none\"><a class=\"dj-up_a  cta-button\" href=\"/get-started\"  role=\"menuitem\"><span class=\"title\"><span class=\"name\">Get Started</span></span></a></li></ul>\r\n\t\t</div>\r\n\t</div>\r\n</div>\r\n\t</div>\r\n\n\n                \n            \n    \n\n        </div>\n        \n\n    </div>\n\n</header>\n\n  <div class=\"page-center\"></div>\n    <section id=\"sp-main-body\">\n               <div id=\"sp-component\">\n                   \n                   <div class=\"sp-column\">\n                       \n                                              <div id=\"sp-page-builder\" class=\"sp-page-builder  page-33 \" x-data=\"easystoreProductList\">\n\n\t\n\t\n\n\t\n\t<div class=\"page-content builder-container\" x-data=\"easystoreProductDetails\">\n\n\t\t\t\t<section id=\"section-id-1630251945944\" class=\"sppb-section hero low\" ><div class=\"sppb-row-container\"><div class=\"sppb-row\"><div class=\"sppb-col-md-6  \" id=\"column-wrap-id-1630251945944\"><div id=\"column-id-1630251945944\" class=\"sppb-column  hero-left\" ><div class=\"sppb-column-addons\"><div id=\"sppb-addon-wrapper-1630251945945\" class=\"sppb-addon-wrapper  addon-root-text-block\"><div id=\"sppb-addon-1630251945945\" class=\"clearfix  \"     ><div class=\"sppb-addon sppb-addon-text-block overheading\" ><div class=\"sppb-addon-content  \"><p>CAREER</p></div></div></div></div><div id=\"sppb-addon-wrapper-1630251945946\" class=\"sppb-addon-wrapper  addon-root-heading\"><div id=\"sppb-addon-1630251945946\" class=\"clearfix  \"     ><div class=\"sppb-addon sppb-addon-header\"><h1 class=\"sppb-addon-title\">Join our team!</h1></div></div></div><div id=\"sppb-addon-wrapper-1630251945953\" class=\"sppb-addon-wrapper  addon-root-text-block\"><div id=\"sppb-addon-1630251945953\" class=\"clearfix  \"     ><div class=\"sppb-addon sppb-addon-text-block inline-orange\" ><div class=\"sppb-addon-content  \"><p>Apply today to join our young, dynamic and highly motivated international team!</p></div></div></div></div><div id=\"sppb-addon-wrapper-1634897462099\" class=\"sppb-addon-wrapper  addon-root-button\"><div id=\"sppb-addon-1634897462099\" class=\"clearfix  \"     ><div class=\"sppb-button-wrapper\"><a href=\"mailto:jobs@metaphacts.com\"   id=\"btn-1634897462099\"  class=\"sppb-btn  sppb-btn-default sppb-btn-rounded\">jobs@metaphacts.com</a></div></div></div></div></div></div><div class=\"sppb-col-md-6  \" id=\"column-wrap-id-1630251945948\"><div id=\"column-id-1630251945948\" class=\"sppb-column \" ><div class=\"sppb-column-addons\"></div></div></div></div></div></section><section id=\"section-id-1630305973402\" class=\"sppb-section orange-line-row\" ><div class=\"sppb-row-container\"><div class=\"sppb-row\"><div class=\"sppb-col-md-5  \" id=\"column-wrap-id-1630305973401\"><div id=\"column-id-1630305973401\" class=\"sppb-column \" ><div class=\"sppb-column-addons\"><div id=\"sppb-addon-wrapper-1630305973402\" class=\"sppb-addon-wrapper  addon-root-text-block\"><div id=\"sppb-addon-1630305973402\" class=\"clearfix  \"     ><div class=\"sppb-addon sppb-addon-text-block orange-before\" ><h3 class=\"sppb-addon-title\">About us</h3><div class=\"sppb-addon-content  \"><p>metaphacts is a Walldorf-based high-tech company offering an end-to-end platform to ease the onboarding into the world of enterprise knowledge graphs which helps customers drive decision intelligence through knowledge democratization.<br /><br />At metaphacts, we strive to develop cutting edge products and solutions for our customers and users in areas such asengineering and manufacturing, life sciences, energy, retail, finance and insurance, and many more. As a member of our team, you have the opportunity to act at the interface between research, innovation, product development and our end users, developing solutions for large-scale enterprise data and knowledge management, search and analytics.</p></div></div></div></div></div></div></div><div class=\"sppb-col-md-2  \" id=\"column-wrap-id-1630305973403\"><div id=\"column-id-1630305973403\" class=\"sppb-column \" ><div class=\"sppb-column-addons\"></div></div></div><div class=\"sppb-col-md-5  \" id=\"column-wrap-id-1630305973407\"><div id=\"column-id-1630305973407\" class=\"sppb-column \" ><div class=\"sppb-column-addons\"><div id=\"sppb-addon-wrapper-1630305973406\" class=\"sppb-addon-wrapper  addon-root-text-block\"><div id=\"sppb-addon-1630305973406\" class=\"clearfix  \"     ><div class=\"sppb-addon sppb-addon-text-block orange-before\" ><h3 class=\"sppb-addon-title\">Why should you join us?</h3><div class=\"sppb-addon-content  \"><p><b>»</b> Become part of a young, dynamic, and highly motivated international team with flat hierarchies and a startup spirit<br /> <b>»</b> As a valuable team member, you can bring in your own ideas and make personal progress while actively advancing our product and solution offerings<br /> <b>»</b> Build up your personal network by helping us organize and participate in community events like meetups and conferences<br /> <b>»</b> Participate in our high-profile international research projects and contribute to our research publications<br /> <b>»</b> Get training and certifications in key technologies relevant to your role<br /> <b>»</b> Benefit from flexible work times and hardware of your choice</p></div></div></div></div></div></div></div></div></div></section><section id=\"section-id-1630315534575\" class=\"sppb-section above-question\" ><div class=\"sppb-row-container\"><div class=\"sppb-row\"><div class=\"sppb-col-md-12  \" id=\"column-wrap-id-1630315534575\"><div id=\"column-id-1630315534575\" class=\"sppb-column \" ><div class=\"sppb-column-addons\"><div id=\"sppb-addon-wrapper-1630315534576\" class=\"sppb-addon-wrapper  addon-root-heading\"><div id=\"sppb-addon-1630315534576\" class=\"clearfix  \"     ><div class=\"sppb-addon sppb-addon-header\"><h3 class=\"sppb-addon-title\">At the moment we do not have any job openings, but you are interested in or have experience with knowledge graphs and semantic technologies, please do not hesitate to send us your CV - we are happy to hear from you!</h3></div></div></div><div id=\"sppb-addon-wrapper-1634899390493\" class=\"sppb-addon-wrapper  addon-root-button\"><div id=\"sppb-addon-1634899390493\" class=\"clearfix  \"     ><div class=\"sppb-button-wrapper\"><a href=\"mailto:jobs@metaphacts.com\"   id=\"btn-1634899390493\"  class=\"sppb-btn  sppb-btn-default sppb-btn-rounded\">Apply today!</a></div></div></div></div></div></div></div></div></section>\n\t\t\t</div>\n\n\t</div>\n\n                   </div>\n\n           </div>\n       </section>\n\n\n<div class=\"above__footer\">\n    \n</div>\n<footer class=\"footer\">\n\n    <div class=\"container\">\n\n        <div class=\"footer__top\">\n            \n<div id=\"mod-custom515\" class=\"mod-custom custom\">\n    <style>\r\n/* ── Reset ── */\r\n*{margin:0;padding:0;box-sizing:border-box}\r\n\r\n/* ── Custom Properties ── */\r\n.footer{\r\n  --footer-bg:#101823;\r\n  --footer-text:#fff;\r\n  --footer-muted:rgba(255,255,255,0.55);\r\n  --footer-accent:#E95224;\r\n  --footer-social-bg:rgba(255,255,255,0.35);\r\n}\r\n\r\n/* ── Footer base ── */\r\n.footer{\r\n  background:var(--footer-bg);\r\n  color:var(--footer-text);\r\n  font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;\r\n  padding:48px 0px 28px;\r\n}\r\n.footer-inner{\r\n  max-width:1290px;\r\n  margin:0 auto;\r\n}\r\n\r\n/* ── Row 1: Brand + Navigation ── */\r\n.row1{\r\n  display:grid;\r\n  gap:28px;\r\n  grid-template-columns:25% repeat(4,1fr);\r\n}\r\n\r\n/* Brand column */\r\n.brand-col{\r\n  display:flex;\r\n  flex-direction:column;\r\n}\r\n.brand-col .logo{\r\n  font-size:18px;\r\n  font-weight:700;\r\n  color:var(--footer-text);\r\n  margin-bottom:8px;\r\n}\r\n.brand-col .sub{\r\n  font-size:14px;\r\n  font-weight:400;\r\n  color:var(--footer-muted);\r\n  margin-bottom:12px;\r\n}\r\n.brand-col .blurb{\r\n  font-size:14px;\r\n  line-height:1.6;\r\n  color:#fff;\r\n  margin-bottom:16px;\r\n}\r\n\r\n/* Social icons */\r\n.social{\r\n  display:flex;\r\n  flex-wrap:wrap;\r\n  gap:16px;\r\n}\r\n.social a{\r\n  display:inline-flex;\r\n  align-items:center;\r\n  justify-content:center;\r\n  width:40px;\r\n  height:40px;\r\n  border-radius:50%;\r\n  background:var(--footer-social-bg);\r\n  color:var(--footer-text);\r\n  font-size:14px;\r\n  font-weight:600;\r\n  text-decoration:none;\r\n  transition:all .15s;\r\n}\r\n.social a svg{\r\n  width:20px;\r\n  height:20px;\r\n}\r\n.social a:hover,\r\n.social a:focus-visible{\r\n  background:var(--footer-accent);\r\n  color:#000;\r\n}\r\n\r\n/* Newsletter link */\r\n.newsletter-link{\r\ncursor:pointer;\r\n  display:inline-flex;\r\n  align-items:center;\r\n  gap:6px;\r\n  width:fit-content;\r\n  margin-top:16px;\r\n  font-size:14px;\r\n  color:var(--footer-text);\r\n  text-decoration:none;\r\n  padding:2px;\r\n  transition:all .15s;\r\n}\r\n.newsletter-link svg{\r\n  width:16px;\r\n  height:16px;\r\n}\r\n.newsletter-link:hover,\r\n.newsletter-link:focus-visible{\r\n  background:var(--footer-accent);\r\n  color:#000;\r\n  border-radius:3px;\r\n}\r\n.newsletter-link svg{\r\n  transition:all .3s ease;\r\n}\r\n.newsletter-link:hover svg,\r\n.newsletter-link:focus-visible svg{\r\n  transform:rotate(45deg);\r\n}\r\n\r\n/* Navigation columns */\r\n.nav h3{\r\n  color:var(--footer-accent);\r\n  font-size:18px;\r\n  font-weight:700;\r\n  letter-spacing:.3px;\r\n  margin-bottom:14px;\r\n}\r\n.nav ul{list-style:none}\r\n.nav li{margin-bottom:8px}\r\n.nav a{\r\n  color:var(--footer-text);\r\n  text-decoration:none;\r\n  font-size:14px;\r\n  padding:2px;\r\n  margin:-2px;\r\n  transition:all .15s;\r\n}\r\n.nav a:hover,\r\n.nav a:focus-visible{\r\n  background:var(--footer-accent);\r\n  color:#000;\r\n  border-radius:3px;\r\n}\r\n\r\n/* ── Row 2: DS Ecosystem ── */\r\n.row2{\r\n  display:grid;\r\n  gap:28px;\r\n  grid-template-columns:25% 1fr;\r\n  padding:32px 0;\r\n  margin-top:28px;\r\n  border-top:1px solid rgba(255,255,255,0.12);\r\n}\r\n.ds-block .ds-title{\r\n  font-size:18px;\r\n  font-weight:700;\r\n  color:var(--footer-muted);\r\n  letter-spacing:.3px;\r\n  margin-bottom:8px;\r\n}\r\n.ds-block .ds-subtitle{\r\n  font-size:14px;\r\n  font-weight:400;\r\n  color:var(--footer-muted);\r\n  margin-bottom:12px;\r\n}\r\n.ds-block p{\r\n  font-size:14px;\r\n  line-height:1.6;\r\n  color:var(--footer-muted);\r\n}\r\n.ds-block .ds-link{\r\n  color:var(--footer-muted);\r\n  text-decoration:none;\r\n  font-size:14px;\r\n  display:inline-flex;\r\n  align-items:center;\r\n  gap:4px;\r\n  margin-top:6px;\r\n  padding:2px;\r\n  margin-left:-2px;\r\n  transition:all .15s;\r\n}\r\n.ds-block .ds-link:hover,\r\n.ds-block .ds-link:focus-visible{\r\n  background:var(--footer-accent);\r\n  color:#000;\r\n  border-radius:3px;\r\n}\r\n\r\n/* External link icon */\r\n.ext-icon{\r\n  display:inline-block;\r\n  width:16px;\r\n  height:16px;\r\n  vertical-align:middle;\r\n}\r\n/* ext-icon inherits link colour via currentColor; no extra opacity needed */\r\n\r\n.siblings-block .sib-title{\r\n  font-size:18px;\r\n  font-weight:700;\r\n  color:var(--footer-muted);\r\n  letter-spacing:.3px;\r\n  margin-bottom:12px;\r\n}\r\n.siblings-block .sib-list{\r\n  display:flex;\r\n  flex-wrap:wrap;\r\n  gap:10px 18px;\r\n}\r\n.siblings-block .sib{\r\n  font-size:14px;\r\n  color:var(--footer-muted);\r\n  text-decoration:none;\r\n  display:inline-flex;\r\n  align-items:center;\r\n  gap:4px;\r\n  padding:2px;\r\n  margin:-2px;\r\n  transition:all .15s;\r\n}\r\n.siblings-block .sib:hover,\r\n.siblings-block .sib:focus-visible{\r\n  background:var(--footer-accent);\r\n  color:#000;\r\n  border-radius:3px;\r\n}\r\n\r\n/* ── Row 3: Copyright + Legal ── */\r\n.row3{\r\n  padding-top:20px;\r\n  border-top:1px solid rgba(255,255,255,0.12);\r\n  display:flex;\r\n  justify-content:space-between;\r\n  align-items:center;\r\n  flex-wrap:wrap;\r\n  gap:10px;\r\n}\r\n.row3 .copy{\r\n  font-size:12px;\r\n  color:var(--footer-muted);\r\n}\r\n.row3 .links{\r\n  display:flex;\r\n  flex-wrap:wrap;\r\n  gap:6px;\r\n  align-items:center;\r\n}\r\n.row3 .links a{\r\n  color:var(--footer-muted);\r\n  font-size:12px;\r\n  text-decoration:none;\r\n  padding:2px;\r\n  margin:-2px;\r\n  transition:all .15s;\r\n}\r\n.row3 .links a:hover,\r\n.row3 .links a:focus-visible{\r\n  background:var(--footer-accent);\r\n  color:#000;\r\n  border-radius:3px;\r\n}\r\n.row3 .sep{\r\n  color:rgba(255,255,255,0.15);\r\n  margin:0 4px;\r\n  font-size:12px;\r\n}\r\n\r\n/* ── Responsive: 2-up at ≤900px ── */\r\n@media (max-width:900px){\r\n  .footer{padding:40px 24px 24px}\r\n\r\n  .row1{\r\n    grid-template-columns:1fr 1fr;\r\n    gap:24px;\r\n  }\r\n  .brand-col{\r\n    grid-column:1 / -1;\r\n  }\r\n\r\n  .row2{\r\n    grid-template-columns:1fr;\r\n    gap:24px;\r\n  }\r\n}\r\n\r\n/* ── Responsive: 1-up at ≤600px ── */\r\n@media (max-width:600px){\r\n  .footer{pa